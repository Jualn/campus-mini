/* components/profile-feed-skeleton/index.wxss */
@import "../../styles/skeleton.wxss";
@import "../../styles/profile-header.wxss";

:host {
  display: block;
}

.profile-feed-skeleton {
  min-height: 100vh;
  background: var(--color-bg-card);
}

.me-function-skeleton {
  margin: 0 var(--page-padding) var(--space-sm);
}

.me-function-skeleton__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-xs);
}

.me-function-skeleton__item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  min-height: 80rpx;
  padding: var(--space-xs);
  border-radius: var(--radius-md);
  background: var(--color-bg-page);
}

.me-function-skeleton__icon {
  width: 32rpx;
  height: 32rpx;
}

.me-function-skeleton__label {
  width: 88rpx;
  max-width: 60%;
  height: 24rpx;
}

.btn-icon__wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  border: 1.5rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon-dot {
  width: 34rpx;
  height: 34rpx;
}

.btn-outline {
  width: 154rpx;
  height: 64rpx;
  border-radius: 40rpx;
}

.btn-icon-more {
  width: 76rpx;
  height: 76rpx;
}

.profile-name-skeleton {
  width: 220rpx;
  height: 42rpx;
}

.profile-bio-skeleton {
  height: 28rpx;
  margin-bottom: 14rpx;
}

.profile-bio-skeleton--long {
  width: 460rpx;
  max-width: 86%;
}

.profile-bio-skeleton--short {
  width: 300rpx;
  max-width: 58%;
}

.tab-text-skeleton {
  width: 56rpx;
  height: 28rpx;
}

.tab-active-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 60rpx;
  height: 6rpx;
  transform: translateX(-50%);
  border-radius: 3rpx;
}

/* 列表 */
.feed-skeleton-list {
  background: var(--color-bg-card);
}
