.grid-container {
  display: grid;
  width: 100%;
  gap: 8rpx;
  margin-top: var(--space-sm);
}

.grid-1 {
  display: block;
}

.grid-item--single {
  display: block;
  width: 100%;
  overflow: hidden;
  border-radius: var(--radius-sm);
  background: var(--color-bg-page-deep);
}

.grid-2,
.grid-3,
.grid-4,
.grid-5,
.grid-6,
.grid-7,
.grid-8,
.grid-9 {
  display: grid;
}

.grid-2 {
  grid-template-columns: 1fr 1fr;
  height: 320rpx;
}

.grid-3 {
  grid-template-columns: 2fr 1fr;
  grid-template-rows: 160rpx 160rpx;
  height: 328rpx;
}

.grid-3 .item-0 {
  grid-row: span 2;
}

.grid-4 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 200rpx 200rpx;
}

.grid-5,
.grid-6,
.grid-7,
.grid-8,
.grid-9 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  grid-auto-rows: 220rpx;
}

.grid-container:not(.grid-1) .grid-item {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-xs);
  background: var(--color-bg-page-deep);
}

.grid-item--failed {
  display: flex;
  min-height: 200rpx;
  align-items: center;
  justify-content: center;
  padding: var(--space-sm);
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
  text-align: center;
}
