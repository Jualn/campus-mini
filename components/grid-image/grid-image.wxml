<view class="grid-container grid-{{images.length > 9 ? 9 : images.length}}" wx:if="{{images.length != 0}}">
  <block wx:for="{{images}}" wx:key="index">
    <view
      wx:if="{{failedImages[item]}}"
      class="grid-item item-{{index}} grid-item--failed {{images.length === 1 ? 'grid-item--single' : ''}}"
    >
      <text>图片暂时无法显示</text>
    </view>
    <image
      wx:else
      class="grid-item item-{{index}} {{images.length === 1 ? 'grid-item--single' : ''}}"
      src="{{item}}"
      mode="{{images.length === 1 ? 'widthFix' : 'aspectFill'}}"
      lazy-load
      catchtap="onPreview"
      data-current="{{item}}"
      binderror="onImageError"
    />
  </block>
</view>
