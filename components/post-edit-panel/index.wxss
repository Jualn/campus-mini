/* components/post-edit-panel/index.wxss */
.root {
  position: fixed;
  inset: 0;
  z-index: 999;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 30, 46, 0.48);
}

.panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 90vh;
  flex-direction: column;
  overflow: hidden;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--color-bg-card);
  box-shadow: 0 -12rpx 40rpx rgba(31, 45, 69, 0.12);
  will-change: transform;
  pointer-events: auto;
}

.panel__handle-area {
  display: flex;
  width: 100%;
  min-height: 48rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}

.panel__handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: var(--radius-full);
  background: #d9dfe8;
}

.panel__nav {
  position: relative;
  display: flex;
  min-height: 96rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx var(--space-md);
  border-bottom: 1rpx solid var(--color-border-light);
}

.panel__cancel {
  display: flex;
  min-width: 104rpx;
  min-height: 72rpx;
  align-items: center;
  justify-content: flex-start;
  color: var(--color-text-secondary);
  font-size: var(--font-md);
}

.panel__title {
  position: absolute;
  right: 176rpx;
  left: 176rpx;
  color: var(--color-text-primary);
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  text-align: center;
}

.panel__submit {
  display: flex;
  min-width: 120rpx;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  background: #e2e7ee;
  color: var(--color-text-tertiary);
}

.panel__submit--on {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.panel__submit-text {
  font-size: var(--font-base);
  font-weight: var(--weight-semibold);
}

.panel__submit[disabled] {
  opacity: 1;
}

.panel__body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.composer-status {
  margin: var(--space-md) 32rpx 0;
  padding: 16rpx var(--space-md);
  border-left: 4rpx solid var(--color-primary);
  background: var(--color-primary-tint);
  color: var(--color-primary-deep);
  font-size: var(--font-base);
}

.content-area {
  position: relative;
  width: 100%;
  min-height: 300rpx;
}

.mirror-text {
  width: 100%;
  min-height: 300rpx;
  padding: 28rpx 32rpx 56rpx;
  visibility: hidden;
  font-size: 32rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
  box-sizing: border-box;
  pointer-events: none;
}

.content-input {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 28rpx 32rpx 56rpx;
  color: var(--color-text-primary);
  font-size: 32rpx;
  line-height: 1.8;
  box-sizing: border-box;
}

.content-ph {
  color: var(--color-text-placeholder);
  font-size: 32rpx;
  line-height: 1.8;
}

.content-count-wrapper {
  position: absolute;
  right: 32rpx;
  bottom: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.content-count {
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
}

.context-area {
  margin: 0 32rpx;
  padding: var(--space-sm) 0 var(--space-md);
  border-top: 1rpx solid var(--color-border-light);
}

.category-picker {
  display: inline-flex;
  max-width: 100%;
  min-height: 72rpx;
  align-items: center;
  gap: var(--space-xs);
  padding: 0 var(--space-sm);
  border-radius: var(--radius-xs);
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
  font-size: var(--font-base);
}

.category-picker--selected {
  background: var(--color-primary-tint);
  color: var(--color-primary-deep);
}

.category-picker ui-icon {
  transform: rotate(90deg);
}

.category-support {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-xs) var(--space-md);
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
}

.category-support button {
  display: inline-flex;
  min-height: 64rpx;
  align-items: center;
  color: var(--color-primary);
  font-size: var(--font-xs);
}

.topic-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-xs);
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
}

.topic-chip {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  padding-left: var(--space-sm);
  border-radius: var(--radius-full);
  background: var(--color-primary-light);
  color: var(--color-primary-deep);
  font-size: var(--font-base);
}

.topic-chip button {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
}

.topic-add {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  color: var(--color-primary);
  font-size: var(--font-base);
}

.image-area {
  padding: var(--space-sm) 32rpx 0;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 100%;
  overflow: visible;
}

.image-item__img {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-sm);
  background: var(--color-bg-page-deep);
}

.image-item__del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  z-index: 2;
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--color-bg-card);
  border-radius: 50%;
  background: rgba(31, 45, 69, 0.76);
}

.image-add {
  overflow: hidden;
  border: 2rpx dashed #cbd5e2;
  border-radius: var(--radius-sm);
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.image-add__icon {
  position: absolute;
  top: 28%;
  left: 50%;
  transform: translateX(-50%);
}

.image-add__hint {
  position: absolute;
  bottom: 22%;
  left: 50%;
  font-size: var(--font-xs);
  white-space: nowrap;
  transform: translateX(-50%);
}

.body-pad {
  height: calc(32rpx + constant(safe-area-inset-bottom));
  height: calc(32rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.topic-modal {
  position: fixed;
  inset: 0;
  z-index: 1001;
}

.topic-modal__mask {
  position: absolute;
  inset: 0;
  background: rgba(20, 30, 46, 0.42);
}

.topic-modal__box {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 76vh;
  overflow-y: auto;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--color-bg-card);
}

.topic-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  padding: 28rpx 32rpx var(--space-sm);
  border-bottom: 1rpx solid var(--color-border-light);
}

.topic-modal__header > view {
  display: flex;
  flex-direction: column;
  gap: var(--space-2xs);
}

.topic-modal__title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
}

.topic-modal__description {
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.topic-modal__done {
  display: flex;
  min-width: 96rpx;
  min-height: 72rpx;
  align-items: center;
  justify-content: flex-end;
  color: var(--color-primary);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
}

button[disabled] {
  opacity: 0.45;
}

.panel__submit[disabled] {
  opacity: 1;
}
