/* components/post-edit-panel/index.wxss */

/* ── 根容器：全屏覆盖，隔离事件 ────────── */
.root {
  position: fixed;
  inset: 0;
  z-index: 999;
  /* 不设背景色，让 .mask 单独控制遮罩 */
  /* 根容器本身不拦截，子元素各自处理 */
}

/* ── 遮罩 ───────────────────────────────── */
.mask {
  position: fixed;
  /* absolute 改 fixed 更保险 */
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}

.panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 90vh;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.94);
  /* 磨砂玻璃 */
  backdrop-filter: blur(40rpx) saturate(1.8);
  -webkit-backdrop-filter: blur(40rpx) saturate(1.8);
  padding: 0 0 0;
  /* 顶部柔光描边 */
  box-shadow: 0 -1rpx 0 rgba(255, 255, 255, 0.9),
    0 -24rpx 80rpx rgba(0, 0, 0, 0.12);
  border-radius: 24rpx 24rpx 0 0;
  will-change: transform;
  pointer-events: auto;
}

/* ── 拖拽条 ────────────────────────────── */
.panel__handle-area {
  width: 100%;
  min-height: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.panel__handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e4e6eb;
}

/* ── 顶部栏 ────────────────────────────── */
.panel__nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border-light);
  flex-shrink: 0;
}

.panel__cancel {
  padding: 8rpx;
}

.panel__cancel-text {
  font-size: 30rpx;
  color: #999;
}

.panel__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.panel__submit {
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  background: #d0d0d0;
  transition: background 0.2s;
}

.panel__submit--on {
  background: var(--color-primary);
}

.panel__submit-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

/* ── 内容区 ────────────────────────────── */
.panel__body {
  flex: 1;
  overflow: hidden;
  min-height: 0;
  /* 修复某些机型 flex 子项不收缩导致 scroll-view 撑不开的问题 */
}

/* content-area 不再负责 padding */
.content-area {
  position: relative;
  min-height: 144rpx;
  width: 100%;
}

/* 镜像层：padding / font / line-height 与 textarea 完全镜像 */
.mirror-text {
  visibility: hidden;
  white-space: pre-wrap;
  word-break: break-all;

  padding: 28rpx 28rpx 45rpx; /* ← 与 textarea 完全一致 */
  font-size: 32rpx; /* ← 统一用 rpx */
  line-height: 48rpx; /* ← 统一用 rpx */

  width: 100%;
  box-sizing: border-box;
  pointer-events: none;
}

/* textarea：padding / font / line-height 与镜像层完全一致 */
.content-input {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;

  padding: 28rpx 28rpx 45rpx; /* ← 与镜像层完全一致 */
  font-size: 32rpx; /* ← 统一用 rpx */
  line-height: 48rpx; /* ← 统一用 rpx */

  box-sizing: border-box;
  color: var(--color-text-primary);
  margin: 0;
}

/* placeholder 样式必须与 .content-input 的 font-size / line-height 完全一致，
   否则光标与 placeholder 文字会错位 */
.content-ph {
  color: #bbb;
  font-size: 32rpx;
  line-height: 1.6;
}

.content-count-wrapper {
  display: flex;
  justify-content: flex-end;
}

.content-count {
  font-size: 24rpx;
  color: #999;
  /* 如果想悬浮在输入框右下角且不随滚动条走，可以用以下绝对定位： */
  position: absolute;
  bottom: 50rpx;
  right: 35rpx;
  z-index: 9;
  background: rgba(255, 255, 255, 0.9); /* 微弱遮罩，增加可读性 */
}

/* ── 图片区 ────────────────────────────── */
.image-area {
  padding: 20rpx 28rpx 0;
}

/*
 * 用 display:grid 三列等宽，彻底避免 flex+margin 的子像素换行问题。
 * grid 会把每个子元素严格限制在列宽内，不会因为浮点误差挤到下一行。
 */
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.image-item {
  position: relative;
  width: 100%;
  /* padding-top: 100% 让格子变正方形（相对于自身宽度） */
  padding-top: 100%;
  height: 0;
  border-radius: 12rpx;
  overflow: visible;
  /* del 角标需要溢出 */
}

/* 图片本体：绝对定位铺满 padding-top 撑出的空间 */
.image-item__img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  display: block;
}

.image-item__del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}


/* 添加按钮：复用 .image-item 尺寸，内容居中 */
.image-add {
  border-radius: 12rpx;
  border: 2rpx dashed #d0d0d0;
  background: #f8f9fa;
  /* 内容居中：绝对定位一个 flex 容器铺满 */
  overflow: hidden;
}

/* 添加按钮内部用绝对定位居中 */
.image-add::after {
  content: "";
  /* 不能用伪元素放文字，用 wxml 里的两个 text 即可，
     这里只做背景装饰无内容 */
}

/* 添加按钮的图标和提示文字：
   因为 .image-item 本身是 padding-top hack，内容需绝对定位居中 */
.image-add .image-add__icon {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 30%;
}

.image-add .image-add__hint {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
}

.image-add__hint {
  bottom: 22%;
  font-size: 22rpx;
  color: #bbb;
  white-space: nowrap;
}

/* ── 底部间距 ───────────────────────────── */
.body-pad {
  height: 32rpx;
  flex-shrink: 0;
}
