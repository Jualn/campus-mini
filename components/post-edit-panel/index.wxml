<!-- components/post-edit-panel/index.wxml -->
<!--
  组件自己全权管理遮罩 + 面板动画，父页面只需控制 show prop。
  page-container 设 overlay="{{false}}"，由组件内的 .mask 接管遮罩。
-->
<wxs module="drag" src="../../utils/drag.wxs"></wxs>
<view class="root" catch:touchmove="noop">

  <!-- 遮罩：opacity 跟手，点击关闭 -->
  <view class="mask J-mask" data-panel-h="{{panelHeight}}" catch:touchstart="{{drag.noop}}"
    catch:touchend="{{drag.handleClose}}" catchtouchmove="noop" />

  <!-- 面板：translateY 跟手 -->
  <view class="panel J-sheet">

    <!-- 拖拽指示条 -->
    <view class="panel__handle-area" bindtouchstart="{{drag.handleStart}}" bindtouchend="{{drag.handleEnd}}"
      catchtouchmove="{{drag.handleMove}}" data-panel-h="{{panelHeight}}">
      <view class="panel__handle" />
    </view>

    <!-- 顶部栏 -->
    <view class="panel__nav" bindtouchstart="{{drag.handleStart}}" bindtouchend="{{drag.handleEnd}}"
      catchtouchmove="{{drag.handleMove}}" data-panel-h="{{panelHeight}}">
      <view class="panel__cancel" data-panel-h="{{panelHeight}}" catch:touchstart="{{drag.noop}}"
        catch:touchend="{{drag.handleClose}}" catchtouchmove="noop">
        <text class="panel__cancel-text">取消</text>
      </view>
      <text class="panel__title">发帖子</text>
      <view class="panel__submit {{canSubmit ? 'panel__submit--on' : ''}}" catchtap="onSubmit">
        <text class="panel__submit-text">发布</text>
      </view>
    </view>

    <!-- 内容区 -->
    <scroll-view class="panel__body" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}"
      upper-threshold="15" bindtouchstart="{{drag.scrollStart}}" bindtouchmove="{{drag.scrollMove}}"
      bindtouchend="{{drag.scrollEnd}}" data-panel-h="{{panelHeight}}" data-at-top="{{atScrollTop}}"
      style="padding-bottom: {{kbHeight}}px;">

      <!-- 正文输入 -->
      <view class="content-area">
        <!-- 镜像层：不可见但占空间，驱动容器高度（纯渲染，无 JS） -->
        <view class="mirror-text">{{mirrorContent}}</view>
        <textarea class="content-input" placeholder="分享你的想法..." placeholder-class="content-ph"
          bindkeyboardheightchange="onKeyboardHeightChange" bindfocus="onTextareaFocus" bindblur="onTextareaBlur"
          maxlength="700" show-confirm-bar="{{false}}" adjust-position="{{false}}" cursor-spacing="20"
          bindinput="onContentInput" focus="{{focused}}" />
        <!-- 计数器放在这里，确保它在 input 区域内但不会随文字滚动 -->
        <view class="content-count-wrapper">
          <text class="content-count" wx:if="{{contentLength > 0}}">{{contentLength}}/700</text>
        </view>
      </view>

      <!-- 图片区 -->
      <view class="image-area" wx:if="{{images.length > 0 || images.length < 9}}">
        <view class="image-grid">
          <view wx:for="{{images}}" wx:key="*this" class="image-item">
            <image class="image-item__img" src="{{item}}" mode="aspectFill" />
            <view class="image-item__del" catchtap="onRemoveImage" data-index="{{index}}" aria-role="button" aria-label="移除图片">
              <ui-icon name="remove" state="inverse" size="sm" />
            </view>
          </view>
          <view class="image-item image-add" bindtap="onAddImage" wx:if="{{images.length < 9}}" aria-role="button" aria-label="添加图片">
            <ui-icon class="image-add__icon" name="plus" size="lg" />
            <text class="image-add__hint">{{images.length === 0 ? '添加图片' : images.length + '/9'}}</text>
          </view>
        </view>
      </view>

      <view class="body-pad" catch:touchmove="noop" />
    </scroll-view>

  </view>
</view>
