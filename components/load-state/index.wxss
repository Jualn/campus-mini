:host {
  display: block;
}

.load-state {
  min-height: 440rpx;
  padding: 96rpx 48rpx 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.load-state--viewport {
  min-height: calc(100vh - var(--load-state-viewport-offset, 0rpx));
  padding-top: 72rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.load-state__visual {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  margin-bottom: 26rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #e7f1ff, #ffffff 76%);
  border: 1rpx solid rgba(47, 124, 246, 0.12);
  box-shadow: 0 14rpx 34rpx rgba(47, 124, 246, 0.08);
}

.load-state__visual--empty {
  background: linear-gradient(145deg, #f1f5fa, #ffffff);
  border-color: rgba(16, 35, 63, 0.08);
  box-shadow: 0 14rpx 34rpx rgba(16, 35, 63, 0.05);
}

.load-state__symbol {
  width: 38rpx;
  height: 54rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

.load-state__symbol-line {
  width: 8rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: var(--color-primary, #2f7cf6);
}

.load-state__symbol-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--color-primary, #2f7cf6);
}

.load-state__symbol--empty {
  height: 32rpx;
  justify-content: center;
}

.load-state__symbol--empty .load-state__symbol-line {
  width: 34rpx;
  height: 7rpx;
  background: rgba(16, 35, 63, 0.38);
}

.load-state__symbol--empty .load-state__symbol-dot {
  display: none;
}

.load-state__copy {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.load-state__title {
  font-size: 31rpx;
  line-height: 1.4;
  font-weight: 700;
  color: var(--color-text-primary, #10233f);
}

.load-state__description {
  max-width: 520rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--color-text-tertiary, rgba(16, 35, 63, 0.52));
}

.load-state__action {
  min-width: 176rpx;
  height: 72rpx;
  margin-top: 30rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary, #2f7cf6);
  box-shadow: 0 10rpx 24rpx rgba(47, 124, 246, 0.2);
  font-size: 25rpx;
  font-weight: 600;
  color: #ffffff;
  box-sizing: border-box;
}

.load-state__action--hover {
  opacity: 0.84;
  transform: scale(0.98);
}

.load-state__spinner {
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid rgba(47, 124, 246, 0.16);
  border-top-color: var(--color-primary, #2f7cf6);
  border-radius: 50%;
  animation: load-state-spin 0.72s linear infinite;
}

.load-state--loading:not(.load-state--compact) .load-state__spinner {
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 22rpx;
}

.load-state--section {
  min-height: 300rpx;
  margin: 20rpx 24rpx;
  padding: 52rpx 32rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(47, 124, 246, 0.08);
}

.load-state--section .load-state__visual {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  border-radius: 27rpx;
  box-shadow: none;
}

.load-state--section .load-state__symbol {
  transform: scale(0.72);
}

.load-state--section .load-state__title {
  font-size: 28rpx;
}

.load-state--section .load-state__description {
  font-size: 23rpx;
}

.load-state--section .load-state__action {
  height: 64rpx;
  min-width: 152rpx;
  margin-top: 24rpx;
  font-size: 24rpx;
}

.load-state--inline,
.load-state--compact {
  min-height: 0;
  padding: 26rpx 24rpx;
  flex-direction: row;
  gap: 16rpx;
}

.load-state--inline .load-state__copy,
.load-state--compact .load-state__copy {
  flex-direction: row;
  gap: 8rpx;
}

.load-state--inline .load-state__title,
.load-state--inline .load-state__description,
.load-state--compact .load-state__title,
.load-state--compact .load-state__description {
  margin: 0;
  font-size: 23rpx;
}

.load-state--inline .load-state__title,
.load-state--compact .load-state__title {
  color: rgba(16, 35, 63, 0.68);
}

.load-state--inline .load-state__action,
.load-state--compact .load-state__action {
  min-width: 0;
  height: auto;
  margin: 0;
  padding: 4rpx 0;
  background: transparent;
  box-shadow: none;
  color: var(--color-primary, #2f7cf6);
  font-size: 23rpx;
}

@keyframes load-state-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .load-state__spinner {
    animation-duration: 1.4s;
  }
}
