.stats-row {
  display: flex;
  gap: 32rpx;
}

.stats-item {
  display: flex;
  align-items: baseline;
}

.stats-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text-primary);
}

.stats-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* Tab */
.tab-bar {
  display: flex;
  border-bottom: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
  position: sticky;
  top: 0;
  z-index: 50;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  position: relative;
}

.tab-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.tab-item--active .tab-text {
  font-weight: 700;
  color: var(--color-text-primary);
}

.tab-item--active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

/* Layout stays with the caller; UiIcon owns the glyph. */
.icon-slot {
  display: flex;
  align-items: center;
  justify-content: center;
}
