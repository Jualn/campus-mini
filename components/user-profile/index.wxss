/* components/user-profile/index.wxss */

/* 横幅 */
.banner-wrap {
  position: relative;
  width: 100%;
  height: 420rpx;
  background: linear-gradient(180deg, #c7d2fe 0%, #e0e7ff 35%, #f1f5ff 70%, #ffffff 100%);
  overflow: visible;
}

.banner-img {
  width: 100%;
  height: 420rpx;
  display: block;
  border-bottom-left-radius: 12rpx;
  border-bottom-right-radius: 12rpx;
}

/* 返回按钮（别人主页，左侧） */
.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: flex-end;
  padding: 0 20rpx 16rpx;
  z-index: 10;
}

.top-bar__back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(16, 35, 63, 0.56);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: none;
}

/* 个人信息主体 */
.profile-body {
  padding: 0 30rpx 24rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
}

.avatar-action-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: -80rpx;
  margin-bottom: 16rpx;
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  background: #eee;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.15);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar__img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar__char {
  font-size: 64rpx;
  color: #fff;
  font-weight: 700;
}

.action-btns {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 10rpx;
}

.btn-icon__wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  border: 1.5rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon__setting{
  display: block;
  opacity: 0.86;
  flex-shrink: 0;
}

.btn-icon {
  display: block;
  opacity: 0.86;
  flex-shrink: 0;
}

.btn-icon__more {
  height: 76rpx;
  width: 76rpx;
  flex-shrink: 0;
}

.btn-outline {
  height: 64rpx;
  padding: 0 30rpx;
  border: 1.5rpx solid var(--color-border);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.btn-fill {
  height: 64rpx;
  padding: 0 36rpx;
  background: var(--color-text-primary);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-fill--grey {
  background: var(--color-bg-page);
  border: 1.5rpx solid var(--color-border);
}

.btn-fill__text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.btn-fill--grey .btn-fill__text {
  color: var(--color-text-primary);
}

.name-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 4rpx;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text-primary);
}

.verified {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.verified__icon {
  font-size: 22rpx;
  color: #fff;
  font-weight: 700;
}

.profile-handle {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 16rpx;
}

.profile-bio {
  font-size: 30rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
  display: block;
  margin-bottom: 18rpx;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-bottom: 20rpx;
}

.meta-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.08);
}

.meta-tag__icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.meta-tag__text {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--color-text-secondary);
}

