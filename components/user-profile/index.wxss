@import "../../styles/profile-header.wxss";

.avatar__img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar__char {
  font-size: 64rpx;
  color: #fff;
  font-weight: 700;
}

.btn-icon__wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  border: 1.5rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon__setting {
  display: block;
  opacity: 0.86;
  flex-shrink: 0;
}

.btn-icon {
  display: block;
  opacity: 0.86;
  flex-shrink: 0;
}

.btn-icon__more {
  height: 76rpx;
  width: 76rpx;
  flex-shrink: 0;
}

.btn-outline {
  height: 64rpx;
  border: 1.5rpx solid var(--color-border);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.profile-name {
  min-width: 0;
  font-size: 40rpx;
  font-weight: var(--weight-heavy);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--color-text-primary);
}

.name-line {
  flex-wrap: nowrap;
}

.profile-bio {
  font-size: 30rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
  display: block;
  margin: 0;
  overflow-wrap: anywhere;
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon,
.btn-icon__wrap,
.btn-outline,
.tab-item {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: inherit;
}

.btn-outline {
  padding: 0 30rpx;
}

.profile-action--pressed {
  opacity: 0.65;
}

.btn-icon::after,
.btn-icon__wrap::after,
.btn-outline::after,
.tab-item::after {
  border: 0;
}

.tab-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.tab-item--active .tab-text {
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.tab-item--active::before {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

/* Layout stays with the caller; UiIcon owns the glyph. */
.icon-slot {
  display: flex;
  align-items: center;
  justify-content: center;
}
