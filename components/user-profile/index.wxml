<!-- components/user-profile/index.wxml -->
<view class="profile-wrap">

  <!-- 横幅 -->
  <view class="banner-wrap">
    <image wx:if="{{userInfo.backgroundUrl}}" class="banner-img" src="{{userInfo.backgroundUrl}}" mode="aspectFill" />
    <!-- 别人主页才显示返回按钮，放左侧远离胶囊 -->
    <view class="top-bar" style="padding-top:{{statusBarHeight}}px;" wx:if="{{!isSelf}}">
      <back-button variant="nav" inverse auto-back="{{false}}" bind:back="onBack" />
    </view>
  </view>

  <!-- 个人信息 -->
  <view class="profile-body">

    <!-- 头像 + 操作按钮行 -->
    <view class="avatar-action-row">

      <view class="profile-avatar" style="background:{{avatarBg}}">
        <image wx:if="{{userInfo.avatarUrl}}" class="avatar__img" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <text wx:else class="avatar__char">{{avatarChar}}</text>
      </view>
      <view class="action-btns">
        <!-- 自己：设置 + 编辑资料 -->
        <block wx:if="{{isSelf}}">
          <button class="btn-icon__wrap" bindtap="onGoSetting" hover-class="profile-action--pressed" aria-label="设置">
            <ui-icon class="btn-icon__setting" name="settings" size="xl" />
          </button>
          <button class="btn-outline" bindtap="onEditProfile" hover-class="profile-action--pressed">
            <text class="btn-text">编辑资料</text>
          </button>
        </block>
        <!-- 别人：更多操作 -->
        <block wx:else>
          <button class="btn-icon" bindtap="onMore" hover-class="profile-action--pressed" aria-label="更多用户操作">
            <view class="btn-icon__more icon-slot"><ui-icon name="more" size="md" /></view>
          </button>
        </block>
      </view>
    </view>

    <!-- 名字 + 认证 -->
    <view class="name-line">
      <text class="profile-name">{{userInfo.nickname}}</text>
      <operator-badge wx:if="{{userInfo.isPlatformOperator === true}}" />
      <slot name="profile-badges" />
    </view>
    <text class="profile-bio" wx:if="{{userInfo.bio}}">{{userInfo.bio}}</text>

  </view>

  <slot name="profile-footer" />

  <view class="tab-bar" wx:if="{{isSelf}}">
    <button class="tab-item {{activeTab === 'posts' ? 'tab-item--active' : ''}}" bindtap="onSwitchTab" data-tab="posts"
      aria-label="动态{{activeTab === 'posts' ? '，已选择' : ''}}">
      <text class="tab-text">动态</text>
    </button>
    <button class="tab-item {{activeTab === 'likes' ? 'tab-item--active' : ''}}" bindtap="onSwitchTab" data-tab="likes"
      aria-label="点赞{{activeTab === 'likes' ? '，已选择' : ''}}">
      <text class="tab-text">点赞</text>
    </button>
  </view>
  <view class="tab-bar" wx:else>
    <view class="tab-item tab-item--active"><text class="tab-text">动态</text></view>
  </view>
</view>
