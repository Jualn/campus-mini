<!-- components/post-card/index.wxml -->
<view class="post-card" catchtap="onTapCard">
  <view class="post-left">
    <view class="post-avatar" style="background:{{_avatarBg}}" catch:tap="onTapAvatar">
      <image wx:if="{{_avatarUrl}}" class="post-avatar__img" src="{{_avatarUrl}}" mode="aspectFill" />
      <text wx:else class="post-avatar__char">{{_avatarChar}}</text>
    </view>
  </view>
  <view class="post-right">
    <view class="post-top-row">
      <view class="post-user">
        <text class="post-nickname">{{post.nickname}}</text>
        <text class="post-time">· {{post.createdAt}}</text>
      </view>
      <view class="post-more" catchtap="onMoreTap" >
        <image class="more-dot" src="/assets/icons/common/more.svg" mode="aspectFit"/>
      </view>
    </view>

    <view class="post-body">
      <text class="post-text {{isExpanded ? 'post-text--expanded' : ''}}">{{post.content}}</text>
      <view class="post-expand" wx:if="{{canExpand}}" catchtap="onToggleExpand">
        <text class="post-expand__text">{{isExpanded ? '收起' : '展开全文'}}</text>
      </view>
    </view>

    <grid-image images="{{post.images || []}}" bind:preview="onPreviewImage" />

    <!-- 操作栏 -->
    <view class="post-actions">
      <!-- 评论 -->
      <view class="action-item" catchtap="onComment">
        <image class="action-icon" src="/images/interact/comment.svg" mode="aspectFit" />
        <text class="action-count">{{post.commentCount > 0 ? post.commentCount : ''}}</text>
      </view>
      <!-- 点赞 -->
      <view class="action-item" catchtap="onLike">
        <view class="action-icon {{liked ? 'liked' : ''}}">
          <image class="icon like-off" src="/images/interact/like.svg" />
          <image class="icon like-on" src="/images/interact/like-fill.svg" />
        </view>
        <text class="action-count {{liked ? 'action-count--liked' : ''}}">{{likeCount > 0 ? likeCount : ''}}</text>
      </view>
      <!-- 浏览量 -->
      <view class="action-item action-item--view">
        <image class="action-icon" src="/images/interact/view.svg" mode="aspectFit" />
        <text class="action-count action-count--view">{{viewCountText}}</text>
      </view>
      <!-- 分享 -->
      <view class="action-item action-item--share" catchtap="onShare">
        <image class="action-icon" src="/images/interact/share.svg" mode="aspectFit" />
      </view>
    </view>

  </view>
</view>

<canvas type="2d" id="posterCanvas" style="position: fixed; left: -9999px; top: -9999px;"></canvas>
