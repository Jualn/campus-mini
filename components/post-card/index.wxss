/* components/post-card/index.wxss */

.post-card {
  display: flex;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
}

.post-left {
  width: 80rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.post-avatar__img {
  width: 100%;
  height: 100%;
  display: block;
}

.post-avatar__char {
  color: var(--color-text-inverse);
  font-weight: 700;
  font-size: 26rpx;
}

.post-right {
  flex: 1;
  min-width: 0;
}

.post-top-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.post-user {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.post-nickname {
  max-width: 320rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-time {
  font-size: 24rpx;
  color: #536471;
  flex-shrink: 0;
}

.post-more {
  padding: 0 4rpx 0 16rpx;
}

.more-dot {
  font-size: 24rpx;
  color: #BBBBBB;
  letter-spacing: 2rpx;
}

.post-body {
  margin: 8rpx 0 16rpx;
}

.post-text {
  font-size: 30rpx;
  color: #2C2C2C;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 操作栏 */
.post-actions {
  display: flex;
  align-items: center;
  padding: 16rpx 0 4rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  justify-content: center;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  position: relative;
}

.action-count {
  font-size: 28rpx;
  color: #8A8A8A;
  min-width: 32rpx;
}

.action-count--liked {
  color: #F91880;
}

/* 点赞图标动画 */
.icon {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  transition: all 0.25s ease;
}

.like-off {
  opacity: 1;
}

.like-on {
  opacity: 0;
  transform: scale(0.7);
}

.liked .like-off {
  opacity: 0;
  transform: scale(0.7);
}

.liked .like-on {
  opacity: 1;
  transform: scale(1);
  animation: likePop 0.3s ease;
}

@keyframes likePop {
  0% {
    transform: scale(0.6);
  }

  60% {
    transform: scale(1.2);
  }

  100% {
    transform: scale(1);
  }
}


.share-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.share-panel {
  width: 100%;
  background: var(--color-bg-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.share-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.share-title {
  font-size: 32rpx;
  font-weight: 700;
}

.share-close {
  font-size: 32rpx;
  color: #8a8a8a;
}

.share-canvas {
  width: 600rpx;
  height: 900rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  overflow: hidden;
  display: block;
  margin: 0 auto 24rpx;
}

.share-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin-bottom: 12rpx;
}

.share-btn {
  flex: 1;
  background: linear-gradient(135deg, #4a8dff, #6ec8ff);
  color: var(--color-text-inverse);
  border: none;
}

.share-quick {
  display: flex;
  gap: 12rpx;
  justify-content: center;
}

.share-quick button {
  flex: 1;
}