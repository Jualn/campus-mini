/* components/post-card/index.wxss */

.post-card {
  display: flex;
  padding: 24rpx;
  border: 1rpx solid var(--color-border-light);
  background: var(--color-bg-card);
}

.post-card:active {
  opacity: 0.96;
}

.post-left {
  width: 76rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.post-avatar {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
}

.post-avatar:active {
  opacity: 0.82;
}

.post-avatar__img {
  display: block;
  width: 100%;
  height: 100%;
}

.post-avatar__char {
  color: var(--color-text-inverse);
  font-size: 28rpx;
  font-weight: var(--weight-semibold);
}

.post-right {
  flex: 1;
  min-width: 0;
}

.post-top-row {
  display: flex;
  min-height: 64rpx;
  align-items: center;
}

.post-user {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
}

.post-nickname {
  max-width: 300rpx;
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-time {
  flex-shrink: 0;
  margin-left: var(--space-xs);
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
}

.post-more {
  flex-shrink: 0;
  margin-right: -12rpx;
  padding-left: var(--space-sm);
}

.more-dot {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.post-context {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs) var(--space-md);
  margin-bottom: var(--space-xs);
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.post-question-title {
  margin: var(--space-xs) 0;
  color: var(--color-text-primary);
  font-size: 34rpx;
  font-weight: var(--weight-semibold);
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.post-body {
  position: relative;
  margin: var(--space-xs) 0 var(--space-sm);
}

.post-text {
  display: -webkit-box;
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: 30rpx;
  line-height: 1.75;
  overflow-wrap: anywhere;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.post-text--expanded {
  display: block;
  -webkit-line-clamp: unset;
}

.post-text--measure {
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
  display: block;
  width: 100%;
  visibility: hidden;
  pointer-events: none;
  -webkit-line-clamp: unset;
}

.post-expand {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  margin-top: var(--space-2xs);
}

.post-expand__text {
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
}

.post-topics {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs) var(--space-md);
  margin: var(--space-sm) 0 var(--space-xs);
}

.post-topic {
  color: var(--color-primary);
  font-size: var(--font-base);
  line-height: 1.5;
}

.post-actions {
  display: flex;
  align-items: center;
  margin-top: var(--space-xs);
  padding-top: var(--space-xs);
  border-top: 1rpx solid var(--color-border-light);
}

.action-item {
  display: flex;
  min-width: 112rpx;
  min-height: 72rpx;
  align-items: center;
}

.action-item:active {
  opacity: 0.68;
}

.action-item--share {
  min-width: 72rpx;
  margin-right: 0;
  margin-left: auto;
  justify-content: flex-end;
}

.action-item--view {
  min-width: 96rpx;
}

.action-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-right: var(--space-2xs);
}

.action-item--share .action-icon {
  margin-right: 0;
}

.action-count {
  min-width: 28rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.action-count--liked {
  color: var(--color-danger);
  font-weight: var(--weight-semibold);
}

.action-count--view {
  color: var(--color-text-tertiary);
}

.action-icon.liked {
  animation: likePop 0.24s ease;
}

@keyframes likePop {
  0% {
    transform: scale(0.72);
  }
  65% {
    transform: scale(1.12);
  }
  100% {
    transform: scale(1);
  }
}

.icon-slot {
  display: flex;
  align-items: center;
  justify-content: center;
}
