/* components/post-card/index.wxss */

.post-card {
  display: flex;
  padding: 26rpx 26rpx 22rpx;
  background: var(--glass-bg-strong);
  border: 1rpx solid var(--color-border-grey);
  box-shadow: var(--shadow-card);
}

.post-card:active {
  opacity: 0.94;
  transform: scale(0.992);
}

.post-left {
  width: 80rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow:
    0 10rpx 22rpx rgba(47, 124, 246, 0.15),
    0 0 0 4rpx rgba(255, 255, 255, 0.82);
}

.post-avatar:active {
  opacity: 0.86;
  transform: scale(0.96);
}

.post-avatar__img {
  width: 100%;
  height: 100%;
  display: block;
}

.post-avatar__char {
  color: var(--color-text-inverse);
  font-weight: var(--weight-bold);
  font-size: 28rpx;
}

.post-right {
  flex: 1;
  min-width: 0;
}

.post-top-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.post-user {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.post-nickname {
  max-width: 320rpx;
  font-size: 28rpx;
  font-weight: var(--weight-heavy);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-time {
  margin-left: 8rpx;
  font-size: var(--font-sm);
  color: rgba(16, 35, 63, 0.46);
  flex-shrink: 0;
}

.post-more {
  padding: 0 4rpx 0 16rpx;
  flex-shrink: 0;
}

.post-more:active {
  opacity: 0.6;
}

.more-dot {
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
}

.post-body {
  margin: 8rpx 0 20rpx;
}

.post-text {
  font-size: 29rpx;
  color: #172a46;
  line-height: 1.68;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
  word-break: break-word;
}

.post-text--expanded {
  display: block;
  -webkit-line-clamp: unset;
}

.post-expand {
  margin-top: 10rpx;
}

.post-expand__text {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-weight: var(--weight-semibold);
}

/* 操作栏 */
.post-actions {
  display: flex;
  align-items: center;
  padding: 16rpx 0 2rpx;
}

.action-item {
  display: flex;
  align-items: center;
  min-width: 120rpx;
}

.action-item:active {
  opacity: 0.7;
  transform: scale(0.98);
}

.action-item--share {
  margin-left: auto;
  margin-right: 20rpx;
  min-width: unset;
}

.action-item--view {
  min-width: 100rpx;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  position: relative;
  opacity: 0.78;
  margin-right: 6rpx;
}

.action-item--share .action-icon {
  margin-right: 0;
}

.action-count {
  font-size: var(--font-sm);
  color: rgba(16, 35, 63, 0.62);
  min-width: 28rpx;
}

.action-count--liked {
  color: var(--color-danger);
  font-weight: var(--weight-semibold);
}

.action-count--view {
  color: var(--color-text-tertiary);
}

/* 点赞图标动画 */
.icon {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.like-off {
  opacity: 1;
}

.like-on {
  opacity: 0;
  transform: scale(0.7);
}

.liked .like-off {
  opacity: 0;
  transform: scale(0.7);
}

.liked .like-on {
  opacity: 1;
  transform: scale(1);
  animation: likePop 0.3s ease;
}

@keyframes likePop {
  0% {
    transform: scale(0.6);
  }

  60% {
    transform: scale(1.18);
  }

  100% {
    transform: scale(1);
  }
}