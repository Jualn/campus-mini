/* components/share-panel/index.wxss */

.share-panel {
  background: #F4F5F7;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

/* =====================================================
   标题
   ===================================================== */
.share-panel__header {
  background: #fff;
  padding: 28rpx 28rpx 0;
}

.share-panel__title {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

/* =====================================================
   预览卡片
   ===================================================== */
.preview-card {
  background: #fff;
  margin: 16rpx 20rpx;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.preview-card__author {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.preview-card__avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}

.preview-card__name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.preview-card__content {
  font-size: 28rpx;
  color: #2C2C2C;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  display: block;
  margin-bottom: 16rpx;
}

.preview-card__img {
  width: 100%;
  height: 240rpx;
  border-radius: 12rpx;
  display: block;
  margin-bottom: 16rpx;
}

.preview-card__stats {
  display: flex;
  gap: 24rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #F5F5F5;
  border-bottom: 1rpx solid #F5F5F5;
  margin-bottom: 16rpx;
}

.preview-card__stat {
  font-size: 24rpx;
  color: #888;
}

.preview-card__brand {
  display: flex;
  align-items: center;
}

.preview-card__brand-text {
  font-size: 23rpx;
  color: #bbb;
}

/* =====================================================
   分享选项
   ===================================================== */
.share-options {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  padding: 32rpx 28rpx;
  background: #fff;
  margin: 0 0 16rpx;
}

.share-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

/* button 去掉默认样式 */
.share-option__btn {
  background: transparent;
  padding: 0;
  margin: 0;
  border: none;
  line-height: 1;
}

.share-option__btn::after {
  border: none;
}

.share-option__icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-option__icon-wrap--green {
  background: linear-gradient(135deg, #43e97b, #38f9d7);
}

.share-option__icon-wrap--blue {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
}

.share-option__icon {
  font-size: 44rpx;
}

.share-option__label {
  font-size: 24rpx;
  color: #555;
}

/* =====================================================
   取消
   ===================================================== */
.share-cancel {
  background: #fff;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-cancel__text {
  font-size: 30rpx;
  color: #555;
  font-weight: 500;
}

/* =====================================================
   离屏 canvas（不可见）
   ===================================================== */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
}