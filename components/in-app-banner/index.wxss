/* components/in-app-banner/index.wxss */

.banner {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  z-index: 9999;
  box-sizing: border-box;
  min-height: 118rpx;
  padding: 18rpx 18rpx 18rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  overflow: hidden;
  border-radius: 34rpx;
  border: 1rpx solid rgba(232, 236, 245, 0.92);
  background: rgba(255, 255, 255, 0.92);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  box-shadow:
    0 24rpx 60rpx rgba(22, 42, 76, 0.16),
    0 6rpx 18rpx rgba(22, 42, 76, 0.08);
  pointer-events: none;
  will-change: transform, opacity;
}

.banner--visible {
  pointer-events: auto;
}

.banner--transition {
  transition:
    transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.22s ease;
}

.banner--dragging {
  transition: none;
}

.banner::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.78);
  pointer-events: none;
}

.banner__accent {
  width: 8rpx;
  align-self: stretch;
  border-radius: 999rpx;
  flex-shrink: 0;
  background: #2f80ed;
}

.banner__icon-wrap {
  width: 74rpx;
  height: 74rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.7);
}

.banner__icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.banner__body {
  flex: 1;
  min-width: 0;
  padding-right: 2rpx;
}

.banner__meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  margin-bottom: 5rpx;
}

.banner__tag,
.banner__count {
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 1;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.banner__hint-text {
  min-width: 0;
  font-size: 21rpx;
  color: rgba(112, 124, 142, 0.86);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner__title {
  display: block;
  max-width: 100%;
  font-size: 28rpx;
  line-height: 1.32;
  font-weight: 700;
  color: #172033;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner__content {
  display: block;
  max-width: 100%;
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 1.35;
  color: #687386;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner__aggregate-tip {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: #2f6fc9;
}

.banner__close-hit {
  width: 58rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.banner__close {
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: rgba(245, 247, 251, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(224, 229, 238, 0.88);
}


.banner__progress {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 8rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(47, 128, 237, 0.18);
  overflow: hidden;
}

.banner__progress-inner {
  height: 100%;
  width: 100%;
  background: currentColor;
  transform-origin: left center;
  animation: progress linear forwards;
}

@keyframes progress {
  from {
    transform: scaleX(0);
  }

  to {
    transform: scaleX(1);
  }
}

.banner--system .banner__accent {
  background: #2f80ed;
}

.banner--system .banner__progress {
  color: #2f80ed;
  background-color: rgba(47, 128, 237, 0.18);
}

.banner--system .banner__icon-wrap,
.banner--system .banner__tag,
.banner--system .banner__count {
  background: #eaf3ff;
  color: #1768c6;
}

.banner--activity .banner__accent {
  background: #f08a24;
}

.banner--activity .banner__progress {
  color: #f08a24;
  background-color: rgba(240, 138, 36, 0.18);
}

.banner--activity .banner__icon-wrap,
.banner--activity .banner__tag,
.banner--activity .banner__count {
  background: #fff3e7;
  color: #b95f12;
}

.banner--exam .banner__accent {
  background: #6554e8;
}

.banner--exam .banner__progress {
  color: #6554e8;
  background-color: rgba(101, 84, 232, 0.16);
}

.banner--exam .banner__icon-wrap,
.banner--exam .banner__tag,
.banner--exam .banner__count {
  background: #f0efff;
  color: #5747ca;
}

.banner--interaction .banner__accent {
  background: #e94f72;
}

.banner--interaction .banner__progress {
  color: #e94f72;
  background-color: rgba(233, 79, 114, 0.16);
}

.banner--interaction .banner__icon-wrap,
.banner--interaction .banner__tag,
.banner--interaction .banner__count {
  background: #fff0f4;
  color: #be3455;
}

.banner--aggregate .banner__accent {
  background: #2f80ed;
}

.banner--aggregate .banner__progress {
  color: #2f80ed;
  background-color: rgba(47, 128, 237, 0.18);
}
