/* components/in-app-banner/index.wxss */

.banner {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  background: #1a1a1a;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 9999;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25);
  transform: translateY(-200rpx);
  opacity: 0;
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s ease;
}

.banner--show {
  transform: translateY(0);
  opacity: 1;
}

.banner__icon {
  font-size: 44rpx;
  flex-shrink: 0;
}

.banner__body {
  flex: 1;
  min-width: 0;
}

.banner__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 4rpx;
}

.banner__content {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner__close {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.banner__close-icon {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}