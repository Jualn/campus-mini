@import "../../styles/comment-composer.wxss";
@import "../../styles/discussion.wxss";
/* ============================================
   comment-panel 组件样式
   设计语言：Facebook/微信融合风格，干净清晰
   ============================================ */

/* ---- CSS 变量 ---- */
.cp-root {
  --cp-primary: var(--color-primary);
  --cp-primary-light: var(--color-primary-light);
  --cp-like: var(--color-brand-red-deep);
  --cp-bg: var(--color-bg-page);
  --cp-surface: var(--color-bg-card);
  --cp-border: var(--color-border-light);
  --cp-text: var(--color-text-primary);
  --cp-text-sub: var(--color-text-secondary);
  --cp-text-light: var(--color-text-tertiary);
  --cp-reply-bg: var(--color-bg-page);
  --cp-radius: 12rpx;
  --cp-radius-lg: 24rpx;
  --cp-sheet-radius: 40rpx;
}

/* ============================================
   SHEET 模式
   ============================================ */

.cp-sheet-mask {
  position: fixed;
  /* absolute 改 fixed 更保险 */
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}

/*
 * cp-sheet-content：撑满 page-container 给出的区域，
 * 使用 flex 列布局，将 scroll 区域撑开到最大，
 * 底部留出输入栏高度。
 */
.cp-sheet-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.94);
  /* 磨砂玻璃 */
  backdrop-filter: blur(40rpx) saturate(1.8);
  -webkit-backdrop-filter: blur(40rpx) saturate(1.8);
  padding: 0 0 0;
  /* 顶部柔光描边 */
  box-shadow:
    0 -1rpx 0 rgba(255, 255, 255, 0.9),
    0 -24rpx 80rpx rgba(0, 0, 0, 0.12);
  border-radius: var(--cp-sheet-radius) var(--cp-sheet-radius) 0 0;
  will-change: transform;
  /* GPU 加速，更丝滑 */
  height: 80vh;
  pointer-events: auto;
}

/* handle 触控区域放大 */
.cp-sheet__handle-area {
  width: 100%;
  min-height: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.cp-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--cp-border);
  pointer-events: none;
  /* 事件由 handle-area 接管 */
}

/* 面板头部 */
.cp-sheet__header {
  display: flex;
  align-items: center;
  padding: 12rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--cp-border);
  flex-shrink: 0;
}

.cp-sheet__title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.cp-sheet__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--cp-text);
}

.cp-sheet__count {
  font-size: 28rpx;
  color: var(--cp-text-sub);
  margin-left: 12rpx;
}

.cp-sheet__close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--cp-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cp-sheet__close:active {
  background: var(--cp-border);
}

/* scroll 区域 */
.cp-scroll {
  flex: 1;
  min-height: 0;
  /* flex 子项必须加，否则不会收缩 */
}

/* ============================================
   INLINE 模式
   ============================================ */
.cp-inline {
  background: var(--cp-surface);
}

.cp-inline__header {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--cp-border);
  gap: 12rpx;
}

.cp-inline__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--cp-text);
}

/* ============================================
   评论列表
   ============================================ */
.cp-list {
  padding-bottom: 0rpx;
}

.cp-list--inline {
  padding-bottom: 0rpx;
}

/* 单条一级评论 */
.cp-comment {
  border-bottom: 1rpx solid var(--cp-border);
  padding: 24rpx 32rpx;
}

.cp-comment__body {
  display: flex;
  gap: 20rpx;
}

.cp-comment__main {
  flex: 1;
  min-width: 0;
}

/* 昵称和认证标整体参与换行，标记不压缩、不单独落行。 */
.cp-author {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  min-width: 0;
}

.cp-comment__header {
  display: flex;
}

.cp-author__badge {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.cp-comment__name,
.cp-reply__name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.5;
}

.cp-comment__name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--cp-text);
  display: block;
}

.cp-comment__text {
  font-size: 28rpx;
  color: var(--cp-text);
  line-height: 1.6;
  margin-top: 6rpx;
  display: block;
  word-break: break-all;
}

.cp-comment__img-wrap {
  margin-top: 16rpx;
  border-radius: var(--cp-radius);
  overflow: hidden;
  max-width: 360rpx;
}

.cp-comment__img {
  width: 100%;
  border-radius: var(--cp-radius);
  display: block;
}

.cp-comment__footer {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0 20rpx;
  margin-top: 12rpx;
}

.cp-comment__time {
  font-size: 22rpx;
  color: var(--cp-text-light);
}

/* ============================================
   二级回复区域
   ============================================ */
.cp-replies {
  margin-top: 16rpx;
  background: var(--cp-reply-bg);
  border-radius: var(--cp-radius);
  overflow: hidden;
}

.cp-reply {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.cp-reply:last-child {
  border-bottom: none;
}

.cp-reply__body {
  display: flex;
  gap: 16rpx;
}

.cp-reply__main {
  flex: 1;
  min-width: 0;
}

.cp-reply__header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cp-reply__name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--cp-text);
}

.cp-reply__to {
  font-size: 24rpx;
  color: var(--cp-text-sub);
}

.cp-reply_to_title {
  font-size: 24rpx;
  color: var(--cp-text-sub);
  padding-right: 8rpx;
}

.cp-reply__to-name {
  font-size: 24rpx;
  color: var(--cp-primary);
  font-weight: 500;
}

.cp-reply__text {
  font-size: 26rpx;
  color: var(--cp-text);
  line-height: 1.55;
  margin-top: 4rpx;
  display: block;
  word-break: break-all;
}

.cp-reply__footer {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 8rpx;
}

.cp-reply__time {
  font-size: 20rpx;
  color: var(--cp-text-light);
}

/* 展开/收起按钮 */
.cp-replies__expand {
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.cp-replies__expand:active {
  background: rgba(0, 0, 0, 0.04);
}

.cp-replies__expand-text {
  font-size: 24rpx;
  color: var(--cp-primary);
  font-weight: 500;
}

.cp-replies__expand-arrow {
  font-size: 22rpx;
  color: var(--cp-primary);
}

/* 加载更多回复 */
.cp-replies__more {
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.cp-replies__more-btn {
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  color: var(--cp-text-sub);
}

.cp-replies__more-btn:active {
  background: rgba(0, 0, 0, 0.04);
}

.cp-replies__more-loading {
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--cp-text-light);
}

/* ============================================
   操作按钮（点赞/回复）
   ============================================ */
.cp-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 0;
}

.cp-action:active {
  opacity: 0.6;
}

.cp-action-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  position: relative;
}

.cp-action--sm .cp-action__icon,
.cp-action--sm .cp-action__text,
.cp-action--sm .cp-action__count {
  font-size: 22rpx;
}

.cp-action__icon {
  font-size: 26rpx;
}

.cp-action__count {
  font-size: 24rpx;
  color: var(--cp-text-sub);
}

.cp-action__text {
  font-size: 24rpx;
  color: var(--cp-text-sub);
}

.cp-action--liked .cp-action__count {
  color: var(--cp-like);
}

/* 点赞图标动画 */
.cp-action-icon.liked { animation: likePop 0.3s ease; }

@keyframes likePop {
  0% {
    transform: scale(0.6);
  }

  60% {
    transform: scale(1.2);
  }

  100% {
    transform: scale(1);
  }
}

/* ============================================
   头像
   ============================================ */
.cp-inputbar__avatar.cp-avatar.cp-avatar--sm {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  margin: 0;
}

.cp-avatar__img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.cp-avatar {
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #667eea;
}

.cp-avatar--sm {
  width: 64rpx;
  height: 64rpx;
}

.cp-avatar--xs {
  width: 48rpx;
  height: 48rpx;
}

.cp-avatar__char {
  color: #fff;
  font-weight: 700;
  font-size: 26rpx;
}

.cp-avatar--xs .cp-avatar__char {
  font-size: 20rpx;
}

/* ============================================
   加载更多（一级评论）
   ============================================ */
.cp-loadmore {
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: center;
  border-bottom: 1rpx solid var(--cp-border);
}

.cp-loadmore__btn {
  font-size: 28rpx;
  color: var(--cp-primary);
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cp-loadmore__btn:active {
  opacity: 0.6;
}

.cp-loadmore__loading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--cp-text-light);
}

.cp-nomore {
  padding: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--cp-text-light);
}

/* ============================================
   空状态
   ============================================ */
.cp-empty {
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.cp-empty__icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.cp-empty__text {
  font-size: 28rpx;
  color: var(--cp-text-sub);
}

/* 详情页的空评论是局部提示，使用紧凑间距，避免大插图占据整屏。 */
.cp-inline .cp-empty {
  padding: 56rpx 32rpx;
  gap: 12rpx;
}

.cp-inline .cp-empty__text {
  font-size: 26rpx;
  color: var(--cp-text-light);
}

/* ============================================
   回复 Banner
   ============================================ */
.cp-inputbar__imgbtn {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cp-inputbar__imgbtn:active {
  opacity: 0.6;
}

.cp-inputbar__imgbtn--disabled {
  opacity: 0.3;
  pointer-events: none;
}



/* ============================================
   图片预览条
   ============================================ */
.cp-imgpreview {
  padding: 12rpx 32rpx;
  display: flex;
  gap: 16rpx;
  background: var(--cp-surface);
  border-top: 1rpx solid var(--cp-border);
}

.cp-imgpreview__item {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--cp-radius);
  overflow: hidden;
  flex-shrink: 0;
}

.cp-imgpreview__img {
  width: 100%;
  height: 100%;
}

.cp-imgpreview__remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ============================================
   Spinner
   ============================================ */
.cp-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid var(--cp-border);
  border-top-color: var(--cp-primary);
  border-radius: 50%;
  animation: cpSpin 0.6s linear infinite;
}

.cp-spinner--sm {
  width: 26rpx;
  height: 26rpx;
  border-width: 3rpx;
}

@keyframes cpSpin {
  to {
    transform: rotate(360deg);
  }
}

/* ============================================
   骨架屏
   ============================================ */
.cp-skeleton {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--cp-border);
}

.cp-skeleton__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #f0f2f5 25%, #e4e6eb 50%, #f0f2f5 75%);
  background-size: 400% 100%;
  animation: cpShimmer 1.4s infinite;
  flex-shrink: 0;
}

.cp-skeleton__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 8rpx;
}

.cp-skeleton__line {
  height: 24rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f0f2f5 25%, #e4e6eb 50%, #f0f2f5 75%);
  background-size: 400% 100%;
  animation: cpShimmer 1.4s infinite;
}

.cp-skeleton__line--short {
  width: 40%;
}

.cp-skeleton__line--medium {
  width: 65%;
}

@keyframes cpShimmer {
  to {
    background-position: -400% 0;
  }
}

/* ============================================
   更多操作按钮（··· 触发入口）
   ============================================ */

/* 一级评论 footer 右侧的 ··· 按钮 */
.cp-comment__more {
  margin-left: auto;
  padding: 6rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--cp-radius);
}

.cp-comment__more:active {
  background: var(--cp-bg);
}

/* 二级回复 footer 右侧的 ··· 按钮 */
.cp-reply__more {
  margin-left: auto;
  padding: 4rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--cp-radius);
}

.cp-reply__more:active {
  background: rgba(0, 0, 0, 0.06);
}

/* 图标文字（用 emoji 或 iconfont 均可） */
.cp-more-icon {
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
}

/* Layout stays with the caller; UiIcon owns the glyph. */
.icon-slot {
  display: flex;
  align-items: center;
  justify-content: center;
}

.cp-status {
  padding: 14rpx 20rpx;
  margin: 12rpx 32rpx;
  border-radius: var(--radius-sm);
  background: var(--cp-bg);
  color: var(--cp-text-sub);
  font-size: 24rpx;
  line-height: 1.5;
}
.cp-status--composer {
  margin: 12rpx 24rpx 0;
  background: var(--color-primary-tint);
}
.cp-status__row, .cp-status__links {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0 16rpx;
}
.cp-status__message { flex: 1; min-width: 0; }
.cp-status__action, .cp-status__close {
  margin: 0;
  padding: 0;
  min-height: 64rpx;
  line-height: 64rpx;
  background: transparent;
  color: var(--cp-primary);
  font-size: 24rpx;
}
.cp-status__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
}
.cp-status__action::after, .cp-status__close::after { border: 0; }
.cp-status__action[disabled] {
  color: var(--cp-text-sub);
  background: transparent;
}
.cp-write-feedback {
  padding: 12rpx 28rpx 0;
  font-size: 24rpx;
  color: var(--cp-text-sub);
  line-height: 1.5;
}
.cp-placeholder {
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
  background: var(--cp-bg);
  border-radius: var(--radius-sm);
  color: var(--cp-text-sub);
  font-size: 24rpx;
}
.cp-mentor {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  gap: 5rpx;
  margin: 8rpx 0 12rpx;
  color: var(--cp-text-sub);
  font-size: 24rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.cp-mentor__label {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-xs);
  background: var(--color-primary-light);
  color: var(--cp-primary);
}
.cp-answer-preparation {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--cp-border);
  color: var(--cp-text-sub);
  font-size: 24rpx;
}
.cp-role {
  flex: none;
  margin-left: 8rpx;
  padding: 1rpx 8rpx;
  border-radius: var(--radius-xs);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 20rpx;
  line-height: 1.5;
}
.cp-role--asker {
  background: var(--color-brand-red-light);
  color: var(--color-brand-red-deep);
}
.cp-reply__header {
  flex-wrap: wrap;
  row-gap: 4rpx;
}
.cp-highlight { background: var(--color-primary-light); }
