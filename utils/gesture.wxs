// scroll.wxs
var startY = 0;
var isDragging = false;
var scrollTop = 0;

function handleTouchStart(e, ins) {
  startY = e.touches[0].clientY;
  isDragging = false;
  // 获取当前的滚动位置（由 handleScroll 记录）
  scrollTop = ins.getState().scrollTop || 0;
}

function handleTouchMove(e, ins) {
  var clientY = e.touches[0].clientY;
  var deltaY = clientY - startY;
  var state = ins.getState();

  // 核心判定：如果处于顶部且正在下拉
  if (scrollTop <= 5 && deltaY > 0) {
    isDragging = true;
    var moveY = deltaY * 0.85; // 阻尼系数

    // 直接操作面板的样式，不经过 setData
    var sheet = ins.selectComponent('.cp-sheet-content');
    if (sheet) {
      sheet.setStyle({
        'transform': 'translateY(' + moveY + 'px)',
        'transition': 'none'
      });
    }

    // 操作遮罩层透明度
    var mask = ins.selectComponent('.cp-sheet-mask');
    if (mask) {
      mask.setStyle({
        'opacity': Math.max(0, 1 - moveY / 400)
      });
    }

    // 🔥 关键：返回 false 阻止 scroll-view 的原生滚动
    return false;
  }

  if (isDragging) return false;
}

function handleTouchEnd(e, ins) {
  if (!isDragging) return;

  var clientY = e.changedTouches[0].clientY;
  var deltaY = clientY - startY;
  var sheet = ins.selectComponent('.cp-sheet-content');
  var mask = ins.selectComponent('.cp-sheet-mask');

  if (deltaY > 80) {
    // 🔥 【关键】：先在视图层执行“丝滑滑出”动画
    if (sheet) {
      sheet.setStyle({
        'transform': 'translateY(100%)', // 直接拉到底部
        'transition': 'transform 0.3s cubic-bezier(0.32, 1, 0.23, 1)'
      });
    }
    if (mask) {
      mask.setStyle({
        'opacity': '0',
        'transition': 'opacity 0.3s ease'
      });
    }

    // 动画动起来之后，再不慌不忙地通知逻辑层
    // 此时用户看到的是面板已经滑下去了，逻辑层的延迟被视觉掩盖了
    ins.callMethod('close');
  } else {
    // 弹回原位
    if (sheet) {
      sheet.setStyle({
        'transform': 'translateY(0)',
        'transition': 'transform 0.3s cubic-bezier(0.32, 1, 0.23, 1)'
      });
    }
    if (mask) {
      mask.setStyle({
        'opacity': '1',
        'transition': 'opacity 0.3s ease'
      });
    }
  }
  isDragging = false;
}

function handleScroll(e, ins) {
  // 实时记录滚动位置到 WXS 状态中
  ins.getState().scrollTop = e.detail.scrollTop;
}

module.exports = {
  handleTouchStart: handleTouchStart,
  handleTouchMove: handleTouchMove,
  handleTouchEnd: handleTouchEnd,
  handleScroll: handleScroll
};