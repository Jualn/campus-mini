<!-- subpkg_activity/pages/list/index.wxml -->
<view class="activity-list-page">
  <!-- 顶部导航 -->
  <view class="top-bar" style="padding-top:{{statusBarHeight}}px;">
    <view class="top-bar__nav" style="margin-top: {{navTopGap}}px; height: {{navHeight}}px;">
      <back-button variant="nav" auto-back="{{false}}" bind:back="onBack" />
      <text class="top-bar__title">校园活动</text>
    </view>
    <!-- 搜索框 -->
    <view class="search-bar-wrap">
      <view class="search-bar">
        <view class="search-bar__icon-wrap">
          <ui-icon name="search" size="sm" />
        </view>
        <input
          class="search-bar__input"
          placeholder="搜索活动标题和简介…"
          placeholder-class="search-bar__placeholder"
          value="{{keyword}}"
          bindinput="onSearch"
          bindconfirm="onSearchConfirm"
          confirm-type="search"
          maxlength="200"
        />
        <view wx:if="{{keyword}}" class="search-bar__clear" catchtap="onClearSearch" aria-role="button" aria-label="清除搜索内容">
          <ui-icon name="clear" size="sm" />
        </view>
      </view>
    </view>
    <filter-bar filters="{{filters}}" bind:statuschange="onSwitchStatus" bind:categorychange="onCategoryChange" bind:scopechange="onScopeChange" />
  </view>

  <load-state wx:if="{{initialLoading}}" mode="loading" title="正在加载活动" fill-viewport viewport-offset="300" />
  <load-state wx:elif="{{initialError}}" mode="error" title="暂时无法加载" description="{{initialError}}" action-text="重新加载" bind:action="onRetryInitial" fill-viewport viewport-offset="300" />
  <block wx:else>
    <load-state wx:if="{{refreshError}}" mode="error" variant="inline" title="{{refreshError}}" action-text="重新刷新" bind:action="onRetryRefresh" />
    <view wx:if="{{refreshing}}" class="result-hint">正在刷新…</view>
    <view wx:if="{{loaded && keyword}}" class="result-hint">已加载 <text class="result-hint__count">{{list.length}}</text> 个活动</view>
    <view wx:if="{{list.length}}" class="list-wrap">
      <activity-card wx:for="{{list}}" wx:key="id" activity="{{item}}" preferred-department="{{filters[2].options[scopeIndex].id}}" bind:changed="onActivityChanged" />
    </view>
    <load-state wx:elif="{{loaded}}" mode="empty" title="暂无符合条件的活动" description="可下拉刷新或清除搜索与筛选" action-text="清除筛选" bind:action="onClearFilters" fill-viewport viewport-offset="300" />
    <view wx:if="{{loaded && (list.length || nextCursor)}}" class="list-footer">
      <text wx:if="{{loadingMore}}" class="footer-text">加载中…</text>
      <load-state wx:elif="{{moreError}}" mode="error" variant="inline" title="{{moreError}}" action-text="{{invalidCursor ? '从第一页重新加载' : '点击重试'}}" bind:action="onRetryMore" />
      <text wx:elif="{{!nextCursor}}" class="footer-text">— 已经到底啦 —</text>
    </view>
  </block>
</view>
<in-app-banner />
