/* subpkg_activity/pages/list/index.wxss */

page {
  background: var(--color-bg-page);
}

.activity-list-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 40rpx;
}

/* =====================================================
   顶部导航
   ===================================================== */
.top-bar {
  background: var(--color-bg-card);
  padding: 0 24rpx 16rpx;
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: 0;
  z-index: 10;
}

.top-bar__nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.top-bar__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-bar__back-icon {
  font-size: 52rpx;
  color: var(--color-text-primary);
  font-weight: 300;
  line-height: 1;
}

.top-bar__title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.top-bar__placeholder {
  width: 72rpx;
}

.search-wrap {
  display: flex;
  align-items: center;
  background: var(--color-bg-page);
  border-radius: 40rpx;
  padding: 0 28rpx;
  height: 72rpx;
  gap: 12rpx;
  margin-top: 8rpx;
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
  height: 72rpx;
}

.search-placeholder {
  color: var(--color-text-tertiary);
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-clear__icon {
  font-size: 20rpx;
  color: var(--color-text-inverse);
}

/* =====================================================
   筛选栏
   ===================================================== */
.filter-bar {
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
  padding-right: 20rpx;
}

.status-scroll {
  flex: 1;
  display: flex;
  white-space: nowrap;
  padding: 16rpx 20rpx;
  gap: 12rpx;
}

.status-tab {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: var(--color-bg-page);
  white-space: nowrap;
  flex-shrink: 0;
}

.status-tab--active {
  background: var(--color-text-primary);
}

.status-tab__label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.status-tab--active .status-tab__label {
  color: var(--color-text-inverse);
  font-weight: 600;
}

.scope-filter {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-page);
  flex-shrink: 0;
}

.scope-filter__text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.scope-filter__arrow {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* =====================================================
   系列活动
   ===================================================== */
.series-section {
  background: var(--color-bg-card);
  margin: 16rpx 20rpx 0;
  border-radius: var(--radius-md);
  padding: 24rpx 0 20rpx;
}

.section-header {
  padding: 0 28rpx 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.series-scroll {
  display: flex;
  white-space: nowrap;
  padding: 0 28rpx;
  gap: 12rpx;
}

.series-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-page);
  white-space: nowrap;
  flex-shrink: 0;
}

.series-tag__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: block;
}

.series-tag__label {
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.series-tag__count {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* =====================================================
   列表容器
   ===================================================== */
.list-wrap {
  padding: 16rpx 20rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* =====================================================
   状态角标（浮在封面上）
   ===================================================== */
.status-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-md);
  backdrop-filter: blur(8px);
}

.status-badge--enrolling {
  background: rgba(52, 199, 89, 0.88);
}

.status-badge--upcoming {
  background: rgba(0, 122, 255, 0.85);
}

.status-badge--ongoing {
  background: rgba(255, 149, 0, 0.9);
}

.status-badge--ended {
  background: rgba(0, 0, 0, 0.45);
}

.status-badge--cancelled {
  background: rgba(255, 59, 48, 0.85);
}

.status-badge--preview {
  background: rgba(88, 86, 214, 0.85);
}

.status-badge--unknown {
  background: rgba(0, 0, 0, 0.3);
}

.status-badge__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  display: block;
  animation: pulse 1.5s infinite;
}

.status-badge__text {
  font-size: 22rpx;
  color: var(--color-text-inverse);
  font-weight: 600;
}

/* 无封面时的状态胶囊 */
.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-md);
}

.status-pill--enrolling {
  background: #E8FFF0;
}

.status-pill--upcoming {
  background: var(--color-primary-light);
}

.status-pill--ongoing {
  background: #FFF5E8;
}

.status-pill--ended {
  background: var(--color-bg-page);
}

.status-pill--cancelled {
  background: #FFEBEB;
}

.status-pill--preview {
  background: #F0EEFF;
}

.status-pill--unknown {
  background: var(--color-bg-page);
}

.status-pill__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #34C759;
  display: block;
  animation: pulse 1.5s infinite;
}

.status-pill__text {
  font-size: 22rpx;
  font-weight: 600;
}

.status-pill--enrolling .status-pill__text {
  color: #34C759;
}

.status-pill--upcoming .status-pill__text {
  color: var(--color-primary);
}

.status-pill--ongoing .status-pill__text {
  color: #FF9500;
}

.status-pill--ended .status-pill__text {
  color: var(--color-text-tertiary);
}

.status-pill--cancelled .status-pill__text {
  color: #FF3B30;
}

.status-pill--preview .status-pill__text {
  color: #5856D6;
}

.status-pill--unknown .status-pill__text {
  color: var(--color-text-tertiary);
}

@keyframes pulse {

  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.3;
  }
}

/* =====================================================
   有封面：大图卡
   ===================================================== */
.card-img {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  height: 360rpx;
  box-shadow: var(--shadow-md);
}

.card-img__cover {
  width: 100%;
  height: 360rpx;
  display: block;
}

/* 底部渐变遮罩 */
.card-img__overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.0) 30%,
      rgba(0, 0, 0, 0.65) 70%,
      rgba(0, 0, 0, 0.85) 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 20rpx;
}

.card-img__top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.card-img__series {
  font-size: 22rpx;
  color: var(--color-text-inverse);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-md);
  backdrop-filter: blur(8px);
}

.card-img__bottom {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.card-img__tags {
  display: flex;
  gap: 8rpx;
}

.card-img__tag {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.18);
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
}

.card-img__title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text-inverse);
  line-height: 1.4;
}

.card-img__meta-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.card-img__meta-urgent {
  color: #FFD60A;
  font-weight: 600;
}

/* =====================================================
   无封面：彩色左边框卡
   ===================================================== */
.card-flat {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  display: flex;
  box-shadow: var(--shadow-card);
}

/* 左侧彩色竖条 */
.card-flat__side {
  width: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
}

.card-flat__icon {
  font-size: 40rpx;
}

/* 按活动类型配色 */
.card-flat--volunteer .card-flat__side {
  background: linear-gradient(180deg, #43e97b, #38f9d7);
}

.card-flat--competition .card-flat__side {
  background: linear-gradient(180deg, #f093fb, #f5576c);
}

.card-flat--lecture .card-flat__side {
  background: linear-gradient(180deg, #4facfe, #00f2fe);
}

.card-flat--checkin .card-flat__side {
  background: linear-gradient(180deg, #f6d365, #fda085);
}

.card-flat--campus .card-flat__side {
  background: linear-gradient(180deg, #a18cd1, #fbc2eb);
}

.card-flat--recruit .card-flat__side {
  background: linear-gradient(180deg, #667eea, #764ba2);
}

.card-flat--default .card-flat__side {
  background: linear-gradient(180deg, #bdc3c7, #2c3e50);
}

.card-flat__body {
  flex: 1;
  padding: 20rpx 24rpx 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.card-flat__top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.card-flat__series {
  font-size: 20rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 3rpx 10rpx;
  border-radius: 6rpx;
}

/* 截止倒计时红色胶囊 */
.card-flat__deadline-chip {
  background: #FF3B30;
  border-radius: var(--radius-md);
  padding: 3rpx 12rpx;
}

.card-flat__deadline-chip-text {
  font-size: 20rpx;
  color: var(--color-text-inverse);
  font-weight: 700;
}

.card-flat__title {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.5;
  display: block;
}

.card-flat__tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.card-flat__tag {
  font-size: 21rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  padding: 3rpx 12rpx;
  border-radius: 6rpx;
}

.card-flat__meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card-flat__meta-item {
  font-size: 23rpx;
  color: var(--color-text-secondary);
}

.card-flat__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--color-border-light);
  margin-top: 4rpx;
}

.card-flat__organizer {
  font-size: 21rpx;
  color: var(--color-text-tertiary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-flat__date {
  font-size: 21rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

/* =====================================================
   搜索结果 / 空态 / 底部
   ===================================================== */
.result-hint {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  padding: 16rpx 24rpx 0;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.list-footer {
  padding: 48rpx 0 20rpx;
  display: flex;
  justify-content: center;
}

.footer-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}