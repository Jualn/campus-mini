@import "../../../styles/skeleton.wxss";

/* subpkg_activity/pages/list/index.wxss */

page {
  background: var(--color-bg-page);
}

.activity-list-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: var(--space-xl);
}

/* =====================================================
   顶部导航  ← 对齐 .std-topbar 规范
   ===================================================== */
.top-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 14rpx 24rpx 22rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f2f7ff 100%);
  border-bottom: 1rpx solid var(--color-border-light);
}

.top-bar__nav {
  position: relative;
  display: flex;
  align-items: center;
}

.top-bar__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  flex-shrink: 0;
}

.top-bar__back-icon {
  font-size: 44rpx;
  color: var(--color-text-primary);
  line-height: 1;
  margin-top: -12rpx;
}

.top-bar__title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 30rpx;
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.search-bar-wrap {
  margin-top: 16rpx;
}

/* 搜索框 ← 对齐统一搜索页 */
.search-bar {
  display: flex;
  align-items: center;
  width: 100%;
  height: 72rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  padding: 0 20rpx;
  box-shadow: var(--shadow-sm);
}

.search-bar__icon-wrap {
  position: relative;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  background: rgba(47, 124, 246, 0.09);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-bar__icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
  opacity: 0.86;
  flex-shrink: 0;
}

.search-bar__input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.search-bar__placeholder {
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}

.search-bar__clear {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-bar__clear-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-bg-input);
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

/* =====================================================
   筛选栏
   ===================================================== */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 20rpx 0;
}

.status-scroll {
  flex: 1;
  display: flex;
  white-space: nowrap;
  min-width: 0;
}

/* 状态 Tab ← 对齐统一搜索页 */
.status-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  padding: 0 26rpx;
  border-radius: var(--radius-full);
  background: #ffffff;
  margin-right: 16rpx;
  box-shadow: var(--shadow-sm);
}

.status-tab--active {
  background: var(--color-primary);
}

.status-tab__label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.status-tab--active .status-tab__label {
  color: var(--color-text-inverse);
  font-weight: var(--weight-bold);
}

.scope-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  gap: 8rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-full);
  background: #ffffff;
  box-shadow: var(--shadow-sm);
  flex-shrink: 0;
}

.scope-filter__text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.scope-filter__arrow {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* =====================================================
   系列活动
   ===================================================== */
.series-section {
  background: var(--color-bg-card);
  margin: var(--space-sm) var(--space-sm) 0;
  border-radius: var(--radius-md);
  padding: var(--space-md) 0 var(--space-sm);
}

.section-header {
  padding: 0 28rpx var(--space-sm);
}

.section-title {
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.series-scroll {
  display: flex;
  white-space: nowrap;
  padding: 0 28rpx;
  gap: var(--space-xs);
}

.series-tag {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  padding: 10rpx var(--space-sm);
  border-radius: var(--radius-md);
  background: var(--color-bg-page);
  white-space: nowrap;
  flex-shrink: 0;
}

.series-tag--active {
  background: var(--color-primary-light);
}

.series-tag--active .series-tag__label {
  color: var(--color-primary);
  font-weight: var(--weight-bold);
}

.series-tag__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  display: block;
}

.series-tag__label {
  font-size: var(--font-sm);
  color: var(--color-text-primary);
}

.series-tag__count {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

/* =====================================================
   列表容器
   ===================================================== */
.list-wrap {
  padding: var(--space-sm) var(--space-sm) 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

/* =====================================================
   状态角标（浮在封面上）
   ===================================================== */
.status-badge {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  padding: 6rpx var(--space-sm);
  border-radius: var(--radius-sm);
  backdrop-filter: blur(8px);
}

.status-badge--enrolling {
  background: rgba(52, 199, 89, 0.88);
}

.status-badge--upcoming {
  background: rgba(0, 122, 255, 0.85);
}

.status-badge--ongoing {
  background: rgba(255, 149, 0, 0.9);
}

.status-badge--ended {
  background: rgba(0, 0, 0, 0.45);
}

.status-badge--cancelled {
  background: rgba(255, 59, 48, 0.85);
}

.status-badge--preview {
  background: rgba(88, 86, 214, 0.85);
}

.status-badge--unknown {
  background: rgba(0, 0, 0, 0.3);
}

.status-badge__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  display: block;
  animation: pulse 1.5s infinite;
}

.status-badge__text {
  font-size: var(--font-xs);
  color: var(--color-text-inverse);
  font-weight: var(--weight-bold);
}

/* 无封面时的状态胶囊 */
.status-pill {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
}

.status-pill--enrolling {
  background: #E8FFF0;
}

.status-pill--upcoming {
  background: var(--color-primary-light);
}

.status-pill--ongoing {
  background: #FFF5E8;
}

.status-pill--ended {
  background: var(--color-bg-page);
}

.status-pill--cancelled {
  background: #FFEBEB;
}

.status-pill--preview {
  background: #F0EEFF;
}

.status-pill--unknown {
  background: var(--color-bg-page);
}

.status-pill__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-full);
  background: var(--color-success);
  display: block;
  animation: pulse 1.5s infinite;
}

.status-pill__text {
  font-size: var(--font-xs);
  font-weight: var(--weight-bold);
}

.status-pill--enrolling .status-pill__text {
  color: var(--color-success);
}

.status-pill--upcoming .status-pill__text {
  color: var(--color-primary);
}

.status-pill--ongoing .status-pill__text {
  color: var(--color-warning);
}

.status-pill--ended .status-pill__text {
  color: var(--color-text-tertiary);
}

.status-pill--cancelled .status-pill__text {
  color: var(--color-danger);
}

.status-pill--preview .status-pill__text {
  color: #5856D6;
}

.status-pill--unknown .status-pill__text {
  color: var(--color-text-tertiary);
}

@keyframes pulse {

  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.3;
  }
}

/* =====================================================
   有封面：大图卡
   ===================================================== */
.card-img {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  height: 360rpx;
  box-shadow: var(--shadow-md);
}

.card-img__cover {
  width: 100%;
  height: 360rpx;
  display: block;
}

.card-img__overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.00) 30%,
      rgba(0, 0, 0, 0.65) 70%,
      rgba(0, 0, 0, 0.85) 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: var(--space-sm);
}

.card-img__top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.card-img__series {
  font-size: var(--font-xs);
  color: var(--color-text-inverse);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  backdrop-filter: blur(8px);
}

.card-img__bottom {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.card-img__tags {
  display: flex;
  gap: var(--space-xs);
}

.card-img__tag {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.18);
  padding: 3rpx 12rpx;
  border-radius: var(--radius-sm);
}

.card-img__title {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-text-inverse);
  line-height: 1.4;
}

.card-img__meta-text {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.85);
}

.card-img__meta-urgent {
  color: #FFD60A;
  font-weight: var(--weight-bold);
}

/* =====================================================
   无封面：彩色左边框卡
   ===================================================== */
.card-flat {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  display: flex;
  box-shadow: var(--shadow-card);
}

.card-flat__side {
  width: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
}

.card-flat__icon {
  font-size: var(--font-xl);
}

.card-flat--volunteer .card-flat__side {
  background: linear-gradient(180deg, #43e97b, #38f9d7);
}

.card-flat--competition .card-flat__side {
  background: linear-gradient(180deg, #f093fb, #f5576c);
}

.card-flat--lecture .card-flat__side {
  background: linear-gradient(180deg, #4facfe, #00f2fe);
}

.card-flat--checkin .card-flat__side {
  background: linear-gradient(180deg, #f6d365, #fda085);
}

.card-flat--campus .card-flat__side {
  background: linear-gradient(180deg, #a18cd1, #fbc2eb);
}

.card-flat--recruit .card-flat__side {
  background: linear-gradient(180deg, #667eea, #764ba2);
}

.card-flat--default .card-flat__side {
  background: linear-gradient(180deg, #bdc3c7, #2c3e50);
}

.card-flat__body {
  flex: 1;
  padding: var(--space-sm) var(--space-md) var(--space-sm) var(--space-sm);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.card-flat__top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.card-flat__series {
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 3rpx 10rpx;
  border-radius: var(--radius-sm);
}

.card-flat__deadline-chip {
  background: var(--color-danger);
  border-radius: var(--radius-sm);
  padding: 3rpx 12rpx;
}

.card-flat__deadline-chip-text {
  font-size: var(--font-xs);
  color: var(--color-text-inverse);
  font-weight: var(--weight-bold);
}

.card-flat__title {
  font-size: 29rpx;
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  line-height: 1.5;
  display: block;
}

.card-flat__tags {
  display: flex;
  gap: var(--space-xs);
  flex-wrap: wrap;
}

.card-flat__tag {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  padding: 3rpx 12rpx;
  border-radius: var(--radius-sm);
}

.card-flat__meta {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.card-flat__meta-item {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.card-flat__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--color-border-light);
  margin-top: 4rpx;
}

.card-flat__organizer {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-flat__date {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

/* =====================================================
   搜索结果区
   ===================================================== */
.result-hint {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  padding: var(--space-sm) var(--space-md) 0;
}

.result-hint__count {
  color: var(--color-primary);
  font-weight: var(--weight-bold);
}

.search-hl {
  color: var(--color-primary);
  font-weight: var(--weight-bold);
  background: var(--color-primary-light);
  border-radius: 4rpx;
  padding: 0 2rpx;
}

.search-hl--dark {
  color: #FFD60A;
  background: rgba(255, 214, 10, 0.18);
}

.search-match-hint {
  display: inline-flex;
  align-items: center;
}

.search-match-hint__text {
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 3rpx 12rpx;
  border-radius: var(--radius-sm);
}

/* =====================================================
   空态 ← 对齐 .empty-state 规范
   ===================================================== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
  gap: var(--space-sm);
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.empty-sub {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  text-align: center;
  line-height: 1.6;
}

/* =====================================================
   列表底部 ← 对齐 .g-list-footer 规范
   ===================================================== */
.list-footer {
  padding: var(--space-xl) 0 120rpx;
  display: flex;
  justify-content: center;
}

.footer-text {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

/* =====================================================
   简单加载骨架
   依赖 styles/skeleton.wxss 中的 .skeleton-block 等公共样式
   ===================================================== */
.filter-skeleton {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 20rpx 0;
}

.filter-skeleton__chip {
  width: 128rpx;
  height: 62rpx;
  border-radius: var(--radius-full);
}

.filter-skeleton__chip--wide {
  width: 168rpx;
}

.filter-skeleton__scope {
  width: 120rpx;
  height: 62rpx;
  margin-left: auto;
  border-radius: var(--radius-full);
}

.list-skeleton {
  padding: var(--space-sm) var(--space-sm) 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.list-skeleton-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 20rpx;
  box-shadow: var(--shadow-sm);
}

.list-skeleton-card__cover {
  width: 100%;
  height: 260rpx;
  margin-bottom: 20rpx;
}

.list-skeleton-card__body {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.list-skeleton-card__title {
  width: 78%;
  height: 34rpx;
}

.list-skeleton-card__line {
  width: 54%;
  height: 24rpx;
}

.list-skeleton-card__meta {
  display: flex;
  gap: 12rpx;
  margin-top: 4rpx;
}

.list-skeleton-card__pill {
  width: 150rpx;
  height: 36rpx;
}

.list-skeleton-card__pill--short {
  width: 108rpx;
}

/* =====================================================
   加载失败 / 底部加载状态
   ===================================================== */
   .load-state {
    margin: 140rpx 40rpx 0;
    padding: 56rpx 36rpx;
    border-radius: var(--radius-lg);
    background: var(--color-bg-card);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  
  .load-state__icon {
    font-size: 56rpx;
    line-height: 1;
    margin-bottom: 22rpx;
  }
  
  .load-state__title {
    font-size: 30rpx;
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    margin-bottom: 10rpx;
  }
  
  .load-state__desc {
    font-size: 24rpx;
    color: var(--color-text-tertiary);
    margin-bottom: 28rpx;
  }
  
  .load-state__btn {
    height: 64rpx;
    padding: 0 34rpx;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .load-state__btn-text {
    font-size: 26rpx;
    font-weight: var(--weight-bold);
    color: var(--color-text-inverse);
  }
  
  .footer-loading,
  .footer-retry {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10rpx;
  }
  
  .footer-loading__dot {
    width: 18rpx;
    height: 18rpx;
    border-radius: 50%;
    background: var(--color-primary);
    opacity: 0.55;
    animation: pulse 1.2s infinite;
  }
  
  .footer-text--error {
    color: var(--color-danger);
  }
  