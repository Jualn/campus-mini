@import "../../../styles/skeleton.wxss";

/* subpkg_activity/pages/detail/index.wxss */

.detail-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  /* padding-bottom: 120rpx; */
}

/* =====================================================
   封面区：固定高度，16:9 感觉
   ===================================================== */
.cover-section {
  position: relative;
  width: 100%;
  height: 520rpx;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 520rpx;
  display: block;
}

/* 无封面时按类型渐变兜底 */
.cover-placeholder {
  width: 100%;
  height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-placeholder--volunteer {
  background: linear-gradient(160deg, #43e97b, #38f9d7);
}

.cover-placeholder--competition {
  background: linear-gradient(160deg, #f093fb, #f5576c);
}

.cover-placeholder--lecture {
  background: linear-gradient(160deg, #4facfe, #00f2fe);
}

.cover-placeholder--checkin {
  background: linear-gradient(160deg, #f6d365, #fda085);
}

.cover-placeholder--campus {
  background: linear-gradient(160deg, #a18cd1, #fbc2eb);
}

.cover-placeholder--recruit {
  background: linear-gradient(160deg, #667eea, #764ba2);
}

.cover-placeholder--default {
  background: linear-gradient(160deg, #1a1a2e, #0f3460);
}

.cover-placeholder__icon {
  font-size: 120rpx;
  opacity: 0.6;
}

/* 顶部遮罩：保护返回按钮可读性 */
.cover-top-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  box-sizing: border-box;
  padding-bottom: 80rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4) 0%, transparent 100%);
  padding-left: 28rpx;
  padding-right: 28rpx;
  display: flex;
  align-items: flex-end;
  pointer-events: none;
}

.cover-back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(16, 35, 63, 0.56);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  pointer-events: auto;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: none;
}

.cover-back__icon {
  font-size: 48rpx;
  color: var(--color-text-inverse);
  font-weight: 300;
  line-height: 1;
  margin-top: -12rpx;
}

/* 底部遮罩：让信息卡浮起来时过渡自然 */
.cover-bottom-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.25) 100%);
}

/* =====================================================
   信息卡：浮起压住封面底部
   ===================================================== */
.info-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  margin-top: -48rpx;
  /* 上移压住封面 */
  padding: 32rpx 28rpx 24rpx;
  position: relative;
  z-index: 2;
  /* 拉手条视觉暗示可以上滑 */
}

/* 拉手条 */
.info-card::before {
  content: "";
  display: block;
  width: 64rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  margin: 0 auto 28rpx;
}

.info-card__tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

/* 状态标签 */
.hero-status {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-md);
}

.hero-status--enrolling {
  background: #e8fff0;
}

.hero-status--upcoming {
  background: var(--color-primary-light);
}

.hero-status--ongoing {
  background: #fff5e8;
}

.hero-status--ended {
  background: var(--color-bg-page);
}

.hero-status--cancelled {
  background: #ffebeb;
}

.hero-status--preview {
  background: #f0eeff;
}

.hero-status--unknown {
  background: var(--color-bg-page);
}

.hero-status__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #34c759;
  display: block;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.3;
  }
}

.hero-status__text {
  font-size: 22rpx;
  font-weight: 600;
}

.hero-status--enrolling .hero-status__text {
  color: #34c759;
}

.hero-status--upcoming .hero-status__text {
  color: var(--color-primary);
}

.hero-status--ongoing .hero-status__text {
  color: #ff9500;
}

.hero-status--ended .hero-status__text {
  color: var(--color-text-tertiary);
}

.hero-status--cancelled .hero-status__text {
  color: #ff3b30;
}

.hero-status--preview .hero-status__text {
  color: #5856d6;
}

.hero-status--unknown .hero-status__text {
  color: var(--color-text-tertiary);
}

.info-card__series {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 5rpx 14rpx;
  border-radius: var(--radius-md);
}

.info-card__type-badge {
  margin-left: auto;
  background: var(--color-bg-page);
  padding: 5rpx 16rpx;
  border-radius: var(--radius-md);
}

.info-card__type-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.info-card__title {
  font-size: 38rpx;
  font-weight: 900;
  color: var(--color-text-primary);
  line-height: 1.4;
  display: block;
  margin-bottom: 14rpx;
}

.info-card__meta {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 16rpx;
  min-width: 0;
  margin-bottom: 24rpx;
}

.info-card__organizer {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  flex: 1 1 280rpx;
  min-width: 0;
  line-height: 1.6;
  white-space: normal;
  overflow-wrap: anywhere;
}

.info-card__scope {
  font-size: 23rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-md);
  box-sizing: border-box;
  flex: 0 1 auto;
  max-width: 100%;
  line-height: 1.55;
  white-space: normal;
  overflow-wrap: anywhere;
}

.info-card__divider {
  height: 1rpx;
  background: #f0f0f0;
  margin-bottom: 24rpx;
}

/* 三格数据 */
.info-card__stats {
  display: flex;
  align-items: center;
}

.info-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.info-stat__value {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  line-height: 1;
}

.info-stat__value--deadline {
  color: #ff3b30;
}

.info-stat__label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.info-stat__sep {
  width: 1rpx;
  height: 60rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

/* =====================================================
   通用卡片
   ===================================================== */
.section-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin: 20rpx 20rpx 0;
  padding: 32rpx 28rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.section-title-icon {
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
}

.section-desc {
  font-size: 28rpx;
  color: #444;
  line-height: 1.85;
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}

.section-disclaimer {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 20rpx;
}

/* =====================================================
   关键时间 - 报名截止突出块
   ===================================================== */
.deadline-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff8f0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #ffe0b2;
}

.deadline-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.deadline-label {
  font-size: 24rpx;
  color: #ff9500;
  font-weight: 600;
}

.deadline-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.deadline-countdown {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.deadline-days {
  font-size: 56rpx;
  font-weight: 900;
  color: #ff3b30;
  line-height: 1;
}

.deadline-days-unit {
  font-size: 22rpx;
  color: #ff3b30;
}

.deadline-expired-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  font-weight: 600;
}

/* 时间线（复用考试页样式） */
.timeline {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.tl-item {
  display: flex;
  gap: 20rpx;
  position: relative;
  padding-bottom: 28rpx;
}

.tl-item--last {
  padding-bottom: 0;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.tl-dot--done {
  background: #34c759;
}

.tl-dot--active {
  background: var(--color-primary);
  box-shadow: 0 0 0 6rpx rgba(0, 122, 255, 0.18);
}

.tl-dot--future {
  background: #d0d0d0;
}

.tl-dot--unknown {
  background: #e8e8e8;
  border: 2rpx dashed #bbb;
}

.tl-line {
  position: absolute;
  left: 9rpx;
  top: 26rpx;
  bottom: 0;
  width: 2rpx;
  background: #f0f0f0;
}

.tl-content {
  flex: 1;
}

.tl-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
  flex-wrap: wrap;
}

.tl-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.tl-source {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg-page);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.tl-datetime {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tl-date {
  font-size: 27rpx;
  color: #444;
}

.tl-time {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  background: var(--color-bg-page);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.tl-pending {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  font-style: italic;
}

.tl-note {
  display: block;
  font-size: 23rpx;
  color: #ff9500;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* 活动时间/地点行 */
.time-rows {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.time-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.time-row__icon {
  font-size: 30rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.time-row__body {
  flex: 1;
}

.time-row__label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 4rpx;
}

.time-row__value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

/* =====================================================
   奖项
   ===================================================== */
.reward-list {
  display: flex;
  flex-direction: column;
}

.reward-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.reward-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.reward-level {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.reward-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.reward-count {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.reward-prize {
  font-size: 26rpx;
  color: #ff9500;
  font-weight: 600;
}

.reward-note {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* =====================================================
   参与方式 / 报名信息
   ===================================================== */
.participation-block {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(47, 124, 246, 0.12);
  border-radius: 24rpx;
  background: #f8fbff;
}

.participation-block__heading,
.registration-form-preview__heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.participation-block__eyebrow,
.participation-block__title,
.participation-block__desc,
.participation-block__meta,
.registration-form-preview__note,
.participation-block__warning {
  display: block;
}

.participation-block__eyebrow {
  margin-bottom: 4rpx;
  font-size: 21rpx;
  font-weight: 650;
  color: var(--color-primary);
}

.participation-block__title {
  font-size: 30rpx;
  font-weight: 720;
  line-height: 1.45;
  color: var(--color-text-primary);
}

.participation-status {
  flex: 0 0 auto;
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 650;
  color: var(--color-text-secondary);
  background: rgba(16, 35, 63, 0.06);
}

.participation-status--success {
  color: #178451;
  background: rgba(32, 183, 107, 0.11);
}

.participation-block__desc,
.participation-block__meta,
.participation-block__warning {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--color-text-secondary);
}

.participation-block__meta {
  color: var(--color-primary-deep);
}

.participation-block__warning {
  color: #a05b16;
}

.registration-form-preview {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid var(--color-border-light);
}

.registration-form-preview__title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.registration-form-preview__count {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.registration-form-field {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-hairline);
}

.registration-form-field__main {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.registration-form-field__index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  font-size: 19rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.registration-form-field__label {
  flex: 1;
  min-width: 180rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow-wrap: anywhere;
}

.registration-form-field__type,
.registration-form-field__required {
  padding: 3rpx 9rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--color-text-tertiary);
  background: rgba(16, 35, 63, 0.05);
}

.registration-form-field__help {
  display: block;
  margin: 8rpx 0 0 44rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.registration-form-preview__note {
  margin-top: 14rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--color-text-tertiary);
}

.participation-inline-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 78rpx;
  margin: 22rpx 0 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.external-participation {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-hairline);
}

.external-participation__heading {
  margin-bottom: 8rpx;
}

.external-participation__title,
.external-participation__hint {
  display: block;
}

.external-participation__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.external-participation__hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.participation-empty {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
}

.join-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.join-qrcode {
  width: 320rpx;
  height: 320rpx;
  border-radius: 16rpx;
}

.join-desc {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  align-self: flex-start;
  white-space: pre-wrap;
}

/* =====================================================
   联系人
   ===================================================== */
.contact-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.contact-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.contact-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1 1 0;
  min-width: 0;
}

.contact-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-text-primary);
  color: var(--color-text-inverse);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  text-align: center;
  line-height: 72rpx;
}

.contact-info {
  flex: 1;
  min-width: 0;
}

.contact-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.contact-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.contact-role {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  background: #ebebeb;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.contact-phone,
.contact-qq {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  display: block;
  white-space: normal;
  overflow-wrap: anywhere;
}

.contact-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 0 0 auto;
  align-self: flex-start;
}

.contact-btn {
  padding: 8rpx 20rpx;
  background: var(--color-primary-light);
  border: 1rpx solid rgba(47, 124, 246, 0.16);
  border-radius: var(--radius-md);
}

.contact-btn__text {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

/* =====================================================
   附件
   ===================================================== */
.attachment-list {
  display: flex;
  flex-direction: column;
}

.attachment-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.attachment-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.attachment-icon {
  font-size: 44rpx;
  flex-shrink: 0;
}

.attachment-body {
  flex: 1;
}

.attachment-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  display: block;
}

.attachment-note {
  font-size: 23rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin-top: 4rpx;
}

.attachment-type-badge {
  text-transform: uppercase;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg-page);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.attachment-arrow {
  font-size: 36rpx;
  color: #ddd;
  flex-shrink: 0;
}

/* =====================================================
   来源信息
   ===================================================== */
.source-card {
  margin: 20rpx 20rpx 0;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.source-item {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* =====================================================
   底部按钮
   ===================================================== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 22rpx;
  bottom: calc(22rpx + constant(safe-area-inset-bottom));
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  z-index: 5;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: transparent;
  border: none;
  box-shadow: none;
  pointer-events: none;
}

.bottom-secondary {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-text-primary);
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(16, 35, 63, 0.08);
  box-shadow: 0 10rpx 28rpx rgba(16, 35, 63, 0.14);
  white-space: nowrap;
  pointer-events: auto;
}

.subscription-btn {
  min-width: 170rpx;
  max-width: 220rpx;
}

.share-btn {
  width: 92rpx;
  flex-direction: column;
  padding: 0;
  gap: 4rpx;
}

.share-btn__text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

.primary-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  color: var(--color-text-inverse);
  text-align: center;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-blue-2) 100%);
  box-shadow: 0 12rpx 30rpx rgba(47, 124, 246, 0.3);
  pointer-events: auto;
}

.primary-action--disabled {
  color: var(--color-text-tertiary);
  background: #edf1f5;
  box-shadow: none;
}

.bottom-bar--secondary-only .bottom-secondary {
  flex: 1;
  max-width: none;
  flex-direction: row;
  gap: 10rpx;
}

.bottom-secondary::after,
.primary-action::after,
.participation-inline-button::after {
  border: none;
}

.bottom-safe {
  height: 124rpx;
}

/* 普通行内小图标 */
.inline-icon {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
}

/* 链接 / 附件列表统一图标 */
.link-icon-img,
.attachment-icon-img {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

/* 分享按钮图标 */
.share-btn__icon-img {
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
}

/* =====================================================
   简单加载骨架
   依赖 styles/skeleton.wxss 中的 .skeleton-block 等公共样式
   ===================================================== */
.detail-skeleton {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 160rpx;
}

.detail-skeleton__cover {
  width: 100%;
  height: 520rpx;
}

.detail-skeleton__info {
  position: relative;
  z-index: 2;
  margin-top: -48rpx;
  padding: 36rpx 28rpx 28rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
}

.detail-skeleton__tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.detail-skeleton__tag {
  width: 128rpx;
  height: 34rpx;
}

.detail-skeleton__tag--short {
  width: 88rpx;
  margin-left: auto;
}

.detail-skeleton__title {
  width: 86%;
  height: 42rpx;
  margin-bottom: 18rpx;
}

.detail-skeleton__sub {
  width: 58%;
  height: 28rpx;
}

.detail-skeleton__divider {
  height: 1rpx;
  background: var(--color-border-light);
  margin: 26rpx 0;
}

.detail-skeleton__stats {
  display: flex;
  justify-content: space-between;
  gap: 28rpx;
}

.detail-skeleton__stat {
  flex: 1;
  height: 60rpx;
}

.detail-skeleton__card {
  margin: 20rpx 20rpx 0;
  padding: 28rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
}

.detail-skeleton__card-title {
  width: 180rpx;
  height: 32rpx;
  margin-bottom: 24rpx;
}

.detail-skeleton__line {
  width: 100%;
  height: 26rpx;
  margin-bottom: 16rpx;
}

.detail-skeleton__line--short {
  width: 64%;
  margin-bottom: 0;
}

/* =====================================================
   详情加载失败状态
   ===================================================== */
.detail-error {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: border-box;
}

.detail-error__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3f6fa;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  border: none;
}


.event-body {
  display: block;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  line-height: 1.8;
}
.event-action {
  padding: 20rpx 0;
}
.event-action__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.event-action__button {
  margin: 14rpx 0 0;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: left;
  white-space: normal;
  overflow-wrap: anywhere;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
}

/* 新信息结构复用原有卡片，长标题、号码及窄屏保持换行。 */
.info-stat {
  min-width: 0;
  padding: 0 8rpx;
  text-align: center;
}
.info-stat__value {
  font-size: 28rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.hero-status--not_started {
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}
.tl-dot--pending {
  background: #d0d0d0;
}
.tl-content,
.attachment-body,
.contact-left,
.contact-info,
.time-row__body {
  min-width: 0;
  overflow-wrap: anywhere;
}
.tl-datetime,
.contact-name-row {
  flex-wrap: wrap;
}
.event-action + .event-action {
  border-top: 1rpx solid var(--color-border-light);
}
.event-action__heading {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 12rpx;
}
.event-action__type {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.event-action__title {
  overflow-wrap: anywhere;
}
.event-action__button::after {
  border: none;
}
.event-action .join-qrcode {
  display: block;
  margin: 16rpx 0;
  max-width: 100%;
}
.bottom-safe {
  height: calc(164rpx + env(safe-area-inset-bottom));
}

/* Layout stays with the caller; UiIcon owns the glyph. */
.icon-slot {
  display: flex;
  align-items: center;
  justify-content: center;
}
