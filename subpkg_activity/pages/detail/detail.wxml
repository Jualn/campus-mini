<!-- subpkg_activity/pages/detail/index.wxml -->
<view class="detail-page">
  <!-- 加载骨架：封面 + 信息卡 + 内容卡片 -->
  <block wx:if="{{asyncLoad.phase === 'idle' || asyncLoad.phase === 'loading'}}">
    <view wx:if="{{asyncLoad.skeletonVisible}}" class="detail-skeleton" aria-role="status" aria-label="活动详情加载中">
      <view class="skeleton-block detail-skeleton__cover" />

      <view class="detail-skeleton__info">
        <view class="detail-skeleton__tag-row">
          <view class="skeleton-block skeleton-radius-md detail-skeleton__tag" />
          <view class="skeleton-block skeleton-radius-md detail-skeleton__tag detail-skeleton__tag--short" />
        </view>
        <view class="skeleton-block skeleton-radius-md detail-skeleton__title" />
        <view class="skeleton-block skeleton-radius-md detail-skeleton__sub" />
        <view class="detail-skeleton__divider" />
        <view class="detail-skeleton__stats">
          <view class="skeleton-block skeleton-radius-md detail-skeleton__stat" />
          <view class="skeleton-block skeleton-radius-md detail-skeleton__stat" />
          <view class="skeleton-block skeleton-radius-md detail-skeleton__stat" />
        </view>
      </view>

      <view wx:for="{{skeletonSections}}" wx:key="*this" class="detail-skeleton__card">
        <view class="skeleton-block skeleton-radius-md detail-skeleton__card-title" />
        <view class="skeleton-block skeleton-radius-md detail-skeleton__line" />
        <view class="skeleton-block skeleton-radius-md detail-skeleton__line detail-skeleton__line--short" />
      </view>
    </view>
  </block>

  <block wx:elif="{{asyncLoad.phase === 'error'}}">
    <view class="detail-error" style="padding-top:{{statusBarHeight}}px;">
      <view class="detail-error__back" bindtap="onBack" aria-role="button" aria-label="返回">
        <ui-icon name="chevron-left" size="lg" />
      </view>
      <load-state
        mode="{{asyncLoad.loading ? 'loading' : 'error'}}"
        title="{{asyncLoad.loading ? '正在重新加载' : '暂时无法加载'}}"
        description="{{asyncLoad.loading ? '' : (asyncLoad.errorMessage || '网络可能暂时不可用，请稍后再试')}}"
        action-text="{{asyncLoad.loading ? '' : '重新加载'}}"
        fill-viewport
        viewport-offset="150"
        bind:action="onRetryDetail"
      />
    </view>
  </block>

  <block wx:else>
    <!-- 封面区：固定比例，返回按钮浮在上面 -->
    <view class="cover-section">
      <!-- 有封面图 -->
      <image wx:if="{{activity.cover}}" class="cover-img" src="{{activity.cover}}" mode="aspectFill" />
      <!-- 无封面：按类型渐变兜底 -->
      <view wx:else class="cover-placeholder cover-placeholder--{{activity.typeColor}}">
        <text class="cover-placeholder__icon">{{activity.typeIcon}}</text>
      </view>
      <!-- 顶部渐变遮罩（让返回按钮更清晰） -->
      <view class="cover-top-mask" style="padding-top:{{statusBarHeight}}px;">
        <view class="cover-back" bindtap="onBack" aria-role="button" aria-label="返回上一页">
          <ui-icon name="chevron-left" state="inverse" size="lg" />
        </view>
      </view>
      <!-- 底部渐变遮罩 -->
      <view class="cover-bottom-mask" />
    </view>

    <!-- 信息卡：margin-top负值压住封面底部，形成层叠 -->
    <view class="info-card">
      <!-- 状态 + 系列标签行 -->
      <view class="info-card__tags">
        <view class="hero-status hero-status--{{activity.status}}">
          <text class="hero-status__dot" wx:if="{{activity.status==='enrolling'}}" />
          <text class="hero-status__text">{{activity.statusLabel}}</text>
        </view>
        <!-- <text class="info-card__series" wx:if="{{activity.series_name}}">{{activity.series_name}}</text> -->
        <view class="info-card__type-badge">
          <text class="info-card__type-text">{{activity.type}}</text>
        </view>
      </view>

      <!-- 标题 -->
      <text class="info-card__title">{{activity.title}}</text>

      <!-- 主办方 + 范围 -->
      <view class="info-card__meta">
        <text class="info-card__organizer">{{activity.organizer}}</text>
        <block wx:for="{{activity.scope}}" wx:key="index">
          <text class="info-card__scope">{{item}}</text>
        </block>
      </view>

      <!-- 分隔线 -->
      <view class="info-card__divider" />

      <view class="info-card__stats">
        <view class="info-stat">
          <text class="info-stat__value">{{activity.deadlineSummary}}</text>
          <text class="info-stat__label">参与状态</text>
        </view>
        <view class="info-stat__sep" />
        <view class="info-stat">
          <text class="info-stat__value">{{activity.cardTimelineLabel || '详见时间线'}}</text>
          <text class="info-stat__label">卡片阶段</text>
        </view>
        <view class="info-stat__sep" />
        <view class="info-stat">
          <text class="info-stat__value"
            >{{activity.platformRegistrationText || activity.capacityText || '未公布'}}</text
          >
          <text class="info-stat__label">平台报名</text>
        </view>
      </view>
    </view>

    <!-- 关键时间卡片（最突出） -->
    <view class="section-card" wx:if="{{activity.timeline.length || activity.location || activity.capacityText}}">
      <view class="section-title-row">
        <image class="section-title-icon" src="/assets/icons/detail/important_time.svg" mode="aspectFit" />
        <text class="section-title">重要时间</text>
      </view>

      <!-- 完整时间线；不以卡片投影过滤节点。 -->
      <view class="timeline" wx:if="{{activity.timeline && activity.timeline.length}}">
        <view
          wx:for="{{activity.timeline}}"
          wx:key="key"
          class="tl-item {{index===activity.timeline.length-1?'tl-item--last':''}}"
        >
          <view class="tl-dot tl-dot--{{item.status}}" />
          <view class="tl-line" wx:if="{{index<activity.timeline.length-1}}" />
          <view class="tl-content">
            <view class="tl-header">
              <text class="tl-label">{{item.label}}</text>
              <!-- <text class="tl-source" wx:if="{{item.source}}">{{item.source}}</text> -->
            </view>
            <view class="tl-datetime">
              <text class="tl-date">{{item.scheduleText}}</text>
              <!-- <text class="tl-source">{{item.scheduleKindLabel}}</text> -->
            </view>
            <text class="tl-note" wx:if="{{item.note}}">{{item.note}}</text>
          </view>
        </view>
      </view>

      <view class="time-rows">
        <view class="time-row" wx:if="{{activity.location}}">
          <view class="inline-icon icon-slot"><ui-icon name="location" size="lg" /></view>
          <view class="time-row__body">
            <text class="time-row__label">活动地点</text>
            <text class="time-row__value">{{activity.location}}</text>
          </view>
        </view>
        <view class="time-row" wx:if="{{activity.capacityText}}">
          <view class="inline-icon icon-slot"><ui-icon name="participants" size="lg" /></view>
          <view class="time-row__body">
            <text class="time-row__label">官方名额</text>
            <text class="time-row__value">{{activity.capacityText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card" wx:for="{{activity.sections}}" wx:key="key"
      ><view class="section-title-row"><text class="section-title">{{item.title}}</text></view
      ><text class="event-body" user-select>{{item.content}}</text></view
    >
    <view class="section-card" wx:if="{{activity.audienceSummary}}">
      <view class="section-title-row"><text class="section-title">参与要求</text></view>
      <text class="event-body" user-select>{{activity.audienceSummary}}</text>
    </view>
    <!-- 活动介绍 -->
    <view class="section-card" wx:if="{{activity.description && !activity.sections.length}}">
      <view class="section-title-row">
        <image class="section-title-icon" src="/assets/icons/detail/activity_intro.svg" mode="aspectFit" />
        <text class="section-title">活动介绍</text>
      </view>
      <text class="section-desc" user-select>{{activity.description}}</text>
    </view>

    <!-- 正文保留完整参与信息；底部操作栏仅提供快捷入口。 -->
    <view id="join-section" class="section-card" wx:if="{{activity.hasParticipation}}">
      <view class="section-title-row">
        <image class="section-title-icon" src="/assets/icons/detail/join_method.svg" mode="aspectFit" />
        <text class="section-title">参与方式 / 报名信息</text>
      </view>

      <text class="section-disclaimer">请按活动要求完成相关步骤，查看入口或订阅不代表报名成功。</text>

      <view wx:if="{{activity.registrationMode === 2 || activity.registrationMode === 4}}" class="participation-block">
        <view class="participation-block__heading">
          <view>
            <text class="participation-block__eyebrow">平台报名</text>
            <text class="participation-block__title">{{activity.registrationLabel}}</text>
          </view>
          <text
            wx:if="{{registrationStatus === 'SUBMITTED'}}"
            class="participation-status participation-status--success"
            >已提交</text
          >
          <text wx:elif="{{registrationStatus === 'CANCELLED'}}" class="participation-status">已取消</text>
          <text wx:else class="participation-status">未提交</text>
        </view>
        <text wx:if="{{registrationStatus === 'SUBMITTED'}}" class="participation-block__desc">
          本人已完成平台表单提交，可进入报名页查看记录。
        </text>
        <text wx:elif="{{registrationStatus === 'CANCELLED'}}" class="participation-block__desc">
          本人已取消提交；能否重新报名以当前报名状态和名额为准。
        </text>
        <text wx:else class="participation-block__desc">本人尚未提交平台报名表。</text>
        <text wx:if="{{activity.platformRegistrationText}}" class="participation-block__meta">
          {{activity.platformRegistrationText}}
        </text>

        <view wx:if="{{activity.registrationForm}}" class="registration-form-preview">
          <view class="registration-form-preview__heading">
            <text class="registration-form-preview__title">报名表单</text>
            <text class="registration-form-preview__count">共 {{activity.registrationForm.fields.length}} 项</text>
          </view>
          <view wx:for="{{activity.registrationForm.fields}}" wx:key="key" class="registration-form-field">
            <view class="registration-form-field__main">
              <text class="registration-form-field__index">{{index + 1}}</text>
              <text class="registration-form-field__label">{{item.label}}</text>
              <text class="registration-form-field__type">{{item.typeLabel}}</text>
              <text class="registration-form-field__required">{{item.required ? '必填' : '选填'}}</text>
            </view>
            <text wx:if="{{item.helpText}}" class="registration-form-field__help">{{item.helpText}}</text>
          </view>
          <text wx:if="{{activity.registrationForm.allowModification}}" class="registration-form-preview__note">
            提交后允许在活动规则许可时修改。
          </text>
          <text wx:else class="registration-form-preview__note">提交后不可修改，请确认信息无误。</text>
        </view>
        <text wx:else class="participation-block__warning">报名表暂不可读取，请稍后重新进入页面。</text>
        <button class="participation-inline-button" bindtap="onRegistration">
          <text wx:if="{{registrationStatus === 'SUBMITTED'}}">查看本人报名</text>
          <text wx:elif="{{registrationStatus === 'CANCELLED'}}">查看 / 重新报名</text>
          <text wx:else>填写报名表</text>
        </button>
      </view>

      <view
        wx:if="{{activity.actions && activity.actions.length}}"
        id="external-actions"
        class="external-participation"
      >
        <view class="external-participation__heading">
          <text wx:if="{{activity.registrationMode === 4}}" class="external-participation__title">后续参与步骤</text>
          <text wx:else class="external-participation__title">外部参与方式</text>
          <text wx:if="{{activity.registrationMode === 4}}" class="external-participation__hint">
            平台表单提交后仍需按下列说明完成外部步骤
          </text>
        </view>
        <view class="event-action" wx:for="{{activity.actions}}" wx:key="key">
          <view class="event-action__heading">
            <text class="event-action__title">{{item.label}}</text>
            <text class="event-action__type">{{item.typeLabel}}{{item.isRequired ? ' · 必经步骤' : ''}}</text>
          </view>
          <text class="event-body" wx:if="{{item.description}}" user-select>{{item.description}}</text>
          <image
            wx:if="{{item.actionType === 5 && item.attachmentUrl}}"
            class="join-qrcode"
            src="{{item.attachmentUrl}}"
            mode="aspectFit"
            show-menu-by-longpress="{{true}}"
            bindtap="onOpenAttachment"
            data-index="{{item.attachmentIndex}}"
          />
          <text class="event-body" wx:if="{{item.targetValue}}" user-select>{{item.targetValue}}</text>
          <button
            wx:if="{{item.targetValue}}"
            class="event-action__button"
            bindtap="onCopy"
            data-text="{{item.targetValue}}"
            data-label="{{item.typeLabel}}"
          >
            {{item.actionType === 1 ? '复制网页链接' : '复制' + item.typeLabel}}
          </button>
          <button
            wx:if="{{item.actionType !== 5 && item.attachmentIndex >= 0}}"
            class="event-action__button"
            bindtap="onOpenAttachment"
            data-index="{{item.attachmentIndex}}"
          >
            查看{{item.label}}
          </button>
          <text
            class="section-disclaimer"
            wx:if="{{(item.actionType === 5 || item.actionType === 6) && !item.attachmentUrl}}"
            >附件暂不可用，请联系活动方确认</text
          >
        </view>
      </view>

      <view
        wx:if="{{activity.registrationMode === 3 && (!activity.actions || !activity.actions.length)}}"
        class="participation-empty"
      >
        暂未提供可用的外部参与入口，请联系活动方确认。
      </view>

      <view class="join-body">
        <image
          wx:if="{{activity.qrcode_url}}"
          class="join-qrcode"
          src="{{activity.qrcode_url}}"
          mode="aspectFit"
          show-menu-by-longpress="{{true}}"
          bindtap="onPreviewQRCode"
        />

        <text class="join-desc" wx:if="{{activity.join_method}}" user-select>{{activity.join_method}}</text>
      </view>
    </view>

    <!-- 联系人 -->
    <view class="section-card" wx:if="{{activity.contacts && activity.contacts.length}}">
      <view class="section-title-row">
        <view class="section-title-icon icon-slot"><ui-icon name="contact" size="xl" /></view>
        <text class="section-title">联系人</text>
      </view>
      <view class="contact-list">
        <view wx:for="{{activity.contacts}}" wx:key="name" class="contact-item">
          <view class="contact-left">
            <text class="contact-avatar">{{item.name[0]}}</text>
            <view class="contact-info">
              <view class="contact-name-row">
                <text class="contact-name">{{item.name}}</text>
                <text class="contact-role" wx:if="{{item.role}}">{{item.role}}</text>
              </view>
              <text class="contact-phone" wx:if="{{item.phone}}">{{item.phone}}</text>
              <text class="contact-qq" wx:if="{{item.qq}}">QQ：{{item.qq}}</text>
              <text class="contact-qq" wx:if="{{item.email}}">邮箱：{{item.email}}</text>
              <text class="attachment-note" wx:if="{{item.note}}">{{item.note}}</text>
            </view>
          </view>
          <view class="contact-actions">
            <view
              class="contact-btn"
              bindtap="onCopy"
              data-text="{{item.phone}}"
              data-label="手机号"
              wx:if="{{item.phone}}"
              aria-role="button"
              aria-label="复制手机号"
            >
              <text class="contact-btn__text">复制</text>
            </view>
            <view class="contact-btn" bindtap="onCopy" data-text="{{item.qq}}" data-label="QQ号" wx:if="{{item.qq}}">
              <text class="contact-btn__text">复制QQ</text>
            </view>
            <view
              class="contact-btn"
              bindtap="onCopy"
              data-text="{{item.email}}"
              data-label="邮箱"
              wx:if="{{item.email}}"
              ><text class="contact-btn__text">复制邮箱</text></view
            >
          </view>
        </view>
      </view>
    </view>

    <!-- 附件 -->
    <view class="section-card" wx:if="{{activity.attachments && activity.attachments.length}}">
      <view class="section-title-row">
        <view class="section-title-icon icon-slot"><ui-icon name="attachment" size="xl" /></view>
        <text class="section-title">相关文件</text>
      </view>
      <text class="section-disclaimer">活动提供的附件，可点击查看</text>
      <view class="attachment-list">
        <view
          wx:for="{{activity.attachments}}"
          wx:key="name"
          class="attachment-item"
          bindtap="onOpenAttachment"
          data-index="{{index}}"
        >
          <view class="attachment-icon-img icon-slot"><ui-icon name="file" size="xl" /></view>
          <view class="attachment-body">
            <text class="attachment-name">{{item.name}}</text>
            <text class="attachment-note" wx:if="{{item.note}}">{{item.note}}</text>
          </view>
          <text class="attachment-type-badge">{{item.type || '文件'}}</text>
          <ui-icon name="chevron-right" size="sm" />
        </view>
      </view>
    </view>

    <!-- 来源信息 -->
    <view class="source-card">
      <!-- <text class="source-item" wx:if="{{activity.source}}">文件编号：{{activity.source}}</text> -->
      <text class="source-item" wx:if="{{activity.organizer}}">发布方：{{activity.organizer}}</text>
      <text class="source-item" wx:if="{{activity.published_at}}">发布时间：{{activity.published_at}}</text>
    </view>

    <view class="bottom-safe" />

    <!-- 底部按钮栏 -->
    <view class="bottom-bar {{primaryAction ? '' : 'bottom-bar--secondary-only'}}">
      <button
        class="bottom-secondary subscription-btn"
        loading="{{subscriptionBusy}}"
        disabled="{{subscriptionBusy || (!activity.subscribed && !activity.canSubscribe)}}"
        bindtap="onToggleSubscription"
      >
        {{activity.subscribed ? '取消订阅' : (activity.canSubscribe ? '订阅活动' : '不可订阅')}}
      </button>
      <button class="bottom-secondary share-btn" bindtap="onShare">
        <ui-icon name="share" size="lg" />
        <text class="share-btn__text">分享</text>
      </button>
      <button
        wx:if="{{primaryAction}}"
        class="primary-action {{primaryAction.disabled ? 'primary-action--disabled' : ''}}"
        disabled="{{primaryAction.disabled}}"
        bindtap="onPrimaryAction"
      >
        {{primaryAction.label}}
      </button>
    </view>
  </block>
</view>

<page-container
  show="{{showPopup}}"
  position="bottom"
  round
  overlay="{{true}}"
  close-on-slide-down="{{false}}"
  z-index="999"
  bind:afterleave="onPopupAfterLeave"
  bind:clickoverlay="onOverlayTap"
>
  <!-- share弹窗 -->
  <share-panel
    wx:if="{{popupType==='share'}}"
    share-image-path="{{currentShareImage}}"
    status="{{shareStatus}}"
    bind:retry="onRetryShare"
    bind:previewerror="onSharePreviewError"
    bind:close="onShareClose"
  />
</page-container>

<canvas type="2d" id="posterCanvas" style="position: fixed; left: -9999px; top: -9999px"></canvas>

<in-app-banner />
