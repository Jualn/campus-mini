<view class="filter-root">
  <view wx:if="{{openKey}}" class="filter-backdrop" catchtap="close" catchtouchmove="noop" />
  <view class="filter-controls">
    <button class="filter-trigger {{openKey === 'status' ? 'filter-trigger--open' : ''}}" data-key="status" bindtap="onToggle" aria-label="活动状态：{{statuses[statusIndex].label}}" aria-expanded="{{openKey === 'status'}}">
      <text class="filter-trigger__caption">状态</text>
      <view class="filter-trigger__value"><text>{{statuses[statusIndex].label}}</text><view class="filter-chevron" /></view>
    </button>
    <button class="filter-trigger {{categoryIndex ? 'filter-trigger--selected' : ''}} {{openKey === 'category' ? 'filter-trigger--open' : ''}}" data-key="category" bindtap="onToggle" aria-label="活动分类：{{categories[categoryIndex].label}}" aria-expanded="{{openKey === 'category'}}">
      <text class="filter-trigger__caption">分类</text>
      <view class="filter-trigger__value"><text>{{categories[categoryIndex].label}}</text><view class="filter-chevron" /></view>
    </button>
    <button class="filter-trigger {{scopeIndex ? 'filter-trigger--selected' : ''}} {{openKey === 'scope' ? 'filter-trigger--open' : ''}}" data-key="scope" bindtap="onToggle" aria-label="参与学科部：{{scopes[scopeIndex].label}}" aria-expanded="{{openKey === 'scope'}}">
      <text class="filter-trigger__caption">学科部</text>
      <view class="filter-trigger__value"><text>{{scopes[scopeIndex].label}}</text><view class="filter-chevron" /></view>
    </button>
  </view>
  <view wx:if="{{openKey}}" class="filter-panel" catchtouchmove="noop">
    <view class="filter-panel__header"><text class="filter-panel__title">{{panelTitle}}</text><button class="filter-panel__close" bindtap="close" aria-label="收起筛选">收起</button></view>
    <view class="filter-options">
      <button wx:for="{{panelOptions}}" wx:key="id" class="filter-option {{selectedIndex === index ? 'filter-option--selected' : ''}}" data-index="{{index}}" bindtap="onSelect" aria-label="{{item.label}}{{selectedIndex === index ? '，已选中' : ''}}">
        <text class="filter-option__label">{{item.label}}</text><text wx:if="{{selectedIndex === index}}" class="filter-option__check">✓</text>
      </button>
    </view>
  </view>
</view>
