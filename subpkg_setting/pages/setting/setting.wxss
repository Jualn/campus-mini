/* subpkg_setting/pages/setting/index.wxss */

page { background: var(--color-bg-page); }

.setting-page {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* =====================================================
   顶部导航
   ===================================================== */
.top-bar {
  background: var(--color-bg-card);
  padding: 0 24rpx 0;
  box-shadow: 0 1rpx 0 var(--color-border-light);
  position: sticky;
  top: 0;
  z-index: 10;
}

.top-bar__nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.top-bar__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3f6fa;
  border: none;
  box-shadow: none;
}


.top-bar__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.top-bar__placeholder { width: 72rpx; }

/* =====================================================
   Setting Body
   ===================================================== */
.setting-body {
  padding: 24rpx 20rpx 0;
}

.section-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  padding: 0 8rpx 12rpx;
  font-weight: 500;
}

.preference-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
}

.preference-state--unavailable,
.preference-state--error {
  border-color: rgba(154, 101, 0, 0.2);
  background: rgba(255, 247, 230, 0.8);
}

.preference-state__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.preference-state__title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.preference-state__desc,
.setting-item__source {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-tertiary);
}

.preference-state__action {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-primary, #1876ff);
}

.notification-channel-note {
  margin: 0 8rpx 24rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-sm);
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--color-text-secondary);
  background: rgba(24, 118, 255, 0.06);
}

.setting-item__source {
  color: var(--color-warning, #9a6500);
}

/* =====================================================
   设置分组
   ===================================================== */
.setting-group {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 32rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  min-height: 104rpx;
}

.setting-item--pressed {
  background: var(--color-bg-page);
}

.setting-item__left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.setting-item__icon-img {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.setting-item__text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.setting-item__title {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.setting-item__desc {
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

.setting-item__desc--available { color: var(--color-success, #2d8a52); }
.setting-item__desc--partial { color: var(--color-warning, #9a6500); }
.setting-item__desc--unavailable,
.setting-item__desc--unknown { color: var(--color-text-tertiary); }

.setting-item__right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.setting-item__value {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.setting-item__status {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg-page);
}

.setting-item__status--enabled {
  color: var(--color-success, #2d8a52);
  background: rgba(45, 138, 82, 0.1);
}

.setting-item__arrow {
  font-size: 36rpx;
  color: var(--color-text-tertiary);
}

.setting-switch { flex-shrink: 0; }

/* 开关 + 保存状态指示 */
.switch-wrap {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.switch-spinner {
  position: absolute;
  right: -6rpx;
  top: -6rpx;
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid var(--color-border-light);
  border-top-color: #007AFF;
  border-radius: 50%;
  pointer-events: none;
  animation: switch-spin 0.6s linear infinite;
}

.switch-error-dot {
  position: absolute;
  right: -4rpx;
  top: -4rpx;
  width: 16rpx;
  height: 16rpx;
  background: var(--color-error, #FF3B30);
  border-radius: 50%;
  pointer-events: none;
}

.action-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid var(--color-border-light);
  border-top-color: #007AFF;
  border-radius: 50%;
  animation: switch-spin 0.6s linear infinite;
}

@keyframes switch-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.setting-divider {
  height: 1rpx;
  background: var(--color-border-light);
  margin: 0 28rpx;
}

/* =====================================================
   退出登录
   ===================================================== */
.logout-btn {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.logout-btn__text {
  font-size: 30rpx;
  color: var(--color-danger);
  font-weight: 600;
}

.bottom-safe { height: 60rpx; }

.setting-item__icon-wrap {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: #f3f6fa;
  display: flex;
  align-items: center;
  justify-content: center;
}
