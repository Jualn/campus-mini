/* subpkg_setting/pages/setting/index.wxss */

page { background: #F4F5F7; }

.setting-page {
  min-height: 100vh;
  background: #F4F5F7;
}

/* =====================================================
   顶部导航
   ===================================================== */
.top-bar {
  background: #fff;
  padding: 0 24rpx 0;
  box-shadow: 0 1rpx 0 #F1F2F6;
}

.top-bar__nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.top-bar__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-bar__back-icon {
  font-size: 52rpx;
  color: #1a1a1a;
  font-weight: 300;
  line-height: 1;
}

.top-bar__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.top-bar__placeholder { width: 72rpx; }

/* =====================================================
   Setting Body
   ===================================================== */
.setting-body {
  padding: 24rpx 20rpx 0;
}

.section-label {
  font-size: 24rpx;
  color: #999;
  padding: 0 8rpx 12rpx;
  font-weight: 500;
}

/* =====================================================
   设置分组
   ===================================================== */
.setting-group {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  min-height: 104rpx;
}

.setting-item__left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.setting-item__icon { font-size: 36rpx; flex-shrink: 0; }

.setting-item__text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.setting-item__title {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.setting-item__title--danger { color: #FF3B30; }

.setting-item__desc {
  font-size: 23rpx;
  color: #999;
}

.setting-item__right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.setting-item__value {
  font-size: 28rpx;
  color: #999;
}

.setting-item__arrow {
  font-size: 36rpx;
  color: #C7C7CC;
}

.setting-switch { flex-shrink: 0; }

.setting-divider {
  height: 1rpx;
  background: #F5F5F5;
  margin: 0 28rpx;
}

/* =====================================================
   退出登录
   ===================================================== */
.logout-btn {
  background: #fff;
  border-radius: 20rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.logout-btn__text {
  font-size: 30rpx;
  color: #FF3B30;
  font-weight: 600;
}

.bottom-safe { height: 60rpx; }
