/* subpkg_setting/pages/setting/index.wxss */

page { background: var(--color-bg-page); }

.setting-page {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* =====================================================
   顶部导航
   ===================================================== */
.top-bar {
  background: var(--color-bg-card);
  padding: 0 24rpx 0;
  box-shadow: 0 1rpx 0 var(--color-border-light);
}

.top-bar__nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.top-bar__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-bar__back-icon {
  font-size: 52rpx;
  color: var(--color-text-primary);
  font-weight: 300;
  line-height: 1;
}

.top-bar__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.top-bar__placeholder { width: 72rpx; }

/* =====================================================
   Setting Body
   ===================================================== */
.setting-body {
  padding: 24rpx 20rpx 0;
}

.section-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  padding: 0 8rpx 12rpx;
  font-weight: 500;
}

/* =====================================================
   设置分组
   ===================================================== */
.setting-group {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 32rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  min-height: 104rpx;
}

.setting-item__left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.setting-item__icon { font-size: 36rpx; flex-shrink: 0; }

.setting-item__text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.setting-item__title {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.setting-item__title--danger { color: var(--color-danger); }

.setting-item__desc {
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

.setting-item__right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.setting-item__value {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.setting-item__arrow {
  font-size: 36rpx;
  color: var(--color-text-tertiary);
}

.setting-switch { flex-shrink: 0; }

.setting-divider {
  height: 1rpx;
  background: var(--color-border-light);
  margin: 0 28rpx;
}

/* =====================================================
   退出登录
   ===================================================== */
.logout-btn {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.logout-btn__text {
  font-size: 30rpx;
  color: var(--color-danger);
  font-weight: 600;
}

.bottom-safe { height: 60rpx; }
