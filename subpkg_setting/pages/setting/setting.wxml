<!-- subpkg_setting/pages/setting/index.wxml -->
<view class="setting-page">

  <page-navigation title="设置" fixed auto-back="{{false}}" bind:back="onBack" />

  <view class="setting-body">

    <view class="notification-channel-note">
      <text>选择愿意接收的消息。微信订阅会在相关业务操作时申请，不保证每条提醒都能送达。</text>
    </view>
    <view wx:if="{{preferenceState !== 'ready'}}" class="preference-state">
      <text class="preference-state__title">{{preferenceState === 'loading' ? '正在加载通知设置' : preferenceState === 'signed-out' ? '请先登录后设置通知' : '通知设置暂不可用'}}</text>
      <button wx:if="{{preferenceState === 'error'}}" class="notification-action" size="mini" bindtap="onRetryNotificationPreferences">重试</button>
    </view>
    <view wx:if="{{wechatMainSwitch === 'off' || rememberedRejection}}" class="preference-state">
      <text class="setting-item__desc">微信提醒已关闭或有订阅被拒绝，可去微信设置调整。</text>
      <button class="notification-action" size="mini" bindtap="onOpenSubscriptionSettings" disabled="{{subscriptionSettingsPending}}">去设置</button>
    </view>
    <block wx:for="{{groups}}" wx:for-item="group" wx:key="category">
      <view class="section-label">{{group.label}}</view>
      <view class="setting-group">
        <block wx:for="{{group.rows}}" wx:key="key">
          <view class="setting-item">
            <view class="setting-item__text">
              <text class="setting-item__title">{{item.channelLabel}}</text>
              <text wx:if="{{item.capabilityText}}" class="setting-item__desc">{{item.capabilityText}}</text>
            </view>
            <switch class="setting-switch" checked="{{item.enabled}}"
              disabled="{{preferenceState !== 'ready' || preferenceSavingKey !== ''}}"
              bindchange="onNotificationPreferenceChange" data-key="{{item.key}}"
              aria-label="{{group.label}}，{{item.channelLabel}}" color="#007AFF" />
          </view>
          <view wx:if="{{index === 0}}" class="setting-divider" />
        </block>
      </view>
    </block>

