<!-- subpkg_setting/pages/setting/index.wxml -->
<view class="setting-page">

  <!-- 顶部导航 -->
  <view class="top-bar" style="padding-top:{{statusBarHeight}}px;">
    <view class="top-bar__nav">
      <view class="top-bar__back" bindtap="onBack" aria-role="button" aria-label="返回">
        <ui-icon name="chevron-left" size="lg" />
      </view>
      <text class="top-bar__title">设置</text>
      <view class="top-bar__placeholder" />
    </view>
  </view>

  <view class="setting-body">

    <view
      wx:if="{{preferenceState !== 'ready'}}"
      class="preference-state preference-state--{{preferenceState}}"
      bindtap="onRetryNotificationPreferences"
      aria-role="button"
      aria-label="{{preferenceStateTitle}}。{{preferenceStateDesc}}。点击重试"
    >
      <view class="preference-state__body">
        <text class="preference-state__title">{{preferenceStateTitle}}</text>
        <text wx:if="{{preferenceStateDesc}}" class="preference-state__desc">{{preferenceStateDesc}}</text>
      </view>
      <text wx:if="{{preferenceState !== 'loading'}}" class="preference-state__action">重试</text>
    </view>

    <view class="notification-channel-note">
      <text>站内消息由应用控制；服务号通知还需在微信侧完成绑定和订阅。</text>
    </view>

    <view class="section-label">活动通知</view>
    <view wx:if="{{activityPreferenceRows.length}}" class="setting-group">
      <block wx:for="{{activityPreferenceRows}}" wx:key="key">
        <view class="setting-item">
          <view class="setting-item__left">
            <view class="setting-item__icon-wrap"><image class="setting-item__icon-img" src="{{item.channel === 'WECHAT_OFFICIAL_ACCOUNT' ? '../../assets/icons/setting/service_account.svg' : '../../assets/icons/setting/in_app.svg'}}" mode="aspectFit" /></view>
            <view class="setting-item__text">
              <text class="setting-item__title">{{item.channelLabel}}</text>
              <text class="setting-item__desc setting-item__desc--{{item.capabilityTone}}">{{item.capabilityText}}</text>
              <text wx:if="{{item.legacyMigration}}" class="setting-item__source">沿用旧设置，不代表微信已授权</text>
            </view>
          </view>
          <view class="switch-wrap">
            <switch
              class="setting-switch"
              checked="{{item.enabled}}"
              disabled="{{preferenceState !== 'ready' || preferenceSavingKey !== ''}}"
              bindchange="onNotificationPreferenceChange"
              data-key="{{item.key}}"
              data-category="{{item.category}}"
              data-channel="{{item.channel}}"
              color="#007AFF"
            />
            <view wx:if="{{preferenceSavingKey === item.key}}" class="switch-spinner"></view>
          </view>
        </view>
        <view wx:if="{{index < activityPreferenceRows.length - 1}}" class="setting-divider" />
      </block>
    </view>

    <view class="section-label">公共事项通知</view>
    <view wx:if="{{publicEventPreferenceRows.length}}" class="setting-group">
      <block wx:for="{{publicEventPreferenceRows}}" wx:key="key">
        <view class="setting-item">
          <view class="setting-item__left">
            <view class="setting-item__icon-wrap"><image class="setting-item__icon-img" src="{{item.channel === 'WECHAT_OFFICIAL_ACCOUNT' ? '../../assets/icons/setting/service_account.svg' : '../../assets/icons/setting/in_app.svg'}}" mode="aspectFit" /></view>
            <view class="setting-item__text">
              <text class="setting-item__title">{{item.channelLabel}}</text>
              <text class="setting-item__desc setting-item__desc--{{item.capabilityTone}}">{{item.capabilityText}}</text>
              <text wx:if="{{item.legacyMigration}}" class="setting-item__source">沿用旧设置，不代表微信已授权</text>
            </view>
          </view>
          <view class="switch-wrap">
            <switch
              class="setting-switch"
              checked="{{item.enabled}}"
              disabled="{{preferenceState !== 'ready' || preferenceSavingKey !== ''}}"
              bindchange="onNotificationPreferenceChange"
              data-key="{{item.key}}"
              data-category="{{item.category}}"
              data-channel="{{item.channel}}"
              color="#007AFF"
            />
            <view wx:if="{{preferenceSavingKey === item.key}}" class="switch-spinner"></view>
          </view>
        </view>
        <view wx:if="{{index < publicEventPreferenceRows.length - 1}}" class="setting-divider" />
      </block>
    </view>

    <view class="section-label">其他通知</view>
    <view class="setting-group">
      <view class="setting-item">
        <view class="setting-item__left">
          <view class="setting-item__icon-wrap"><image class="setting-item__icon-img" src="../../assets/icons/setting/interaction_message.svg" mode="aspectFit" /></view>
          <view class="setting-item__text">
            <text class="setting-item__title">互动消息</text>
            <text class="setting-item__desc">点赞、评论和回复通知</text>
          </view>
        </view>
        <view class="switch-wrap">
          <switch class="setting-switch" checked="{{legacyNotify.interaction}}" disabled="{{legacyNotifyPending.interaction}}"
            bindchange="onLegacyNotifyChange" data-key="interaction" color="#007AFF" />
          <view wx:if="{{legacyNotifyPending.interaction}}" class="switch-spinner"></view>
          <view wx:if="{{legacyNotifyError.interaction}}" class="switch-error-dot"></view>
        </view>
      </view>
      <view class="setting-divider" />
      <view class="setting-item">
        <view class="setting-item__left">
          <view class="setting-item__icon-wrap"><image class="setting-item__icon-img" src="../../assets/icons/setting/system_announcement.svg" mode="aspectFit" /></view>
          <view class="setting-item__text">
            <text class="setting-item__title">系统公告</text>
            <text class="setting-item__desc">平台通知、功能更新</text>
          </view>
        </view>
        <view class="switch-wrap">
          <switch class="setting-switch" checked="{{legacyNotify.system}}" disabled="{{legacyNotifyPending.system}}"
            bindchange="onLegacyNotifyChange" data-key="system" color="#007AFF" />
          <view wx:if="{{legacyNotifyPending.system}}" class="switch-spinner"></view>
          <view wx:if="{{legacyNotifyError.system}}" class="switch-error-dot"></view>
        </view>
      </view>
      <view class="setting-divider" />
      <view class="setting-item" bindtap="bindMp">
        <view class="setting-item__left">
          <view class="setting-item__icon-wrap"><image class="setting-item__icon-img" src="../../assets/icons/setting/bind_service_account.svg" mode="aspectFit" /></view>
          <view class="setting-item__text">
            <text class="setting-item__title">绑定服务号</text>
            <text class="setting-item__desc">绑定后，还需在服务号菜单单独开启通知</text>
          </view>
        </view>
        <ui-icon name="chevron-right" size="sm" />
      </view>
    </view>

