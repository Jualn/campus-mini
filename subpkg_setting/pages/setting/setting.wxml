<!-- subpkg_setting/pages/setting/index.wxml -->
<view class="setting-page">

  <!-- 顶部导航 -->
  <view class="top-bar" style="padding-top:{{statusBarHeight}}px;">
    <view class="top-bar__nav">
      <view class="top-bar__back" bindtap="onBack">
        <text class="top-bar__back-icon">‹</text>
      </view>
      <text class="top-bar__title">设置</text>
      <view class="top-bar__placeholder" />
    </view>
  </view>

  <view class="setting-body">

    <!-- ===== 通知设置 ===== -->
    <view class="section-label">通知设置</view>
    <view class="setting-group">

      <view class="setting-item">
        <view class="setting-item__left">
          <image class="setting-item__icon-img" src="/images/icons/setting/activity_reminder.svg" mode="aspectFit" />
          <view class="setting-item__text">
            <text class="setting-item__title">活动提醒</text>
            <text class="setting-item__desc">报名截止、活动开始前提醒</text>
          </view>
        </view>

        <view class="switch-wrap">
          <switch class="setting-switch" checked="{{notify.activity}}" disabled="{{notifyPending.activity}}"
            bindchange="onNotifyChange" data-key="activity" color="#007AFF" />
          <view wx:if="{{notifyPending.activity}}" class="switch-spinner"></view>
          <view wx:if="{{notifyError.activity}}" class="switch-error-dot"></view>
        </view>
      </view>
      <view class="setting-divider" />

      <!-- <view class="setting-item">
        <view class="setting-item__left">
          <text class="setting-item__icon">📖</text>
          <view class="setting-item__text">
            <text class="setting-item__title">考试提醒</text>
            <text class="setting-item__desc">报名开始、考试倒计时提醒</text>
          </view>
        </view>
        <switch class="setting-switch" checked="{{notify.exam}}" bindchange="onNotifyChange" data-key="exam"
          color="#007AFF" />
      </view>
      <view class="setting-divider" /> -->

      <view class="setting-item">
        <view class="setting-item__left">
          <image class="setting-item__icon-img" src="/images/icons/setting/interaction_message.svg" mode="aspectFit" />
          <view class="setting-item__text">
            <text class="setting-item__title">互动消息</text>
            <text class="setting-item__desc">点赞、评论、关注通知</text>
          </view>
        </view>

        <view class="switch-wrap">
          <switch class="setting-switch" checked="{{notify.interaction}}" disabled="{{notifyPending.interaction}}"
            bindchange="onNotifyChange" data-key="interaction" color="#007AFF" />
          <view wx:if="{{notifyPending.interaction}}" class="switch-spinner"></view>
          <view wx:if="{{notifyError.interaction}}" class="switch-error-dot"></view>
        </view>
      </view>
      <view class="setting-divider" />

      <view class="setting-item">
        <view class="setting-item__left">
          <image class="setting-item__icon-img" src="/images/icons/setting/system_announcement.svg" mode="aspectFit" />
          <view class="setting-item__text">
            <text class="setting-item__title">系统公告</text>
            <text class="setting-item__desc">平台通知、功能更新</text>
          </view>
        </view>

        <view class="switch-wrap">
          <switch class="setting-switch" checked="{{notify.system}}" disabled="{{notifyPending.system}}"
            bindchange="onNotifyChange" data-key="system" color="#007AFF" />
          <view wx:if="{{notifyPending.system}}" class="switch-spinner"></view>
          <view wx:if="{{notifyError.system}}" class="switch-error-dot"></view>
        </view>
      </view>
      <view class="setting-divider" />

      <view class="setting-item" bindtap="bindMp">
        <view class="setting-item__left">
          <image class="setting-item__icon-img" src="/images/icons/setting/bind_service_account.svg" mode="aspectFit" />
          <view class="setting-item__text">
            <text class="setting-item__title">绑定服务号</text>
            <text class="setting-item__desc">推送通知到服务号</text>
          </view>
        </view>
        <text class="setting-item__arrow">›</text>
      </view>
    </view>

    <!-- ===== 隐私设置 ===== -->
    <!-- <view class="section-label">隐私设置</view>
