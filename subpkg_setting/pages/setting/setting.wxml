    <!-- ===== 账号与安全 ===== -->
    <view class="section-label">账号与安全</view>
    <view class="setting-group">

      <view class="setting-item" bindtap="onGoEditProfile">
        <view class="setting-item__left">
          <image class="setting-item__icon-img" src="/images/icons/setting/edit_profile.svg" mode="aspectFit" />
          <view class="setting-item__text">
            <text class="setting-item__title">编辑资料</text>
          </view>
        </view>
        <text class="setting-item__arrow">›</text>
      </view>
      <view class="setting-divider" />

      <!-- <view class="setting-item" bindtap="onGoBindPhone">
        <view class="setting-item__left">
          <text class="setting-item__icon">📱</text>
          <view class="setting-item__text">
            <text class="setting-item__title">绑定手机号</text>
          </view>
        </view>
        <view class="setting-item__right">
          <text class="setting-item__value">{{account.phone || '未绑定'}}</text>
          <text class="setting-item__arrow">›</text>
        </view>
      </view>
      <view class="setting-divider" /> -->

    </view>

    <!-- ===== 关于与反馈 ===== -->
    <view class="section-label">关于与反馈</view>
    <view class="setting-group">

      <view class="setting-item" bindtap="onGoFeedback">
        <view class="setting-item__left">
          <image class="setting-item__icon-img" src="/images/icons/setting/feedback.svg" mode="aspectFit" />
          <view class="setting-item__text">
            <text class="setting-item__title">意见反馈</text>
          </view>
        </view>
        <text class="setting-item__arrow">›</text>
      </view>
      <view class="setting-divider" />

      <view class="setting-item" bindtap="onGoAgreement">
        <view class="setting-item__left">
          <image class="setting-item__icon-img" src="/images/icons/setting/user_agreement.svg" mode="aspectFit" />
          <view class="setting-item__text">
            <text class="setting-item__title">用户协议</text>
          </view>
        </view>
        <text class="setting-item__arrow">›</text>
      </view>
      <view class="setting-divider" />

      <view class="setting-item" bindtap="onGoPrivacyPolicy">
        <view class="setting-item__left">
          <image class="setting-item__icon-img" src="/images/icons/setting/privacy_policy.svg" mode="aspectFit" />
          <view class="setting-item__text">
            <text class="setting-item__title">隐私政策</text>
          </view>
        </view>
        <text class="setting-item__arrow">›</text>
      </view>
      <view class="setting-divider" />

      <view class="setting-item">
        <view class="setting-item__left">
          <image class="setting-item__icon-img" src="/images/icons/setting/app_version.svg" mode="aspectFit" />
          <view class="setting-item__text">
            <text class="setting-item__title">当前版本</text>
          </view>
        </view>
        <view class="setting-item__right">
          <text class="setting-item__value">v{{version}}</text>
        </view>
      </view>

    </view>

    <!-- 退出登录 -->
    <!-- <view class="logout-btn" bindtap="onLogout">
      <text class="logout-btn__text">退出登录</text>
    </view> -->

    <view class="bottom-safe" />

  </view>

</view>

<in-app-banner />