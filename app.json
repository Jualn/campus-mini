{
  "pages": [
    "pages/index/index",
    "pages/me/me",
    "pages/message/message",
    "pages/test/test"
  ],
  "subPackages": [
    {
      "root": "subpkg_exam",
      "pages": ["pages/detail/detail", "pages/list/list"]
    },
    {
      "root": "subpkg_activity",
      "pages": [
        "pages/detail/detail",
        "pages/list/list",
        "pages/publish/publish"
      ]
    },
    {
      "root": "subpkg_community",
      "pages": [
        "pages/detail/detail",
        "pages/post-edit/post-edit",
        "pages/search/search",
        "pages/search-result/search-result"
      ]
    },
    {
      "root": "subpkg_user",
      "pages": ["pages/user/user", "pages/edit-profile/edit-profile"]
    },
    {
      "root": "subpkg_setting",
      "pages": ["pages/setting/setting","pages/service-subscribe-webview/index"]
    },
    {
      "root": "subpkg_red",
      "pages": [
        "pages/index/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["subpkg_community"]
    }
  },
  "usingComponents": {
    "in-app-banner": "/components/in-app-banner/index"
  },
  "window": {
    "navigationBarTextStyle": "black",
    "navigationStyle": "custom"
  },
  "lazyCodeLoading": "requiredComponents",
  "tabBar": {
    "custom": true,
    "color": "#9EAFC2",
    "selectedColor": "#1677FF",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/index/index"
      },
      {
        "pagePath": "pages/message/message"
      },
      {
        "pagePath": "pages/me/me"
      }
    ]
  }
}
