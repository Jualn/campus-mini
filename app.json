{
  "pages": [
    "pages/index/index",
    "pages/me/me",
    "pages/message/message",
    "pages/campus/campus"
  ],
  "subPackages": [
    {
      "root": "subpkg_public_event",
      "pages": ["pages/detail/detail", "pages/list/list"]
    },
    {
      "root": "subpkg_activity",
      "pages": [
        "pages/detail/detail",
        "pages/list/list",
        "pages/registration/registration",
        "pages/my-registrations/list"
      ]
    },
    {
      "root": "subpkg_community",
      "pages": [
        "pages/detail/detail",
        "pages/post-edit/post-edit",
        "pages/search/search",
        "pages/search-result/search-result",
        "pages/post-list/list",
        "pages/my-community/list",
        "pages/my-community/detail"
      ]
    },
    {
      "root": "subpkg_user",
      "pages": [
        "pages/user/user",
        "pages/edit-profile/edit-profile",
        "pages/learning-task-list/list",
        "pages/growth-list/list",
        "pages/growth-detail/detail",
        "pages/growth-edit/edit",
        "pages/learning-task-detail/detail",
        "pages/party-identity/index",
        "pages/person-points/index",
        "pages/points-apply/index",
        "pages/points-applications/index",
        "pages/points-application/index"
      ]
    },
    {
      "root": "subpkg_setting",
      "pages": [
        "pages/setting/setting",
        "pages/service-subscribe-webview/index",
        "pages/admin-login-confirm/index"
      ]
    },
    {
      "root": "subpkg_red",
      "pages": [
        "pages/index/index",
        "pages/content-list/list",
        "pages/content-detail/detail",
        "pages/article-list/list",
        "pages/article-detail/detail",
        "pages/article-favorites/list"
      ]
    }
  ],
  "preloadRule": {
    "pages/campus/campus": {
      "network": "all",
      "packages": ["subpkg_community"]
    }
  },
  "usingComponents": {
    "in-app-banner": "/components/in-app-banner/index"
  },
  "window": {
    "navigationBarTextStyle": "black",
    "navigationStyle": "custom"
  },
  "lazyCodeLoading": "requiredComponents",
  "tabBar": {
    "custom": true,
    "color": "#65758F",
    "selectedColor": "#C43B4A",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/index/index"
      },
      {
        "pagePath": "pages/campus/campus"
      },
      {
        "pagePath": "pages/message/message"
      },
      {
        "pagePath": "pages/me/me"
      }
    ]
  }
}
