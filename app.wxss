/* app.wxss
   全局样式 —— 所有页面自动继承
   原则：reset 抹平系统差异 → 变量统一设计 token → 工具类按需使用
*/

/* ============================================================
   1. RESET — 抹平 iOS / 安卓默认样式差异
   ============================================================ */
page,
view,
text,
image,
input,
textarea,
button,
scroll-view,
swiper,
swiper-item {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

page {
  min-height: 100vh;
  font-size: 30rpx;
  line-height: 1.6;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Noto Sans CJK SC",
    "Source Han Sans SC", Arial, sans-serif;
  color: var(--color-text-primary);
  background: var(--color-bg-page);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
}

/* 不要在全局强制 image 宽高，否则 SVG、小图标、头像容易被拉伸 */
image {
  display: block;
}

/* button 组件重置 */
button {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  margin: 0;
  font-size: inherit;
  font-family: inherit;
  color: inherit;
  line-height: inherit;
  text-align: inherit;
  -webkit-tap-highlight-color: transparent;
}

button::after {
  border: none;
}

input,
textarea {
  -webkit-appearance: none;
  appearance: none;
  outline: none;
  border: none;
  background: transparent;
  font-size: var(--font-md);
  line-height: 1.4;
  color: var(--color-text-primary);
  caret-color: var(--color-primary);
}

textarea {
  width: 100%;
  min-height: 120rpx;
}

scroll-view {
  -webkit-overflow-scrolling: touch;
}

/* ============================================================
   2. 设计 TOKEN — 全局视觉规范
   ============================================================ */
page {
  /* Brand 蓝色系 */
  --color-primary: #2f7cf6;
  --color-primary-hover: #256fe3;
  --color-primary-light: #eaf3ff;
  --color-primary-soft: rgba(47, 124, 246, 0.08);
  --color-primary-deep: #1558c8;

  --color-cyan: #55cfff;
  --color-blue-2: #4aa8ff;
  --color-blue-3: #7bb7ff;

  /* 文字：提高对比度，避免发灰 */
  --color-text-primary: #10233f;
  --color-text-secondary: rgba(16, 35, 63, 0.74);
  --color-text-tertiary: rgba(16, 35, 63, 0.52);
  --color-text-placeholder: rgba(16, 35, 63, 0.36);
  --color-text-inverse: #ffffff;

  /* 页面背景：保留蓝色感，但不要雾化 */
  --color-bg-page: #f4f8ff;
  --color-bg-page-deep: #eef5ff;
  --color-bg-card: #ffffff;
  --color-bg-input: #ffffff;

  /* 清晰版玻璃：大多数地方接近白底 */
  --glass-bg: rgba(255, 255, 255, 0.94);
  --glass-bg-strong: #ffffff;
  --glass-bg-soft: rgba(255, 255, 255, 0.9);
  --glass-border: rgba(47, 124, 246, 0.1);
  --glass-inner: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);

  /* 边框 */
  --color-border: rgba(47, 124, 246, 0.12);
  --color-border-light: rgba(47, 124, 246, 0.07);
  --color-border-grey: rgba(0, 0, 0, 0.08);
  --color-hairline: rgba(16, 35, 63, 0.07);

  /* 状态色 */
  --color-success: #20b76b;
  --color-warning: #ff9f2f;
  --color-danger: #ff4d4f;
  --color-purple: #6b7cff;

  /* 圆角 */
  --radius-xs: 10rpx;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 30rpx;
  --radius-xl: 38rpx;
  --radius-2xl: 46rpx;
  --radius-full: 999rpx;

  /* 字号 */
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-base: 26rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 38rpx;
  --font-2xl: 46rpx;

  /* 字重 */
  --weight-regular: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;
  --weight-heavy: 800;

  /* 间距 */
  --space-2xs: 6rpx;
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --space-2xl: 64rpx;
  --page-padding: 24rpx;

  --nav-height: 88rpx;
  --tabbar-height: 112rpx;

  /* 阴影：减弱，不要灰雾感 */
  --shadow-xs: 0 2rpx 8rpx rgba(47, 124, 246, 0.04);
  --shadow-sm: 0 6rpx 18rpx rgba(47, 124, 246, 0.06);
  --shadow-md: 0 10rpx 26rpx rgba(47, 124, 246, 0.08);
  --shadow-lg: 0 16rpx 38rpx rgba(47, 124, 246, 0.1);
  --shadow-card: 0 8rpx 24rpx rgba(47, 124, 246, 0.075);

  --transition-fast: 0.16s ease;
  --transition-normal: 0.22s ease;

  /* 骨架 */
  --skeleton-bg: #f2f3f5;
  --skeleton-highlight: rgba(255, 255, 255, 0.56);
  --skeleton-card-bg: var(--color-bg-card);
  --skeleton-radius-sm: 8rpx;
  --skeleton-radius-md: 16rpx;
  --skeleton-radius-lg: 24rpx;
  --skeleton-duration: 1.2s;
}

/* ============================================================
   2.1 全局背景 / 玻璃工具类
   ============================================================ */

.g-page-blue {
  min-height: 100vh;
  background: linear-gradient(180deg, #f7fbff 0%, #eef5ff 52%, #f8fbff 100%);
}

.g-glass {
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--shadow-sm);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
}

.g-glass-strong {
  background: #ffffff;
  border: 1rpx solid var(--color-border-light);
  box-shadow: var(--shadow-card);
}

.g-glass-fallback {
  background: #ffffff;
  border: 1rpx solid var(--color-border-light);
  box-shadow: var(--shadow-card);
}

/* ============================================================
      3. 排版工具类
      ============================================================ */
.text-primary {
  color: var(--color-text-primary);
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-tertiary {
  color: var(--color-text-tertiary);
}

.text-brand {
  color: var(--color-primary);
}

.text-xs {
  font-size: var(--font-xs);
}

.text-sm {
  font-size: var(--font-sm);
}

.text-md {
  font-size: var(--font-md);
}

.text-lg {
  font-size: var(--font-lg);
}

.text-xl {
  font-size: var(--font-xl);
}

.text-2xl {
  font-size: var(--font-2xl);
}

.text-normal {
  font-weight: var(--weight-normal);
}

.text-bold {
  font-weight: var(--weight-bold);
}

.text-left {
  text-align: left;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ============================================================
      4. 布局工具类
      ============================================================ */
.flex {
  display: flex;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.items-center {
  align-items: center;
}

.items-start {
  align-items: flex-start;
}

.items-end {
  align-items: flex-end;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.justify-end {
  justify-content: flex-end;
}

.flex-1 {
  flex: 1;
}

.flex-wrap {
  flex-wrap: wrap;
}

.page-wrap {
  padding: var(--page-padding);
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ============================================================
      5. 通用组件样式
      ============================================================ */
.card {
  background: var(--glass-bg-strong);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--shadow-card), var(--glass-inner);
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
}

.divider {
  width: 100%;
  height: 1rpx;
  background: var(--color-hairline);
}

.divider-light {
  width: 100%;
  height: 1rpx;
  background: var(--color-border-light);
}

/* 通用输入容器 */
.input-base {
  width: 100%;
  min-height: 76rpx;
  background: var(--glass-bg-soft);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-md);
  padding: 18rpx 24rpx;
  color: var(--color-text-primary);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
  transition:
    border-color var(--transition-fast),
    background-color var(--transition-fast),
    box-shadow var(--transition-fast);
}

.input-base.focus {
  border-color: rgba(47, 124, 246, 0.28);
  background: rgba(255, 255, 255, 0.86);
  box-shadow:
    0 8rpx 24rpx rgba(47, 124, 246, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
}

/* 通用按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  padding: 20rpx 30rpx;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  line-height: 1.2;
  transition:
    transform var(--transition-fast),
    opacity var(--transition-fast),
    background-color var(--transition-fast);
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-blue-2) 100%);
  color: var(--color-text-inverse);
  box-shadow:
    0 12rpx 28rpx rgba(47, 124, 246, 0.26),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.36);
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.btn-ghost {
  background: rgba(47, 124, 246, 0.09);
  color: var(--color-primary);
  border: 1rpx solid rgba(47, 124, 246, 0.1);
}

.btn-ghost:active {
  opacity: 0.82;
  transform: scale(0.98);
}

/* 通用点击反馈类（给 view 用） */
.tap-active {
  transition:
    opacity var(--transition-fast),
    transform var(--transition-fast);
}

.tap-active:active {
  opacity: 0.86;
  transform: scale(0.985);
}

/* 禁用态 */
.is-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ============================================================
   6. 暗色模式预留
   说明：
   目前项目主视觉是浅蓝玻璃风，不建议直接跟随系统暗色自动反色。
   等所有页面都完成暗色适配后，再开启完整 dark token。
   ============================================================ */
@media (prefers-color-scheme: dark) {
  page {
    /* 暂时保持浅色体系，避免安卓 / iOS 自动暗色下局部页面割裂 */
    --color-bg-page: #f3f8ff;
    --color-bg-page-deep: #eef6ff;
    --color-bg-card: #ffffff;

    --color-text-primary: #102a4c;
    --color-text-secondary: rgba(31, 55, 87, 0.72);
    --color-text-tertiary: rgba(68, 93, 128, 0.48);
  }
}

/* ============================================================
   7. 页面与布局助手
   ============================================================ */

/* 整页容器 */
.pg-container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

.pg-container--white {
  background: var(--color-bg-card);
}

/* 标准顶部导航条 */
.std-topbar {
  position: relative;
  z-index: 10;
  background: rgba(246, 250, 255, 0.78);
  padding: 0 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 10rpx 32rpx rgba(47, 124, 246, 0.08);
  -webkit-backdrop-filter: blur(24px);
  backdrop-filter: blur(24px);
}

.std-topbar__nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--nav-height);
}

.std-topbar__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.66);
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 8rpx 22rpx rgba(47, 124, 246, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.std-topbar__back-icon {
  font-size: 46rpx;
  color: var(--color-primary);
  font-weight: 300;
  line-height: 1;
  margin-top: -6rpx;
}

.std-topbar__title {
  max-width: 420rpx;
  font-size: 32rpx;
  font-weight: var(--weight-heavy);
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 1rpx;
}

.std-topbar__placeholder {
  width: 64rpx;
  height: 64rpx;
}

/* Section 标题行 */
.section-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md) var(--page-padding);
}

.section-hd__title {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.section-hd__more {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* 空态（通用） */
.empty-state {
  margin: 80rpx 24rpx 0;
  padding: 76rpx 40rpx;
  border-radius: var(--radius-xl);
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--shadow-card), var(--glass-inner);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
}

.empty-state__icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.28) 46%),
    linear-gradient(135deg, rgba(47, 124, 246, 0.15), rgba(85, 207, 255, 0.12));
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    0 14rpx 32rpx rgba(47, 124, 246, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: var(--weight-heavy);
  color: var(--color-text-primary);
}

.empty-state__desc {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  text-align: center;
  line-height: 1.65;
}

/* 列表底部 */
.g-list-footer {
  padding: 48rpx 0 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.g-list-footer__text {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  text-align: center;
}

/* 安全距离 */
.safe-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}

.safe-bottom-lg {
  height: calc(120rpx + constant(safe-area-inset-bottom));
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.safe-page-bottom {
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 红点/角标 */
.g-badge {
  background: var(--color-danger);
  border-radius: var(--radius-full);
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.g-badge__text {
  font-size: 18rpx;
  font-weight: var(--weight-bold);
  color: var(--color-text-inverse);
  line-height: 1;
}

/* 通用搜索框 */
.g-search-box {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-full);
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  box-shadow:
    0 12rpx 32rpx rgba(47, 124, 246, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.94);
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
  overflow: hidden;
}

.g-search-box::before {
  content: "";
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 4rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.g-search-box__icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  opacity: 0.82;
}

.g-search-box__placeholder {
  position: relative;
  z-index: 1;
  font-size: var(--font-md);
  color: var(--color-text-placeholder);
}

/* 胶囊分类 Tab */
.g-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 62rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.56);
  border: 1rpx solid rgba(255, 255, 255, 0.84);
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow:
    0 8rpx 24rpx rgba(47, 124, 246, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
}

.g-tab--active {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-blue-2) 100%);
  border-color: rgba(255, 255, 255, 0.48);
  box-shadow:
    0 12rpx 28rpx rgba(47, 124, 246, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.38);
}

.g-tab__label {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}

.g-tab--active .g-tab__label {
  color: var(--color-text-inverse);
  font-weight: var(--weight-bold);
}

/* ============================================================
   8. 状态标签
   ============================================================ */
.g-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  line-height: 1;
}

.g-status--primary {
  color: var(--color-primary);
  background: rgba(47, 124, 246, 0.1);
}

.g-status--success {
  color: var(--color-success);
  background: rgba(32, 183, 107, 0.11);
}

.g-status--warning {
  color: var(--color-warning);
  background: rgba(255, 159, 47, 0.12);
}

.g-status--danger {
  color: var(--color-danger);
  background: rgba(255, 77, 79, 0.1);
}

.g-status--muted {
  color: var(--color-text-tertiary);
  background: rgba(68, 93, 128, 0.08);
}

/* ============================================================
   9. 图标容器
   ============================================================ */
.g-icon-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  background: rgba(47, 124, 246, 0.09);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.g-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
  flex-shrink: 0;
}
