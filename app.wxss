/* app.wxss
   全局样式 —— 所有页面自动继承
   原则：reset 抹平系统差异 → 变量统一设计 token → 工具类按需使用
*/

/* ============================================================
   1. RESET — 抹平 iOS / 安卓默认样式差异
   ============================================================ */
page,
view,
text,
image,
input,
textarea,
button,
scroll-view,
swiper,
swiper-item {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

page {
  font-size: 30rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Noto Sans CJK SC",
    "Source Han Sans SC", sans-serif;
  color: #1a1a1a;
  background-color: #f4f6f9;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* button 组件重置 */
button {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  font-size: inherit;
  font-family: inherit;
  color: inherit;
  line-height: inherit;
  -webkit-tap-highlight-color: transparent;
}

button::after {
  border: none;
}

image {
  display: block;
  width: 100%;
  height: auto;
}

input,
textarea {
  -webkit-appearance: none;
  outline: none;
  font-size: var(--font-md);
  line-height: 1.4;
  color: var(--color-text-primary);
}


/* ============================================================
      2. 设计 TOKEN — CSS 变量，改一处全局生效
      ============================================================ */
page {
  /* 主色 */
  --color-primary: #1677ff;
  --color-primary-light: #e8f1ff;
  --color-primary-dark: #0958d9;

  /* 文字 */
  --color-text-primary: #1a1a1a;
  --color-text-secondary: #666666;
  --color-text-tertiary: #999999;
  --color-text-inverse: #ffffff;

  /* 背景 */
  --color-bg-page: #f4f6f9;
  --color-bg-card: #ffffff;
  --color-bg-input: #f0f2f5;

  /* 边框 */
  --color-border: rgba(0, 0, 0, 0.08);
  --color-border-light: rgba(0, 0, 0, 0.04);

  /* 状态色 */
  --color-success: #16a34a;
  --color-warning: #f59e0b;
  --color-danger: #ef4444;

  /* 圆角 */
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --radius-full: 999rpx;

  /* 字号 */
  --font-xs: 22rpx;
  --font-sm: 26rpx;
  --font-md: 30rpx;
  --font-lg: 34rpx;
  --font-xl: 40rpx;
  --font-2xl: 48rpx;

  /* 字重 */
  --weight-normal: 400;
  --weight-bold: 600;

  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --page-padding: 32rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
  --shadow-card: 0 2rpx 16rpx rgba(22, 119, 255, 0.06);

  /* 过渡 */
  --transition-fast: 0.18s ease;
}


/* ============================================================
      3. 排版工具类
      ============================================================ */
.text-primary {
  color: var(--color-text-primary);
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-tertiary {
  color: var(--color-text-tertiary);
}

.text-brand {
  color: var(--color-primary);
}

.text-xs {
  font-size: var(--font-xs);
}

.text-sm {
  font-size: var(--font-sm);
}

.text-md {
  font-size: var(--font-md);
}

.text-lg {
  font-size: var(--font-lg);
}

.text-xl {
  font-size: var(--font-xl);
}

.text-2xl {
  font-size: var(--font-2xl);
}

.text-normal {
  font-weight: var(--weight-normal);
}

.text-bold {
  font-weight: var(--weight-bold);
}

.text-left {
  text-align: left;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}


/* ============================================================
      4. 布局工具类
      ============================================================ */
.flex {
  display: flex;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.items-center {
  align-items: center;
}

.items-start {
  align-items: flex-start;
}

.items-end {
  align-items: flex-end;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.justify-end {
  justify-content: flex-end;
}

.flex-1 {
  flex: 1;
}

.flex-wrap {
  flex-wrap: wrap;
}

.page-wrap {
  padding: var(--page-padding);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}


/* ============================================================
      5. 通用组件样式
      ============================================================ */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--shadow-card);
}

.divider {
  width: 100%;
  height: 1rpx;
  background: var(--color-border);
}

.divider-light {
  width: 100%;
  height: 1rpx;
  background: var(--color-border-light);
}

/* 通用输入容器 */
.input-base {
  width: 100%;
  background: var(--color-bg-input);
  border: 1rpx solid transparent;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  transition: border-color var(--transition-fast), background-color var(--transition-fast);
}

.input-base.focus {
  border-color: var(--color-primary);
  background: #fff;
}

/* 通用按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  padding: 20rpx 28rpx;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  transition: transform var(--transition-fast), opacity var(--transition-fast), background-color var(--transition-fast);
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.btn-primary:active {
  background: var(--color-primary-dark);
  transform: scale(0.98);
}

.btn-ghost {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.btn-ghost:active {
  opacity: 0.85;
}

/* 通用点击反馈类（给 view 用） */
.tap-active {
  transition: opacity var(--transition-fast), transform var(--transition-fast);
}

.tap-active:active {
  opacity: 0.85;
  transform: scale(0.99);
}

/* 禁用态 */
.is-disabled {
  opacity: 0.5;
  pointer-events: none;
}


/* ============================================================
   6. 暗色模式预留（可按需启用）
   ============================================================ */
/* 小程序支持时可逐步启用，先保留变量映射 */
@media (prefers-color-scheme: dark) {
  page {
    --color-bg-page: #0f1115;
    --color-bg-card: #171a21;
    --color-bg-input: #1f2430;

    --color-text-primary: #f3f4f6;
    --color-text-secondary: #c0c4cc;
    --color-text-tertiary: #8b93a1;

    --color-border: rgba(255, 255, 255, 0.12);
    --color-border-light: rgba(255, 255, 255, 0.08);

    --shadow-card: none;
  }
}


/* ============================================================
   7. 页面与布局助手
   ============================================================ */

/* 整页容器 */
.pg-container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

.pg-container--white {
  background: var(--color-bg-card);
}

/* 标准顶部导航条 */
.std-topbar {
  background: var(--color-bg-card);
  padding: 0 24rpx;
  box-shadow: 0 1rpx 0 var(--color-border-light);
}

.std-topbar__nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.std-topbar__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.std-topbar__back-icon {
  font-size: 52rpx;
  color: var(--color-text-primary);
  font-weight: 300;
  line-height: 1;
}

.std-topbar__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}

.std-topbar__placeholder {
  width: 72rpx;
}

/* Section 标题行 */
.section-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md) var(--page-padding);
}

.section-hd__title {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.section-hd__more {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* 空态（通用） */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
  gap: 20rpx;
}

.empty-state__icon {
  font-size: 80rpx;
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.empty-state__desc {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  text-align: center;
  line-height: 1.6;
}

/* 列表底部 */
.g-list-footer {
  padding: 48rpx 0 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.g-list-footer__text {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  text-align: center;
}

/* 安全距离 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
}

.safe-bottom-lg {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

/* 红点/角标 */
.g-badge {
  background: var(--color-danger);
  border-radius: var(--radius-full);
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.g-badge__text {
  font-size: 18rpx;
  font-weight: var(--weight-bold);
  color: var(--color-text-inverse);
  line-height: 1;
}

/* 通用搜索框 */
.g-search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--color-bg-input);
  border-radius: var(--radius-full);
  padding: 0 28rpx;
  height: 76rpx;
}

.g-search-box__icon {
  font-size: 28rpx;
}

.g-search-box__placeholder {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

/* 胶囊分类 Tab */
.g-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.g-tab--active {
  background: var(--color-text-primary);
}

.g-tab__label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.g-tab--active .g-tab__label {
  color: var(--color-text-inverse);
  font-weight: var(--weight-bold);
}