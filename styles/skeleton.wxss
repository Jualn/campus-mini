/*
 * 项目级骨架 primitive。
 *
 * 这里只维护颜色、圆角和动画，不放任何页面布局。页面骨架应尽量贴近
 * 真实内容的轮廓，列表/个人主页等重复结构再抽成业务骨架组件。
 * 变量统一定义在 app.wxss，避免 import 后覆盖全局主题。
 */

.skeleton-block {
  position: relative;
  overflow: hidden;
  background-image: linear-gradient(
    100deg,
    var(--skeleton-bg) 20%,
    var(--skeleton-highlight) 38%,
    var(--skeleton-bg) 56%
  );
  background-size: 220% 100%;
  animation: skeleton-shimmer var(--skeleton-duration) linear infinite;
}

.skeleton-circle {
  border-radius: 50%;
}

.skeleton-radius-sm {
  border-radius: var(--skeleton-radius-sm);
}

.skeleton-radius-md {
  border-radius: var(--skeleton-radius-md);
}

.skeleton-radius-lg {
  border-radius: var(--skeleton-radius-lg);
}

.skeleton-pill {
  border-radius: var(--radius-full);
}

.skeleton-card {
  background: var(--skeleton-card-bg);
  border: 1rpx solid var(--color-border-light);
  box-shadow: var(--shadow-xs);
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 120% 0;
  }

  100% {
    background-position: -120% 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton-block {
    animation: none;
    background: var(--skeleton-bg);
  }
}
