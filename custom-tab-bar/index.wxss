/* custom-tab-bar/index.wxss */

/* ===================== 外层定位容器 ===================== */
.tab-bar-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  padding-bottom: calc(20rpx + 16px);
  padding-bottom: calc(constant(safe-area-inset-bottom) + 16px);
  padding-bottom: calc(env(safe-area-inset-bottom) + 16px);
  pointer-events: none;
  z-index: 800;
}

/* ===================== 胶囊主体 ===================== */
.tab-bar {
  pointer-events: auto;
  display: flex;
  align-items: center;
  padding: 10rpx 14rpx;
  border-radius: 100rpx;

  /* 安卓基础背景 */
  background: rgba(255, 255, 255, 0.85);
  /* iOS 毛玻璃，安卓静默降级 */
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);

  border: 1rpx solid var(--color-border);
  box-shadow:
    0 8rpx 40rpx rgba(22, 119, 255, 0.12),
    0 2rpx 10rpx rgba(0, 0, 0, 0.06);

  transform: translateY(0);
  transition: transform 0.35s cubic-bezier(0.23, 1, 0.32, 1);
}

.tab-bar--hidden {
  transform: translateY(calc(100% + 140rpx));
}

/* ===================== 单个 Tab 项 ===================== */
.tab-item {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-width: 120rpx;
  height: 104rpx;
  border-radius: 80rpx;
  transition: background 0.25s ease;
}

.tab-item--active {
  background: var(--color-primary-light);
}

/* ===================== 图标容器 ===================== */
.tab-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-item--active .tab-icon {
  transform: none;
}

/* ===================== 徽标 ===================== */
.badge {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  background: var(--color-danger);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--color-bg-card);
  box-shadow: 0 2rpx 6rpx rgba(255, 59, 48, 0.4);
}

.badge-text {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--color-text-inverse);
  line-height: 1;
}

/* ===================== 文字标签 ===================== */
.tab-label {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--color-text-tertiary);
  line-height: 1;
  letter-spacing: 0.02em;
  transition: color 0.2s ease;
}

.tab-label--active {
  color: var(--color-primary);
  font-weight: 600;
}