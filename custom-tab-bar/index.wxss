/* Liquid Glass Lite：仅优化官方 custom-tab-bar 视觉，不更改路由或事件链。 */
/* 悬浮定位：延续原项目安全区规则；外层不拦截页面触摸。 */
.tab-bar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 800;
  display: flex;
  justify-content: center;
  padding-bottom: calc(20rpx + 18px);
  padding-bottom: calc(constant(safe-area-inset-bottom) + 18px);
  padding-bottom: calc(env(safe-area-inset-bottom) + 18px);
  pointer-events: none;
}

/* 主玻璃：高透渐变为稳定回退，模糊仅在支持环境中增强。 */
.tab-bar {
  pointer-events: auto;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 677rpx;
  max-width: calc(100% - 50rpx);
  height: 115rpx;
  padding: 0 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.84);
  border-radius: 999rpx;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 252, 0.94) 0%,
    rgba(248, 251, 255, 0.88) 52%,
    rgba(235, 244, 252, 0.82) 100%
  );
  -webkit-backdrop-filter: blur(10px) saturate(145%);
  backdrop-filter: blur(10px) saturate(145%);
  box-shadow:
    inset 0 1rpx 1rpx rgba(255, 255, 255, 0.92),
    0 16rpx 48rpx rgba(77, 105, 139, 0.12),
    0 4rpx 14rpx rgba(99, 125, 153, 0.06);
  transform: translateY(0);
  transition: transform 330ms cubic-bezier(0.2, 0.85, 0.25, 1);
}

.tab-bar--hidden {
  transform: translateY(calc(100% + 140rpx));
}

/* 真实可点击的四个 Tab：不覆盖透明触摸层。 */
.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  height: 90rpx;
  /* border: 1rpx solid transparent; */
  border-radius: 999rpx;
  background: transparent;
  transition:
    transform 160ms ease,
    box-shadow 200ms ease,
    border-color 200ms ease;
}

.tab-item--active {
  border-color: rgba(255, 255, 255, 0.58);
  background: radial-gradient(
    ellipse at center,
    rgba(252, 228, 232, 0.98) 0%,
    rgba(252, 235, 237, 0.9) 58%,
    rgba(255, 245, 246, 0.52) 100%
  );
  box-shadow:
    /* inset 0 1rpx 1rpx rgba(255, 255, 255, 0.88), */
    0 4rpx 16rpx rgba(196, 59, 74, 0.09);
}

.tab-item--pressed {
  transform: scale(0.94);
}

.tab-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
  transition: transform 200ms cubic-bezier(0.2, 0.8, 0.25, 1);
}

.tab-item--pressed .tab-icon-wrap {
  transform: scale(0.94);
}

.tab-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.15;
  color: #65758f;
  letter-spacing: 0.3rpx;
  transition: color 180ms ease;
}

.tab-label--active {
  color: #c43b4a;
  font-weight: 600;
}

/* 未读角标：保留原 TS 的消息数更新和 99+ 行为。 */
.badge {
  position: absolute;
  top: -9rpx;
  right: -20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 7rpx;
  border: 3rpx solid #ffffff;
  border-radius: 28rpx;
  background: #c43b4a;
  box-shadow: 0 3rpx 8rpx rgba(196, 59, 74, 0.25);
}

.badge-text {
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
  color: #ffffff;
}
