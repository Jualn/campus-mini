<!-- 保留微信原生 custom-tab-bar 和原有点击/未读逻辑；只更新视觉层。 -->
<view class="tab-bar-wrap">
  <view class="tab-bar {{isTabBarVisible ? '' : 'tab-bar--hidden'}}">
    <block wx:for="{{tabList}}" wx:key="url">
      <view
        class="tab-item {{index === selected ? 'tab-item--active' : ''}}"
        data-index="{{index}}"
        bindtap="handleTabTap"
        hover-class="tab-item--pressed"
        hover-start-time="10"
        hover-stay-time="70"
        aria-label="{{item.text}}"
      >
        <view class="tab-icon-wrap">
          <ui-icon
            class="tab-icon"
            name="{{item.iconName}}"
            state="{{index === selected ? 'active' : 'default'}}"
            size="lg"
          />
          <view wx:if="{{item.badge > 0}}" class="badge">
            <text class="badge-text">{{item.badge > 99 ? '99+' : item.badge}}</text>
          </view>
        </view>
        <text class="tab-label {{index === selected ? 'tab-label--active' : ''}}">{{item.text}}</text>
      </view>
    </block>
  </view>
</view>
