.growth-detail-page {
  min-height: 100vh;
  padding-bottom: calc(var(--space-xl) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
}

.detail-notice {
  margin: var(--space-md) 32rpx;
  padding: 20rpx var(--space-md);
  border-left: 6rpx solid var(--color-primary);
  background: var(--color-primary-tint);
  color: var(--color-primary-deep);
  font-size: var(--font-base);
  line-height: 1.65;
}

.record-sheet {
  background: var(--color-bg-card);
}

.record-heading {
  padding-bottom: var(--space-lg);
}

.record-type-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  padding: 28rpx 32rpx 0;
}

.record-type {
  color: var(--color-primary-deep);
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
}

.record-type--birthday {
  color: var(--color-brand-red-deep);
}

.record-date {
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
}

.record-title {
  display: block;
  margin: var(--space-md) 32rpx 0;
  color: var(--color-text-primary);
  font-size: 42rpx;
  font-weight: var(--weight-semibold);
  line-height: 1.45;
  overflow-wrap: break-word;
}

.record-author {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin: 32rpx 32rpx 0;
}

.record-author__icon {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}

.record-author__copy {
  display: flex;
  min-width: 0;
  align-items: center;
}

.record-author__name {
  color: var(--color-text-secondary);
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
}

.record-statuses {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs) var(--space-md);
  margin: var(--space-md) 32rpx 0;
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
}

.record-status--safety {
  padding-left: var(--space-md);
  border-left: 1rpx solid var(--color-border);
}

.record-content {
  padding: 40rpx 32rpx;
  border-top: 1rpx solid var(--color-border-light);
  color: var(--color-text-primary);
  font-size: 34rpx;
  line-height: 2;
  overflow-wrap: break-word;
  white-space: pre-wrap;
}

.record-media {
  padding: var(--space-lg) 32rpx;
  border-top: 1rpx solid var(--color-border-light);
  background: var(--color-bg-page);
}

.record-media__heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.record-media__title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
}

.record-media__count {
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
}

.media-card {
  display: flex;
  width: 100%;
  min-height: 120rpx;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
  border-top: 1rpx solid var(--color-border);
  text-align: left;
}

.media-card__icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
}

.media-card__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--space-2xs);
  min-width: 0;
}

.media-card__name {
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: var(--font-base);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-card__hint {
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
}

.media-card__action {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: var(--space-2xs);
  color: var(--color-primary);
  font-size: var(--font-sm);
}

.media-reading {
  padding: var(--space-md) 0 0;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  text-align: center;
}

.record-video {
  width: 100%;
  height: 422rpx;
  margin-top: var(--space-md);
  border-radius: var(--radius-sm);
  background: #000000;
}

.reading-links {
  padding: 0 32rpx;
  border-top: 8rpx solid var(--color-bg-page);
  border-bottom: 1rpx solid var(--color-border-light);
  background: var(--color-bg-card);
}

.reading-link {
  display: flex;
  width: 100%;
  min-height: 120rpx;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
}

.reading-link + .reading-link {
  border-top: 1rpx solid var(--color-border-light);
}

.reading-link__icon {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}

.reading-link__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--space-2xs);
  min-width: 0;
  text-align: left;
}

.reading-link__title {
  color: var(--color-text-primary);
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
}

.reading-link__description {
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
}

.record-actions {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  padding: var(--space-sm) var(--space-md);
  border-bottom: 8rpx solid var(--color-bg-page);
  background: var(--color-bg-card);
}

.record-action {
  display: flex;
  min-width: 104rpx;
  min-height: 104rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  padding: var(--space-sm) var(--space-xs);
  color: var(--color-text-secondary);
}

.record-action--selected {
  color: var(--color-brand-red-deep);
}

.record-action__label,
.record-action__count {
  font-size: var(--font-sm);
}

.record-action__count {
  color: var(--color-text-tertiary);
}

.discussion-section {
  background: var(--color-bg-card);
}

button[disabled] {
  opacity: 0.45;
}

@media (max-width: 340px) {
  .record-title {
    font-size: 40rpx;
  }

  .record-action {
    min-width: 88rpx;
    gap: var(--space-2xs);
  }

  .record-action__label,
  .record-action__count {
    font-size: var(--font-xs);
  }
}
