.growth-edit-page {
  min-height: 100vh;
  padding-bottom: calc(var(--space-lg) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
}

.form-notice,
.recovery-panel {
  margin: var(--space-md) 32rpx 0;
  padding: 20rpx var(--space-md);
  border-left: 4rpx solid var(--color-primary);
  background: var(--color-primary-tint);
  color: var(--color-primary-deep);
  font-size: var(--font-base);
  line-height: 1.65;
}

.form-notice--warning,
.recovery-panel {
  border-left-color: var(--color-warning);
  background: rgba(255, 159, 47, 0.1);
  color: #925609;
}

.form-notice--success {
  border-left-color: var(--color-success);
  background: rgba(32, 183, 107, 0.09);
  color: #147847;
}

.context-section,
.title-area,
.content-area,
.media-area {
  margin: 0 32rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.context-section {
  padding: var(--space-md) 0 var(--space-sm);
}

.context-section__heading,
.media-area__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
}

.select-field {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
}

.select-field + picker,
picker + picker {
  border-top: 1rpx solid var(--color-border-light);
}

.select-field--locked .select-field__value {
  color: var(--color-text-secondary);
}

.select-field__label {
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-base);
}

.select-field__value-wrap {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-sm);
  min-width: 0;
}

.select-field__value {
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.select-field__value--placeholder {
  color: var(--color-text-placeholder);
  font-weight: var(--weight-regular);
}

.select-field__value--birthday {
  color: var(--color-brand-red-deep);
}

.select-field__locked {
  flex-shrink: 0;
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
}

.select-field ui-icon {
  flex-shrink: 0;
  transform: rotate(90deg);
}

.context-note {
  display: block;
  padding: var(--space-xs) 0;
  color: var(--color-brand-red-deep);
  font-size: var(--font-sm);
  line-height: 1.6;
}

.title-area {
  padding: var(--space-md) 0 0;
}

.content-area {
  padding: var(--space-md) 0 var(--space-sm);
}

.field__label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.field__label {
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  font-weight: var(--weight-regular);
}

.field__optional,
.field__count {
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
  font-weight: var(--weight-regular);
}

.field__input {
  width: 100%;
  min-height: 104rpx;
  padding: var(--space-xs) 0;
  font-size: 36rpx;
  font-weight: var(--weight-medium);
  line-height: 1.5;
}

.field__textarea {
  width: 100%;
  min-height: 300rpx;
  padding: var(--space-md) 0;
  font-size: 32rpx;
  line-height: 1.85;
}

.field__placeholder {
  color: var(--color-text-placeholder);
  font-weight: var(--weight-regular);
}

.field__count {
  display: block;
  text-align: right;
}

.media-area {
  padding: var(--space-md) 0 var(--space-lg);
}

.media-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}

.media-action {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  border-radius: var(--radius-xs);
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
  font-size: var(--font-base);
}

.media-action[disabled] {
  opacity: 0.42;
}

.selection-status {
  margin-top: var(--space-sm);
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.media-list {
  margin-top: var(--space-sm);
}

.media-item {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
}

.media-item + .media-item {
  border-top: 1rpx solid var(--color-border-light);
}

.media-item__icon,
.media-item__preview {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: var(--radius-xs);
  background: var(--color-bg-page);
}

.media-item__preview image {
  width: 100%;
  height: 100%;
}

.media-item__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--space-2xs);
  min-width: 0;
}

.media-item__name {
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: var(--font-base);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-item__status {
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
}

.media-item__remove {
  display: flex;
  min-width: 88rpx;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  color: var(--color-danger);
  font-size: var(--font-sm);
}

.upload-status {
  margin-top: var(--space-md);
  padding: var(--space-md);
  background: var(--color-primary-tint);
  color: var(--color-primary-deep);
  font-size: var(--font-sm);
}

.upload-status__row {
  display: flex;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.recovery-panel {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.recovery-panel__title {
  font-weight: var(--weight-semibold);
}

.remote-version {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin: var(--space-md) 32rpx;
  padding: var(--space-md) 0;
  border-top: 1rpx solid rgba(255, 159, 47, 0.35);
  border-bottom: 1rpx solid rgba(255, 159, 47, 0.35);
}

.remote-version__label {
  color: #925609;
  font-size: var(--font-sm);
}

.remote-version__title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
}

.remote-version__content {
  color: var(--color-text-secondary);
  font-size: var(--font-base);
  line-height: 1.75;
  white-space: pre-wrap;
}

.version-button {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: var(--space-md) 32rpx;
  border: 1rpx solid rgba(255, 159, 47, 0.4);
  border-radius: var(--radius-sm);
  color: #8a5109;
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
}

.submit-area {
  padding: var(--space-lg) 32rpx var(--space-md);
}

.submit-button {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  background: var(--color-brand-red);
  color: var(--color-text-inverse);
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
}

.submit-button[disabled] {
  background: #e2e6ed;
  color: var(--color-text-tertiary);
  opacity: 1;
}

.saved-link {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin-top: var(--space-sm);
  color: var(--color-primary);
  font-size: var(--font-base);
}

button[disabled] {
  opacity: 0.45;
}
