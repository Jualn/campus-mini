<view class="page">
  <load-state
    wx:if="{{loading}}"
    mode="loading"
    title="正在读取学习任务"
    description="正在同步任务要求与最新学习进度"
    fill-viewport
  />
  <load-state
    wx:elif="{{error && !detail}}"
    mode="error"
    title="暂时无法读取任务"
    description="{{error}}"
    action-text="重新读取"
    bind:action="refresh"
    fill-viewport
  />

  <block wx:elif="{{detail}}">
    <view class="task-hero">
      <view class="task-hero__top">
        <view class="subject-badge">
          <ui-icon name="home-tasks" size="sm" />
          <text>{{detail.assignment.subject.type === 'PERSON' ? '人员学习任务' : '账号学习任务'}}</text>
        </view>
        <text class="g-status g-status--{{view.statusTone}}">{{view.statusLabel}}</text>
      </view>
      <text class="task-hero__title">{{detail.task.title}}</text>
      <text class="task-hero__lifecycle">{{view.lifecycle}}{{detail.assignment.subject.type === 'PERSON' ? ' · 按当前关联档案访问' : ''}}</text>

      <view class="hero-deadline">
        <view class="hero-deadline__icon"><ui-icon name="calendar-event" size="md" /></view>
        <view class="hero-deadline__copy">
          <text class="hero-deadline__label">{{detail.assignment.progress === 'REJECTED' && detail.assignment.supplementDeadline ? '补交截止' : '首次截止'}}</text>
          <text class="hero-deadline__value">{{view.deadlineText}}</text>
        </view>
      </view>

      <text class="task-hero__description" selectable>{{detail.task.description}}</text>
      <view wx:if="{{detail.task.cancellationReason}}" class="hero-reason">取消原因：{{detail.task.cancellationReason}}</view>
      <view wx:if="{{detail.assignment.revocationReason}}" class="hero-reason">撤销原因：{{detail.assignment.revocationReason}}</view>
    </view>

    <load-state
      wx:if="{{error}}"
      mode="error"
      variant="inline"
      description="{{error}}"
      action-text="重新查询进度"
      bind:action="refresh"
    />

    <view wx:if="{{latest || latestError}}" class="surface-card review-card review-card--{{latest.reviewTone || 'muted'}}">
      <view class="section-header">
        <view class="section-header__copy">
          <text class="section-kicker">审核反馈</text>
          <text class="section-title">当前提交结果</text>
        </view>
        <text wx:if="{{latest}}" class="g-status g-status--{{latest.reviewTone}}">{{latest.reviewLabel}}</text>
      </view>
      <block wx:if="{{latest}}">
        <text class="review-card__attempt">第 {{latest.attempt}} 次提交</text>
        <view wx:if="{{latest.reviewReason}}" class="review-reason">
          <text class="review-reason__label">{{latest.reviewStatus === 'REJECTED' ? '驳回原因' : '审核意见'}}</text>
          <text class="review-reason__text" selectable>{{latest.reviewReason}}</text>
        </view>
        <text wx:if="{{latest.reviewedAt}}" class="meta-text">审核时间：{{latest.reviewedAtText}}</text>
      </block>
      <load-state
        wx:if="{{latestError}}"
        mode="error"
        variant="inline"
        description="{{latestError}}"
        action-text="重新读取"
        bind:action="retryLatest"
      />
    </view>

    <view wx:if="{{unresolved}}" class="notice-card notice-card--warning">
      <text class="notice-card__mark">!</text>
      <view class="notice-card__body">
        <text class="notice-card__title">上次操作结果尚未确认</text>
        <text class="notice-card__text">核实会继续查询上次提交，不会创建重复成果。</text>
        <button class="secondary-button secondary-button--warning" bindtap="submit" loading="{{submitting || uploading}}" disabled="{{submitting || loading}}">核实原操作结果</button>
      </view>
    </view>

    <view wx:if="{{feedback}}" class="notice-card notice-card--{{feedbackTone}}">
      <text class="notice-card__mark">{{feedbackTone === 'success' ? '✓' : feedbackTone === 'warning' ? '!' : 'i'}}</text>
      <view class="notice-card__body">
        <text class="notice-card__title">{{feedbackTone === 'success' ? '状态已更新' : feedbackTone === 'warning' ? '请检查当前操作' : '操作提示'}}</text>
        <text class="notice-card__text">{{feedback}}</text>
      </view>
    </view>

    <view class="surface-card">
      <view class="section-header">
        <view class="section-header__copy">
          <text class="section-kicker">学习要求</text>
          <text class="section-title">完成本次任务需要</text>
        </view>
        <view class="section-icon"><ui-icon name="checklist" size="lg" /></view>
      </view>

      <view class="requirement-list">
        <view class="requirement-row">
          <text class="requirement-row__label">学习确认</text>
          <text class="requirement-row__value">{{detail.task.requirements.confirmationRequired ? '需主动确认已完成学习' : '无需额外确认'}}</text>
        </view>
        <view class="requirement-row">
          <text class="requirement-row__label">学习心得</text>
          <text class="requirement-row__value">{{detail.task.requirements.minimumTextLength > 0 ? '至少 ' + detail.task.requirements.minimumTextLength + ' 字' : '不强制填写'}}</text>
        </view>
        <view class="requirement-row">
          <text class="requirement-row__label">成果附件</text>
          <text class="requirement-row__value">{{detail.task.requirements.maximumFiles > 0 ? detail.task.requirements.minimumFiles + '–' + detail.task.requirements.maximumFiles + ' 个 · ' + view.fileKindsLabel : '无需提交附件'}}</text>
        </view>
        <view class="requirement-row">
          <text class="requirement-row__label">审核方式</text>
          <text class="requirement-row__value">{{detail.task.reviewRequired ? '提交后需审核通过' : '无需人工审核'}}</text>
        </view>
      </view>

      <view wx:if="{{view.windowClosed}}" class="inline-warning">当前提交窗口已截止；待审核记录保留，最终状态请刷新读取。</view>
      <view wx:if="{{detail.assignment.supplementDeadline}}" class="fact-row">
        <text class="fact-row__label">固定补交截止</text>
        <text class="fact-row__value">{{view.supplementDeadlineText}}</text>
      </view>
      <view wx:if="{{detail.assignment.confirmedAt}}" class="fact-row">
        <text class="fact-row__label">首次确认</text>
        <text class="fact-row__value">{{view.confirmedAtText}}</text>
      </view>
      <view wx:if="{{detail.assignment.completedAt}}" class="fact-row">
        <text class="fact-row__label">完成时间</text>
        <text class="fact-row__value">{{view.completedAtText}}</text>
      </view>

      <view class="article-panel">
        <view class="article-panel__copy">
          <text class="article-panel__title">关联学习材料</text>
          <text class="article-panel__text">{{detail.task.article.availability === 'AVAILABLE' ? '阅读文章不会自动完成任务，请返回后按要求确认。' : detail.task.article ? '关联文章暂不可阅读，任务进度仍独立保留。' : '本任务未关联文章，请按任务说明学习。'}}</text>
        </view>
        <button wx:if="{{detail.task.article.availability === 'AVAILABLE'}}" class="article-button" bindtap="openArticle" hover-class="article-button--hover">
          <text>阅读文章</text>
          <ui-icon name="chevron-right" size="sm" />
        </button>
      </view>
    </view>

    <view wx:if="{{view.canAct && !unresolved}}" class="surface-card form-card">
      <view class="section-header">
        <view class="section-header__copy">
          <text class="section-kicker">成果提交</text>
          <text class="section-title">{{detail.assignment.progress === 'REJECTED' ? '补交学习成果' : '确认学习并提交成果'}}</text>
          <text class="section-subtitle">提交后可在下方查看审核进度与历史记录</text>
        </view>
      </view>

      <checkbox-group wx:if="{{detail.task.requirements.confirmationRequired}}" bindchange="toggleConfirm">
        <label class="confirmation-field">
          <checkbox value="confirmed" checked="{{confirmed}}" color="#2469BD" disabled="{{submitting || uploading}}" />
          <view class="confirmation-field__copy">
            <text class="confirmation-field__title">我确认已完成本次学习</text>
            <text class="confirmation-field__text">请根据实际完成情况主动勾选</text>
          </view>
        </label>
      </checkbox-group>

      <block wx:if="{{!view.pureConfirmation || text || files.length}}">
        <view class="field-block">
          <view class="field-label-row">
            <view class="field-label-row__left">
              <text class="field-label">学习心得</text>
              <text class="requirement-badge {{detail.task.requirements.minimumTextLength > 0 ? 'requirement-badge--required' : ''}}">{{detail.task.requirements.minimumTextLength > 0 ? '至少 ' + detail.task.requirements.minimumTextLength + ' 字' : '选填'}}</text>
            </view>
            <text class="character-count {{textCount > 10000 ? 'character-count--error' : ''}}">{{textCount}} / 10000</text>
          </view>
          <view class="textarea-shell">
            <textarea
              class="form-textarea"
              value="{{text}}"
              maxlength="-1"
              disabled="{{submitting || uploading}}"
              bindinput="input"
              placeholder="记录本次学习的收获、思考或实践成果…"
              placeholder-class="form-textarea__placeholder"
              auto-height
            />
          </view>
          <text class="field-help">字数按去除首尾空白后计算，最多 10000 字</text>
        </view>
      </block>

      <block wx:if="{{detail.task.requirements.maximumFiles > 0}}">
        <view class="field-block file-field">
          <view class="field-label-row">
            <view class="field-label-row__left">
              <text class="field-label">成果附件</text>
              <text class="requirement-badge {{detail.task.requirements.minimumFiles > 0 ? 'requirement-badge--required' : ''}}">{{detail.task.requirements.minimumFiles > 0 ? '至少 ' + detail.task.requirements.minimumFiles + ' 个' : '选填'}}</text>
            </view>
            <text class="field-counter">{{files.length}} / {{detail.task.requirements.maximumFiles}}</text>
          </view>
          <text class="field-help">支持{{view.fileKindsLabel}}；图片/文档 ≤10MiB，MP4 ≤200MiB</text>

          <view wx:if="{{files.length}}" class="file-list">
            <view wx:for="{{files}}" wx:key="path" class="file-item">
              <view class="file-item__icon"><ui-icon name="file" size="md" /></view>
              <view class="file-item__body">
                <text class="file-item__name">{{item.name}}</text>
                <text class="file-item__status {{item.status === '已登记' ? 'file-item__status--success' : ''}}">{{item.status}}{{item.status === '已登记' ? ' · 可用于提交' : ' · 上传登记后方可提交'}}</text>
              </view>
              <button class="file-item__remove" data-index="{{index}}" bindtap="removeFile" disabled="{{submitting || uploading}}" aria-label="移除附件{{item.name}}">
                <ui-icon name="close" size="sm" />
              </button>
            </view>
          </view>

          <view class="file-actions">
            <button class="secondary-button" bindtap="chooseFiles" loading="{{selecting}}" disabled="{{submitting || uploading || selecting || !versionReady || files.length >= detail.task.requirements.maximumFiles}}">
              {{files.length ? '继续选择' : '选择聊天文件'}}
            </button>
            <button class="secondary-button secondary-button--primary" bindtap="uploadFiles" loading="{{uploading}}" disabled="{{submitting || uploading || selecting || !versionReady || !files.length}}">上传并登记</button>
          </view>
          <view wx:if="{{uploading}}" class="upload-progress" aria-role="progressbar" aria-label="附件上传进度 {{uploadProgress}}%">
            <view class="upload-progress__heading"><text>正在上传附件</text><text>{{uploadProgress}}%</text></view>
            <view class="upload-progress__track"><view class="upload-progress__bar" style="width: {{uploadProgress}}%;" /></view>
          </view>
          <text class="field-help">登记成功后方可提交；候选到期需重新上传，正式成果保留旧文件。</text>
        </view>
      </block>

      <view wx:if="{{!versionReady}}" class="inline-warning">未取得最新任务版本，请刷新后操作。</view>
      <button
        class="primary-button"
        bindtap="submit"
        loading="{{submitting || uploading}}"
        disabled="{{submitting || uploading || selecting || !versionReady}}"
        hover-class="primary-button--hover"
      >{{view.pureConfirmation && !text && !files.length ? '确认完成学习' : detail.assignment.progress === 'REJECTED' ? '确认补交成果' : '提交学习成果'}}</button>
      <text class="submit-hint">最终学习进度以服务端审核与处理结果为准</text>
    </view>

    <view wx:elif="{{!unresolved}}" class="surface-card unavailable-card">
      <view class="unavailable-card__icon"><ui-icon name="checklist" size="xl" /></view>
      <text class="unavailable-card__title">当前无需提交</text>
      <text class="unavailable-card__text">暂无可执行的确认、提交或补交入口。审核和完成事实以服务端状态为准，可下拉刷新最新进度。</text>
    </view>

    <view wx:if="{{videoUrl}}" class="surface-card video-card">
      <view class="section-header">
        <view class="section-header__copy">
          <text class="section-kicker">私有附件</text>
          <text class="section-title">视频成果播放</text>
        </view>
      </view>
      <video class="video-player" src="{{videoUrl}}" controls binderror="videoError" />
      <button class="secondary-button video-card__close" bindtap="closeVideo">关闭播放</button>
    </view>

    <view class="surface-card history-card">
      <view class="section-header">
        <view class="section-header__copy">
          <text class="section-kicker">学习档案</text>
          <text class="section-title">历次成果与审核</text>
        </view>
        <text wx:if="{{history.length}}" class="history-card__count">{{history.length}} 条</text>
      </view>

      <view wx:for="{{history}}" wx:key="submissionId" wx:for-item="submission" class="submission">
        <view class="submission__header">
          <text class="submission__attempt">第 {{submission.attempt}} 次提交</text>
          <text class="g-status g-status--{{submission.reviewTone}}">{{submission.reviewLabel}}</text>
        </view>
        <text class="meta-text">提交时间：{{submission.submittedAtText}}</text>
        <text wx:if="{{submission.text}}" class="submission__text" selectable>{{submission.text}}</text>
        <view wx:if="{{submission.confirmedAt || submission.reviewedAt}}" class="submission__facts">
          <text wx:if="{{submission.confirmedAt}}" class="meta-text">本次确认：{{submission.confirmedAtText}}</text>
          <text wx:if="{{submission.reviewedAt}}" class="meta-text">审核时间：{{submission.reviewedAtText}}</text>
        </view>
        <view wx:if="{{submission.reviewReason}}" class="review-reason">
          <text class="review-reason__label">审核原因</text>
          <text class="review-reason__text" selectable>{{submission.reviewReason}}</text>
        </view>
        <view wx:if="{{submission.fileIds.length}}" class="attachment-list">
          <button
            wx:for="{{submission.fileIds}}"
            wx:for-item="fileId"
            wx:key="*this"
            class="attachment-button"
            data-id="{{fileId}}"
            bindtap="openFile"
            disabled="{{openingFile}}"
            hover-class="attachment-button--hover"
          >
            <ui-icon name="attachment" size="sm" />
            <text>{{openingFile ? '正在获取…' : '私有附件 ' + (index + 1)}}</text>
          </button>
        </view>
      </view>

      <load-state wx:if="{{historyLoading}}" mode="loading" variant="inline" compact title="正在读取成果历史" />
      <load-state
        wx:elif="{{historyError}}"
        mode="error"
        variant="inline"
        description="{{historyError}}"
        action-text="重试历史"
        bind:action="retryHistory"
      />
      <view wx:elif="{{!history.length}}" class="history-empty">
        <text class="history-empty__title">暂无成果记录</text>
        <text class="history-empty__text">仅确认学习的任务不会生成成果记录</text>
      </view>
      <button wx:if="{{historyMore && !historyLoading}}" class="secondary-button history-card__more" bindtap="moreHistory">查看更多历史提交</button>
    </view>
  </block>
</view>
