@import "../points-common.wxss";

.apply-guide {
  padding: 26rpx 28rpx 22rpx;
  border: 1rpx solid #ecdfdf;
  border-radius: 20rpx;
  background: #fffcfa;
}

.apply-guide__steps {
  display: flex;
  align-items: center;
}

.apply-guide__step {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 9rpx;
  color: var(--color-text-secondary);
}

.apply-guide__number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: var(--weight-semibold);
  font-variant-numeric: tabular-nums;
  background: var(--color-bg-card);
}

.apply-guide__step--current {
  color: var(--color-brand-red-deep);
  font-weight: var(--weight-semibold);
}

.apply-guide__step--current .apply-guide__number {
  color: var(--color-text-inverse);
  border-color: var(--color-brand-red);
  background: var(--color-brand-red);
}

.apply-guide__label {
  font-size: var(--font-xs);
  line-height: 1.4;
}

.apply-guide__line {
  flex: 1;
  min-width: 14rpx;
  height: 1rpx;
  margin: 0 14rpx;
  background: #e7d9da;
}

.apply-guide__caption {
  display: block;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eddfdf;
  font-size: var(--font-xs);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.result-sheet {
  padding: 32rpx 28rpx 28rpx;
  border: 1rpx solid #ecdfdf;
  border-left: 10rpx solid var(--color-brand-red);
  border-radius: 20rpx;
  background: #fffcfa;
}

.result-sheet__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.result-sheet__label {
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--color-text-secondary);
}

.result-sheet__title {
  display: block;
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: var(--weight-bold);
  line-height: 1.45;
}

.result-sheet__description {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-sm);
  line-height: 1.75;
  color: var(--color-text-secondary);
}

.result-sheet__summary {
  margin-top: 26rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: 14rpx;
  background: var(--color-bg-card);
}

.result-sheet__row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 18rpx 0;
  font-size: var(--font-sm);
  line-height: 1.65;
}

.result-sheet__row + .result-sheet__row {
  border-top: 1rpx solid var(--color-border-light);
}

.result-sheet__row-label {
  flex-shrink: 0;
  width: 112rpx;
  color: var(--color-text-tertiary);
}

.result-sheet__row-value {
  flex: 1;
  min-width: 0;
  font-weight: var(--weight-medium);
}

.result-sheet__row-value--id {
  font-size: var(--font-xs);
  overflow-wrap: anywhere;
}

.result-sheet__awarded {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--color-border-light);
  font-size: var(--font-sm);
  color: #176b4d;
}

.result-sheet__awarded-value {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
}

.result-sheet__primary,
.result-sheet__secondary {
  width: 100%;
  margin-top: 24rpx;
}

.result-sheet__secondary {
  margin-top: 14rpx;
}

.eligibility-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin-top: 24rpx;
  padding: 42rpx 34rpx 32rpx;
  text-align: center;
}

.eligibility-state__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border: 1rpx solid #dec28f;
  border-radius: 50%;
  font-size: 38rpx;
  font-weight: var(--weight-semibold);
  color: #76501a;
  background: #fff8ec;
}

.eligibility-state__title {
  margin-top: 22rpx;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
}

.eligibility-state__description {
  margin-top: 10rpx;
  font-size: var(--font-sm);
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.eligibility-state__button {
  width: 100%;
  margin-top: 24rpx;
}

.eligibility-state__button + .eligibility-state__button {
  margin-top: 14rpx;
}

.form-sheet,
.materials-sheet {
  padding: 0 26rpx;
}

.field-block {
  padding: 26rpx 0 24rpx;
}

.field-block + .field-block {
  border-top: 1rpx solid var(--color-border-light);
}

.field-block__label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.field-block__label {
  min-width: 0;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  line-height: 1.5;
}

.required-star {
  color: var(--color-brand-red);
  font-weight: var(--weight-bold);
}

.field-block__counter {
  flex-shrink: 0;
  font-size: var(--font-xs);
  font-variant-numeric: tabular-nums;
  color: var(--color-text-tertiary);
}

.form-control {
  width: 100%;
  min-height: 78rpx;
  margin-top: 8rpx;
  padding: 16rpx 0;
  font-size: var(--font-md);
  line-height: 1.65;
  color: var(--color-text-primary);
  background: transparent;
}

.form-control--textarea {
  min-height: 210rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  background: #fafbfd;
}

.form-control__placeholder,
.picker-control--placeholder {
  color: var(--color-text-placeholder);
}

.field-block__help {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-xs);
  line-height: 1.6;
  color: var(--color-text-tertiary);
}

.picker-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 82rpx;
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: var(--font-md);
  line-height: 1.55;
  background: #fafbfd;
}

.materials-sheet {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.materials-sheet__description {
  display: block;
  font-size: var(--font-sm);
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.material-list {
  margin-top: 12rpx;
}

.material-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.material-item__type {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 62rpx;
  height: 62rpx;
  border: 1rpx solid rgba(196, 59, 74, 0.12);
  border-radius: 12rpx;
  font-size: 18rpx;
  font-weight: var(--weight-bold);
  color: var(--color-brand-red-deep);
  background: var(--color-brand-red-tint);
}

.material-item__body {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.material-item__name {
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.material-item__status {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.material-item__remove {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  color: var(--color-text-secondary);
  background: var(--color-bg-page-deep);
}

.material-item__remove[disabled] {
  opacity: 0.4;
}

.add-material {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  min-height: 158rpx;
  margin-top: 20rpx;
  padding: 22rpx;
  border: 2rpx dashed rgba(196, 59, 74, 0.3);
  border-radius: 14rpx;
  text-align: left;
  background: var(--color-brand-red-tint);
  transition:
    opacity var(--transition-fast),
    transform var(--transition-fast);
}

.add-material--compact {
  min-height: 92rpx;
}

.add-material--hover {
  opacity: 0.78;
  transform: scale(0.99);
}

.add-material[disabled] {
  opacity: 0.5;
}

.add-material__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 50rpx;
  height: 50rpx;
  border-radius: 12rpx;
  background: var(--color-bg-card);
}

.add-material__copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.add-material__title {
  font-size: var(--font-base);
  font-weight: var(--weight-semibold);
  color: var(--color-brand-red-deep);
}

.add-material__description {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.materials-sheet__error {
  margin-top: 16rpx;
}

.submit-area {
  margin-top: 30rpx;
}

.submit-area__button {
  width: 100%;
  min-height: 94rpx;
}

.submit-area__hint {
  display: block;
  margin-top: 14rpx;
  padding: 0 20rpx;
  font-size: var(--font-xs);
  line-height: 1.65;
  text-align: center;
  color: var(--color-text-tertiary);
}

@media (max-width: 340px) {
  .apply-guide {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .apply-guide__line {
    margin: 0 8rpx;
  }

  .apply-guide__step {
    gap: 6rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .add-material {
    transition: none;
  }
}
