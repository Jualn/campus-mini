@import "../../../styles/skeleton.wxss";
@import "../../../styles/profile-header.wxss";

.editor-body {
  padding: var(--space-md) var(--page-padding);
}

.editor-body--ready {
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
}

.editor-body--save-error {
  padding-bottom: calc(252rpx + env(safe-area-inset-bottom));
}

.editor-card {
  padding: var(--space-md);
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
}

.editor-card + .editor-card {
  margin-top: var(--space-md);
}

.cover-picker {
  display: block;
  padding: 0;
  margin: 0;
  overflow: hidden;
  border-radius: 0 0 var(--radius-sm) var(--radius-sm);
}

.cover-action {
  position: absolute;
  right: 30rpx;
  top: var(--space-md);
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  min-height: 56rpx;
  padding: 0 var(--space-sm);
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  font-size: var(--font-sm);
}

.avatar-preview {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 0;
  margin: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-full);
}

.avatar-initial {
  color: var(--color-text-inverse);
  font-size: var(--space-2xl);
  font-weight: var(--weight-bold);
}

.avatar-action {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: var(--space-2xs) 0 var(--space-xs);
  background: rgba(31, 45, 69, 0.72);
  color: var(--color-text-inverse);
  font-size: var(--font-xs);
  line-height: 1.35;
  text-align: center;
}

.field {
  display: block;
}

.field + .field {
  margin-top: var(--space-md);
}

.field-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs);
}

.field-label {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
}

.field-count,
.field-optional {
  color: var(--color-text-secondary);
  font-size: var(--font-xs);
}

.field-optional {
  margin-left: var(--space-xs);
}

.editor-input {
  background: var(--color-bg-page);
  border-color: var(--color-border-light);
}

input.editor-input {
  height: 80rpx;
  padding: 0 var(--space-md);
}

.editor-input--bio {
  min-height: 152rpx;
}

.field-count--invalid,
.field-error,
.save-error {
  color: var(--color-brand-red-deep);
}

.field-error,
.save-error {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  overflow-wrap: anywhere;
}

.save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  padding: var(--space-sm) var(--page-padding) calc(var(--space-sm) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border-light);
  background: var(--color-bg-card);
}

.save-error {
  max-height: 96rpx;
  margin: 0 0 var(--space-xs);
  overflow-y: auto;
}

.save-button {
  width: 100%;
  min-height: 88rpx;
}

.save-button[disabled] {
  background: var(--color-bg-page-deep);
  color: var(--color-text-secondary);
  box-shadow: none;
}

.cover-picker::after,
.avatar-preview::after {
  border: 0;
}

.photo-picker--pressed .cover-action,
.photo-picker--pressed .avatar-action {
  opacity: 0.75;
}

.skeleton-control {
  width: 100rpx;
  height: 30rpx;
}

.skeleton-input {
  margin: var(--space-xs) 0 var(--space-md);
  height: 76rpx;
}

.skeleton-input--bio {
  margin-bottom: 0;
  height: 152rpx;
}
