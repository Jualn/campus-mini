/* subpkg_user/pages/edit-profile/index.wxss */

page {
  background: #F4F5F7;
}

.edit-page {
  min-height: 100vh;
  background: #F4F5F7;
}

/* =====================================================
   导航栏
   关键修复：去掉固定 height，改用 min-height 只约束内容行高
   padding-top 由 JS 动态注入状态栏高度，整体高度自然撑开
   ===================================================== */
.nav-bar {
  background: #fff;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 0;
  padding-right: 0;
  /* 修复：去掉固定 height，改为内容行 min-height，padding-top 由 JS 追加 */
  min-height: 0;
  padding-bottom: 0;
  box-shadow: 0 1rpx 0 #F1F2F6;
}

/* 导航内容行（返回 + 标题 + 占位）统一高度 */
.nav-bar::after {
  display: none;
}

/* 内容行高度容器：让 flex 子项在 88rpx 内垂直居中 */
.nav-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back__icon {
  font-size: 52rpx;
  color: #0f1419;
  font-weight: 300;
  line-height: 1;
  /* 修复：‹ 字符在部分字体里视觉偏上，微调 */
  margin-top: 2rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f1419;
  position: absolute;
  left: 50%;
  /* 修复：绝对定位需要指定 top，否则跟随 padding-top 偏移 */
  bottom: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  transform: translateX(-50%);
  white-space: nowrap;
}

.nav-placeholder {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

/* =====================================================
   底部固定保存栏
   ===================================================== */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 40rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -1rpx 0 #F1F2F6;
  /* 修复：防止内容被 z-index 更高的元素遮住 */
  z-index: 100;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: #CFD3D8;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.save-btn--active {
  background: #0f1419;
}

.save-btn__text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

/* =====================================================
   横幅
   ===================================================== */
.banner-wrap {
  position: relative;
  width: 100%;
  height: 420rpx;
  background: linear-gradient(180deg, #c7d2fe 0%, #e0e7ff 60%, #f1f5ff 100%);
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 420rpx;
  display: block;
}

.banner-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.28);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.banner-mask__icon {
  font-size: 52rpx;
  line-height: 1;
}

.banner-mask__text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* =====================================================
   头像行
   修复：头像直径 160rpx，上移 80rpx 刚好露出一半压住横幅底部，
         视觉更自然；原来 -100rpx 导致头像偏高
   ===================================================== */
.avatar-row {
  padding-left: 30rpx;
  margin-top: -90rpx;
  margin-bottom: 16rpx;
  /* 修复：需要比横幅层级高，才不被横幅遮住 */
  position: relative;
  z-index: 1;
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #F4F5F7;
  background: #eee;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.12);
  display: block;
  /* 修复：box-sizing 确保 border 不撑大尺寸 */
  box-sizing: border-box;
}

.avatar-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-mask__icon {
  font-size: 44rpx;
  line-height: 1;
}

/* =====================================================
   表单卡片
   ===================================================== */
.form-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 20rpx;
  overflow: hidden;
  /* 修复：确保在头像层之上不会被压住 */
  position: relative;
  z-index: 1;
}

.form-item {
  display: flex;
  align-items: center;   /* 对齐 label 盒子和 form-right 盒子的中线 */
  padding: 0 30rpx;
  min-height: 104rpx;
  box-sizing: border-box;
}

.form-item--top {
  align-items: flex-start;
  padding-top: 28rpx;
  padding-bottom: 20rpx;
  /* 修复：去掉 min-height，让 textarea 撑开高度 */
  min-height: unset;
}

.form-item--gender {
  align-items: center;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  min-height: unset;
}

.form-label {
  width: 110rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: #0f1419;
  /* 修复：height 和 line-height 都设成 input 的实际高度，
     让文字垂直居中且盒子高度与 input 一致，
     align-items:center 才能真正让两者视觉对齐 */
  height: 44rpx;
  line-height: 44rpx;
  display: flex;
  align-items: center;
}

/* 右侧内容区 */
.form-right {
  flex: 1;
  display: flex;
  flex-direction: row;   /* ← 改为横向 */
  align-items: center;   /* ← input 和 count 垂直居中 */
  gap: 8rpx;
  overflow: hidden;
}

/* 简介行（textarea）仍需纵向 */
.form-right--col {
  flex-direction: column;
  align-items: stretch;
}

.form-right--row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 0;
}

/* =====================================================
   ID 行：修复 :has() 兼容性问题
   用 .form-right--prefix 替代 :has() 伪类选择器
   同步修改 WXML 中对应 class
   ===================================================== */
.form-right--prefix {
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
}

.form-prefix {
  font-size: 30rpx;
  color: #536471;
  flex-shrink: 0;
  line-height: 44rpx;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #0f1419;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0;
  margin: 0;
}

.form-textarea {
  width: 100%;
  font-size: 30rpx;
  color: #0f1419;
  line-height: 1.65;
  min-height: 80rpx;
  /* 修复：同 input 清零内边距 */
  padding: 0;
  box-sizing: border-box;
}

.form-placeholder {
  color: #CFD3D8;
}

.form-count {
  font-size: 22rpx;
  color: #CFD3D8;
  flex-shrink: 0;
  white-space: nowrap;
  line-height: 44rpx;   /* ← 和 input 等高，视觉对齐 */
}

.form-value {
  font-size: 30rpx;
  color: #0f1419;
  flex: 1;
}

.form-value--placeholder {
  color: #CFD3D8;
}

.form-arrow {
  font-size: 36rpx;
  color: #CFD3D8;
  /* 修复：› 符号视觉偏上，微调 */
  line-height: 1;
  margin-top: 2rpx;
  flex-shrink: 0;
}

.form-divider {
  height: 1rpx;
  background: #F5F5F5;
  margin: 0 30rpx;
}

/* =====================================================
   性别选择
   修复：gender-row 宽度撑满，按钮等宽排列，emoji 和文字严格对齐
   ===================================================== */
.gender-row {
  flex: 1;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.gender-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 20rpx;
  border-radius: 30rpx;
  border: 1.5rpx solid #EFF3F4;
  background: #F9FAFB;
  /* 修复：等宽排列，防止不同文字长度导致按钮宽度不一 */
  flex: 1;
  box-sizing: border-box;
}

.gender-btn--active {
  border-color: #007AFF;
  background: #E8F2FF;
}

.gender-icon {
  font-size: 30rpx;
  /* 修复：emoji 在不同系统行高不同，固定行高对齐 */
  line-height: 36rpx;
  flex-shrink: 0;
}

.gender-label {
  font-size: 26rpx;
  color: #536471;
  line-height: 36rpx;
  white-space: nowrap;
}

.gender-btn--active .gender-label {
  color: #007AFF;
  font-weight: 600;
}

/* =====================================================
   底部安全距离
   修复：根据 save-bar 实际高度（96 + 32 + safe-area）合理设值
         用 calc 精确计算，不再硬编码 200rpx
   ===================================================== */
.bottom-safe {
  height: calc(96rpx + 32rpx + 32rpx + env(safe-area-inset-bottom));
}