<!-- subpkg_user/pages/edit-profile/index.wxml -->

<view class="edit-page">

<!-- 加载态 -->
<view wx:if="{{loading}}" class="page-mask">
  <view class="loading-card">
    <view class="skeleton-block skeleton-radius-lg skeleton-avatar"></view>
    <view class="skeleton-block skeleton-radius-md skeleton-title"></view>
    <view class="skeleton-block skeleton-radius-sm skeleton-line"></view>
    <view class="skeleton-block skeleton-radius-sm skeleton-line"></view>
  </view>
</view>

<!-- 错误态 -->
<view wx:elif="{{loadError}}" class="page-mask">
  <view class="error-box">
    <text class="error-text">加载失败</text>
    <view class="retry-btn" bindtap="onRetry">重试</view>
  </view>
</view>

  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top:{{statusBarHeight}}px;">
    <view class="nav-back" bindtap="onCancel">
      <text class="nav-back__icon">‹</text>
    </view>
    <text class="nav-title">编辑资料</text>
    <view class="nav-placeholder" />
  </view>

  <!-- 横幅 -->
  <view class="banner-wrap" bindtap="onChangeBanner">
    <image class="banner-img" src="{{form.bannerUrl}}" mode="aspectFill" />
    <view class="banner-mask">
      <image class="banner-mask__icon" src="/assets/icons/profile/change_cover_line.svg" mode="aspectFit" />
      <text class="banner-mask__text">更换封面</text>
    </view>
  </view>

  <!-- 头像行 -->
  <view class="avatar-row">
    <view class="avatar-wrap" bindtap="onChangeAvatar">
      <image class="avatar-img" src="{{form.avatarUrl}}" mode="aspectFill" />
      <view class="avatar-mask">
        <image class="avatar-mask__icon" src="/assets/icons/profile/change_avatar_line.svg" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 表单卡片 -->
  <view class="form-card">

    <view class="form-item">
      <text class="form-label">昵称</text>
      <view class="form-right">
        <input class="form-input" value="{{form.nickname}}" placeholder="填写你的昵称" placeholder-class="form-placeholder"
          maxlength="20" bindinput="onInput" data-field="nickname" />
        <text class="form-count">{{form.nickname.length}}/20</text>
      </view>
    </view>
    <view class="form-divider" />

    <view class="form-item form-item--top">
      <text class="form-label">简介</text>
      <view class="form-right form-right--col">
        <textarea class="form-textarea" value="{{form.bio}}" placeholder="介绍一下自己吧" placeholder-class="form-placeholder"
          maxlength="80" auto-height show-confirm-bar="{{false}}" adjust-position="{{false}}" cursor-spacing="20"
          bindinput="onInput" data-field="bio" />
        <text class="form-count">{{form.bio.length}}/80</text>
      </view>
    </view>
    <view class="form-divider" />

    <!-- 修复：加 form-right--prefix，替代不兼容的 :has() -->
