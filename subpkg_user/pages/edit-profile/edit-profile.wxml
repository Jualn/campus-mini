  <view class="bottom-safe" />

</view>

<!-- 底部固定保存栏 -->
<view class="save-bar">
  <view class="save-btn {{hasChanged ? 'save-btn--active' : ''}}" bindtap="onSave">
    <text class="save-btn__text">保存</text>
  </view>
</view>