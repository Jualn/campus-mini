<page-navigation title="编辑资料" fixed auto-back="{{false}}" bind:back="onCancel" />

<block wx:if="{{asyncLoad.phase === 'idle' || asyncLoad.phase === 'loading'}}">
  <view wx:if="{{asyncLoad.skeletonVisible}}" aria-role="status" aria-label="正在加载个人资料">
    <view class="banner-wrap skeleton-block" />
    <view class="profile-body">
      <view class="avatar-action-row">
        <view class="profile-avatar skeleton-block skeleton-circle" />
      </view>
    </view>
    <view class="editor-body">
      <view class="editor-card">
        <view class="skeleton-control skeleton-block skeleton-radius-sm" />
        <view class="skeleton-input skeleton-block skeleton-radius-md" />
        <view class="skeleton-control skeleton-block skeleton-radius-sm" />
        <view class="skeleton-input skeleton-input--bio skeleton-block skeleton-radius-md" />
      </view>
    </view>
  </view>
</block>

<load-state
  wx:elif="{{asyncLoad.phase === 'error'}}"
  mode="{{asyncLoad.loading ? 'loading' : 'error'}}"
  title="{{asyncLoad.loading ? '正在重新加载' : '暂时无法加载资料'}}"
  description="{{asyncLoad.loading ? '' : asyncLoad.errorMessage}}"
  action-text="{{asyncLoad.loading ? '' : '重试'}}"
  bind:action="onRetry"
/>

<block wx:else>
  <button class="banner-wrap cover-picker" disabled="{{saving || selecting}}"
    bindtap="onChangeBackground" hover-class="photo-picker--pressed" aria-label="更换封面">
    <image wx:if="{{form.backgroundUrl}}" class="banner-img" src="{{form.backgroundUrl}}" mode="aspectFill" />
    <view class="cover-action" aria-hidden="true">
      <ui-icon name="image-add" size="sm" />
      <text>更换封面</text>
    </view>
  </button>

  <view class="profile-body">
    <view class="avatar-action-row">
      <button class="profile-avatar avatar-preview" style="background: {{avatarPreview.bg}};"
        disabled="{{saving || selecting}}" bindtap="onChangeAvatar" hover-class="photo-picker--pressed" aria-label="更换头像">
        <image wx:if="{{form.avatarUrl}}" class="avatar-image" src="{{form.avatarUrl}}" mode="aspectFill" />
        <text wx:else class="avatar-initial">{{avatarPreview.char}}</text>
        <view class="avatar-action" aria-hidden="true">换头像</view>
      </button>
    </view>
  </view>

  <view class="editor-body editor-body--ready {{saveError ? 'editor-body--save-error' : ''}}">
    <view class="editor-card">
      <label class="field">
        <view class="field-heading">
          <text class="field-label">昵称</text>
          <text class="field-count {{nicknameLength > 10 ? 'field-count--invalid' : ''}}">{{nicknameLength}}/10</text>
        </view>
        <input class="input-base editor-input" aria-label="昵称（必填）" value="{{form.nickname}}"
          placeholder="填写昵称" maxlength="-1" cursor-spacing="20" disabled="{{saving}}" bindinput="onInput" data-field="nickname" />
        <text wx:if="{{fieldErrors.nickname}}" class="field-error" role="alert">{{fieldErrors.nickname}}</text>
      </label>

      <label class="field">
        <view class="field-heading">
          <view><text class="field-label">简介</text><text class="field-optional">选填</text></view>
          <text class="field-count {{bioLength > 200 ? 'field-count--invalid' : ''}}">{{bioLength}}/200</text>
        </view>
        <textarea class="input-base editor-input editor-input--bio" aria-label="简介（选填）" value="{{form.bio}}"
          placeholder="介绍一下自己" maxlength="-1" auto-height show-confirm-bar="{{false}}"
          adjust-position="{{true}}" cursor-spacing="20" disabled="{{saving}}" bindinput="onInput" data-field="bio" />
        <text wx:if="{{fieldErrors.bio}}" class="field-error" role="alert">{{fieldErrors.bio}}</text>
      </label>
    </view>
  </view>

  <view class="save-bar">
    <text wx:if="{{saveError}}" class="save-error" role="alert">{{saveError}}</text>
    <button class="btn btn-primary save-button" loading="{{saving}}" disabled="{{!hasChanged || saving || selecting}}" bindtap="onSave">
      {{saving ? '正在保存' : '保存'}}
    </button>
  </view>
</block>
