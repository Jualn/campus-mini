<!-- subpkg_user/pages/edit-profile/index.wxml -->

<view class="edit-page">
  <!-- 加载阶段始终遮住未准备好的表单，慢请求才显示骨架。 -->
  <view wx:if="{{asyncLoad.phase === 'idle' || asyncLoad.phase === 'loading'}}" class="page-mask">
    <view wx:if="{{asyncLoad.skeletonVisible}}" class="loading-card" aria-role="status" aria-label="个人资料加载中">
      <view class="skeleton-block skeleton-radius-lg skeleton-avatar"></view>
      <view class="skeleton-block skeleton-radius-md skeleton-title"></view>
      <view class="skeleton-block skeleton-radius-sm skeleton-line"></view>
      <view class="skeleton-block skeleton-radius-sm skeleton-line"></view>
    </view>
  </view>

  <view wx:elif="{{asyncLoad.phase === 'error'}}" class="page-mask">
    <load-state
      mode="{{asyncLoad.loading ? 'loading' : 'error'}}"
      title="{{asyncLoad.loading ? '正在重新加载' : '暂时无法加载'}}"
      description="{{asyncLoad.loading ? '' : (asyncLoad.errorMessage || '网络可能暂时不可用，请稍后再试')}}"
      action-text="{{asyncLoad.loading ? '' : '重新加载'}}"
      bind:action="onRetry"
    />
  </view>

  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top:{{statusBarHeight}}px;">
    <view class="nav-back" bindtap="onCancel" aria-role="button" aria-label="返回">
      <view class="nav-back__surface"><ui-icon name="chevron-left" size="lg" /></view>
    </view>
    <text class="nav-title">编辑资料</text>
    <view class="nav-placeholder" />
  </view>

  <view class="banner-wrap" bindtap="onChangeBackground" aria-role="button" aria-label="更换主页背景">
    <image wx:if="{{form.backgroundUrl}}" class="banner-img" src="{{form.backgroundUrl}}" mode="aspectFill" />
    <view class="banner-mask"><text class="banner-mask__text">更换背景</text></view>
  </view>

  <!-- 头像行 -->
  <view class="avatar-row">
    <view class="avatar-wrap" bindtap="onChangeAvatar">
      <image class="avatar-img" wx:if="{{form.avatarUrl}}" src="{{form.avatarUrl}}" mode="aspectFill" />
      <view class="avatar-mask">
        <image class="avatar-mask__icon" src="../../assets/icons/profile/change_avatar_line.svg" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 表单卡片 -->
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">昵称</text>
      <view class="form-right">
        <input
          class="form-input"
          value="{{form.nickname}}"
          placeholder="填写你的昵称"
          placeholder-class="form-placeholder"
          maxlength="-1"
          disabled="{{saving}}"
          bindinput="onInput"
          data-field="nickname"
        />
        <text class="form-count">{{nicknameLength}}/10</text>
      </view>
    </view>
    <view class="form-divider" />

    <view class="form-item form-item--top">
      <text class="form-label">简介</text>
      <view class="form-right form-right--col">
        <textarea
          class="form-textarea"
          value="{{form.bio}}"
          placeholder="介绍一下自己吧"
          placeholder-class="form-placeholder"
          maxlength="-1"
          auto-height
          show-confirm-bar="{{false}}"
          adjust-position="{{false}}"
          cursor-spacing="20"
          disabled="{{saving}}"
          bindinput="onInput"
          data-field="bio"
        />
        <text class="form-count">{{bioLength}}/200</text>
      </view>
    </view>
    <view class="form-divider" />

  </view>

  <view wx:if="{{saveError}}" class="save-error" aria-role="status">{{saveError}}</view>
  <view class="bottom-safe" />
</view>

<!-- 底部固定保存栏 -->
<view class="save-bar">
  <view class="save-btn {{hasChanged && !saving ? 'save-btn--active' : ''}}" bindtap="onSave" aria-role="button" aria-disabled="{{!hasChanged || saving}}">
    <text class="save-btn__text">{{saving ? '保存中…' : '保存'}}</text>
  </view>
</view>
