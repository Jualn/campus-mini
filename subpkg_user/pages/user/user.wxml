<!-- pages/user/index.wxml -->
<view class="page">
  <!-- 初始加载：他人主页整体骨架，保留返回能力 -->
  <block wx:if="{{listLoad.phase === 'initial'}}">
    <profile-feed-skeleton
      wx:if="{{listLoad.skeletonVisible}}"
      type="user"
      status-bar-height="{{statusBarHeight}}"
      post-count="{{3}}"
      media-mode="auto"
      bind:back="onBack"
    />
  </block>

  <!-- 首屏失败 -->
  <load-state
    wx:elif="{{listLoad.initialError}}"
    mode="{{listLoad.refreshing ? 'loading' : 'error'}}"
    title="{{listLoad.refreshing ? '正在重新加载' : '暂时无法加载'}}"
    description="{{listLoad.refreshing ? '' : '网络可能暂时不可用，请稍后再试'}}"
    action-text="{{listLoad.refreshing ? '' : '重新加载'}}"
    fill-viewport
    bind:action="retryInitial"
  />

  <block wx:else>
    <user-profile
      is-self="{{false}}"
      user-info="{{userInfo}}"
      is-following="{{isFollowing}}"
      active-tab="{{activeTab}}"
      status-bar-height="{{statusBarHeight}}"
      bind:back="onBack"
      bind:more="onMore"
      bind:switchtab="onSwitchTab"
    />

    <!-- likes tab 首次加载 -->
    <post-card-skeleton
      wx:if="{{activeTab === 'likes' && likesLoading}}"
      count="{{2}}"
      media-mode="auto"
      show-third-line="{{true}}"
    />

    <!-- likes tab 加载失败 -->
    <load-state
      wx:elif="{{activeTab === 'likes' && likesError}}"
      mode="error"
      variant="section"
      title="暂时无法加载"
      description="点赞内容没有加载成功"
      action-text="重新加载"
      bind:action="retryLikes"
    />

    <!-- 列表内容 -->
    <block wx:elif="{{posts.length > 0}}">
      <block wx:for="{{posts}}" wx:key="id" wx:for-item="post">
        <post-card
          post="{{post}}"
          bind:comment="onOpenComment"
          bind:view="onPostView"
          bind:share="onOpenShare"
          bind:more="onPostCardMore"
        />
      </block>
    </block>

    <!-- 空态 -->
    <load-state
      wx:else
      mode="empty"
      variant="section"
      title="{{activeTab === 'posts' ? 'TA 还没有发布动态' : 'TA 还没有点赞内容'}}"
    />

    <!-- 分页加载 -->
    <post-card-skeleton wx:if="{{listLoad.loadingMore}}" count="{{2}}" media-mode="auto" />

    <!-- 分页失败 -->
    <load-state
      wx:if="{{listLoad.loadMoreError}}"
      mode="error"
      variant="inline"
      title="加载失败"
      action-text="点击重试"
      bind:action="retryLoadMore"
    />

    <!-- 没有更多 -->
    <view
      wx:if="{{!listLoad.loadingMore && !listLoad.loadMoreError && !listLoad.hasMore && posts.length > 0}}"
      class="list-footer"
    >
      <text class="footer-text">— 已经到底啦 —</text>
    </view>
  </block>
</view>

<page-container
  show="{{showPopup}}"
  position="bottom"
  round
  overlay="{{false}}"
  close-on-slide-down="{{false}}"
  z-index="999"
  bind:leave="onPopupLeave"
>
  <comment-panel
    wx:if="{{popupType==='comment'}}"
    mode="sheet"
    target-id="{{commentTargetId}}"
    target-type="{{commentTargetType}}"
    total-count="{{commentTotalCount}}"
    visible="{{showPopup && popupType === 'comment'}}"
    bind:close="onCommentClose"
    bind:countchange="onCommentCountChange"
    bind:report="onCommentReport"
  />

  <share-panel
    wx:elif="{{popupType==='share'}}"
    share-image-path="{{currentShareImage}}"
    status="{{shareStatus}}"
    bind:retry="onRetryShare"
    bind:previewerror="onSharePreviewError"
    bind:close="onShareClose"
  />

  <report-panel
    wx:elif="{{popupType === 'report'}}"
    target-type="{{reportTargetType}}"
    target-id="{{reportTargetId}}"
    bind:close="onCloseReport"
  />
</page-container>

<in-app-banner />

<canvas type="2d" id="posterCanvas" style="position: fixed; left: -9999px; top: -9999px"></canvas>
