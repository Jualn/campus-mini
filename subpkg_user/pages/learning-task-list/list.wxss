page {
  background: var(--color-bg-page);
}

.page {
  min-height: 100vh;
  padding: var(--space-md) var(--page-padding) calc(40rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 100% 0%, rgba(196, 59, 74, 0.09), transparent 28%),
    var(--color-bg-page);
}

.overview {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  border-radius: var(--radius-lg);
  color: var(--color-text-inverse);
  background: linear-gradient(135deg, var(--color-brand-red-deep), var(--color-brand-red) 62%, var(--color-brand-red-soft));
  box-shadow: 0 16rpx 36rpx rgba(169, 42, 58, 0.2);
}

.overview::after {
  content: "";
  position: absolute;
  top: -110rpx;
  right: -72rpx;
  width: 250rpx;
  height: 250rpx;
  border: 38rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 50%;
  pointer-events: none;
}

.overview__main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.overview__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.72);
}

.overview__copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.overview__eyebrow {
  font-size: 19rpx;
  font-weight: var(--weight-bold);
  letter-spacing: 3rpx;
  opacity: 0.74;
}

.overview__title {
  margin-top: 2rpx;
  font-size: 40rpx;
  font-weight: var(--weight-heavy);
  line-height: 1.35;
}

.overview__description {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  line-height: 1.6;
  opacity: 0.88;
}

.overview__footer {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  font-size: var(--font-xs);
  line-height: 1.5;
  opacity: 0.84;
}

.filter-panel {
  position: sticky;
  top: 0;
  z-index: 10;
  margin: 20rpx calc(0rpx - var(--page-padding)) 0;
  padding: 18rpx var(--page-padding) 20rpx;
  background: rgba(246, 248, 252, 0.96);
  border-bottom: 1rpx solid rgba(231, 237, 245, 0.8);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
}

.filter-panel__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.filter-panel__title {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
}

.filter-panel__result {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-scroll__inner {
  display: inline-flex;
  gap: 12rpx;
  padding-right: var(--page-padding);
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 62rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-full);
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  line-height: 1;
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-xs);
  transition: color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
}

.filter-chip--active {
  color: var(--color-text-inverse);
  background: var(--color-brand-red);
  border-color: var(--color-brand-red);
  font-weight: var(--weight-bold);
  box-shadow: 0 8rpx 20rpx rgba(196, 59, 74, 0.2);
}

.filter-chip--hover {
  transform: scale(0.97);
  opacity: 0.86;
}

.notice {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid transparent;
  border-radius: var(--radius-md);
}

.notice--warning {
  color: #9a5a12;
  background: #fff8ed;
  border-color: rgba(255, 159, 47, 0.2);
}

.notice__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  background: rgba(255, 255, 255, 0.8);
}

.notice__body {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.notice__title {
  font-size: var(--font-base);
  font-weight: var(--weight-bold);
}

.notice__text {
  margin-top: 4rpx;
  font-size: var(--font-sm);
  line-height: 1.6;
}

.refresh-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 18rpx 0 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.refresh-hint__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: refresh-pulse 1s ease-in-out infinite alternate;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 22rpx;
}

.task-card {
  display: block;
  width: 100%;
  padding: 28rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-lg);
  text-align: left;
  white-space: normal;
  line-height: 1.6;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-card);
  transition: transform var(--transition-fast), opacity var(--transition-fast), box-shadow var(--transition-fast);
}

.task-card--hover {
  transform: scale(0.988);
  opacity: 0.94;
  box-shadow: var(--shadow-sm);
}

.task-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.subject-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  color: var(--color-brand-red-deep);
  background: var(--color-brand-red-tint);
}

.subject-badge__dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--color-brand-red);
}

.task-card__title {
  display: block;
  margin-top: 20rpx;
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  line-height: 1.5;
  color: var(--color-text-primary);
  overflow-wrap: break-word;
}

.task-card__rejected {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--color-danger);
  background: rgba(255, 77, 79, 0.07);
}

.task-card__rejected-mark {
  flex-shrink: 0;
  font-weight: var(--weight-bold);
}

.deadline-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-tint);
}

.deadline-box__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
}

.deadline-box__copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.deadline-box__label {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.deadline-box__value {
  margin-top: 2rpx;
  font-size: var(--font-base);
  font-weight: var(--weight-semibold);
  line-height: 1.5;
  color: var(--color-primary-deep);
  overflow-wrap: break-word;
}

.task-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.task-card__lifecycle {
  flex: 1;
  min-width: 0;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.task-card__link {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 4rpx;
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-primary);
}

.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
  padding: 22rpx 0 40rpx;
}

.list-footer__text {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.load-more {
  min-width: 240rpx;
  min-height: 68rpx;
  padding: 0 30rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: var(--font-base);
  font-weight: var(--weight-semibold);
  line-height: 68rpx;
  text-align: center;
  color: var(--color-primary);
  background: var(--color-bg-card);
}

.load-more--hover {
  opacity: 0.78;
  transform: scale(0.98);
}

@keyframes refresh-pulse {
  from { opacity: 0.35; }
  to { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .refresh-hint__dot {
    animation: none;
  }
}
