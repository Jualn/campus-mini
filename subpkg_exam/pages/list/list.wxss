/* subpkg_exam/pages/list/index.wxss */

page {
  background: var(--color-bg-page);
}

.exam-list-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 60rpx;
}

/* =====================================================
   顶部
   ===================================================== */
.top-bar {
  background: var(--color-bg-card);
  padding: 0 30rpx 20rpx;
  box-shadow: var(--shadow-sm);
}

.top-bar__nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.top-bar__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-bar__back-icon {
  font-size: 52rpx;
  color: var(--color-text-primary);
  font-weight: 300;
  line-height: 1;
}

/* 原来的 top-bar__title 位置改一下 */
.top-bar__title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

/* 右侧占位，和左侧等宽让标题真正居中 */
.top-bar__placeholder {
  width: 72rpx;
}

.search-wrap {
  display: flex;
  align-items: center;
  background: var(--color-bg-page);
  border-radius: 40rpx;
  padding: 0 28rpx;
  height: 76rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
  height: 76rpx;
}

.search-placeholder {
  color: var(--color-text-tertiary);
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-clear__icon {
  font-size: 22rpx;
  color: var(--color-text-inverse);
}

/* =====================================================
   搜索结果
   ===================================================== */
.result-wrap {
  padding: 20rpx 20rpx 0;
}

.result-hint {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

/* =====================================================
   Banner
   ===================================================== */
.banner-card {
  margin: 24rpx 20rpx 0;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  overflow: hidden;
}

.banner-card--blue {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.banner-card--orange {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
}

.banner-card--purple {
  background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%);
}

.banner-card--green {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.banner-card--red {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.banner-left {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex: 1;
}

.banner-tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.banner-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.enroll-live {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.enroll-live__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  display: block;
  animation: pulse 1.5s infinite;
}

.enroll-live__text {
  font-size: 22rpx;
  color: var(--color-text-inverse);
  font-weight: 600;
}

@keyframes pulse {

  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.3;
  }
}

.banner-name {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--color-text-inverse);
  line-height: 1.2;
}

.banner-tagline {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.banner-date-row {
  margin-top: 4rpx;
}

.banner-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.banner-date--pending {
  color: rgba(255, 255, 255, 0.65);
  font-style: italic;
}

.banner-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding-left: 20rpx;
  flex-shrink: 0;
}

.banner-big-icon {
  font-size: 56rpx;
  opacity: 0.8;
}

.banner-countdown {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.banner-days {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--color-text-inverse);
  line-height: 1;
}

.banner-days-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* =====================================================
   分类 Tab
   ===================================================== */
.category-scroll {
  display: flex;
  white-space: nowrap;
  padding: 24rpx 20rpx 8rpx;
  gap: 12rpx;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background: var(--color-bg-card);
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.category-tab--active {
  background: var(--color-text-primary);
}

.category-tab__icon {
  font-size: 26rpx;
}

.category-tab__label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.category-tab--active .category-tab__label {
  color: var(--color-text-inverse);
  font-weight: 600;
}

/* =====================================================
   考试行
   ===================================================== */
.list-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin: 16rpx 20rpx 0;
  overflow: hidden;
}

.exam-row {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.exam-row:last-child {
  border-bottom: none;
}

.exam-row__icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.exam-row__icon-wrap--blue {
  background: var(--color-primary-light);
}

.exam-row__icon-wrap--orange {
  background: #FFF4EB;
}

.exam-row__icon-wrap--purple {
  background: #F4EEFF;
}

.exam-row__icon-wrap--green {
  background: #EBFFF3;
}

.exam-row__icon-wrap--red {
  background: #FFEBEE;
}

.exam-row__icon {
  font-size: 44rpx;
}

.exam-row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.exam-row__name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.exam-row__name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.exam-row__sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.exam-row__freq {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 报名中小角标 */
.enroll-badge-sm {
  background: #FF3B30;
  border-radius: 999rpx;
  padding: 0 12rpx;
  height: 36rpx;
  flex-shrink: 0;

  display: flex;
  align-items: center;
}

.enroll-badge-sm__text {
  font-size: 20rpx;
  color: var(--color-text-inverse);
  font-weight: 600;
  line-height: 1;
}

.exam-row__right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

/* 倒计时胶囊 */
.countdown-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.countdown-pill--blue {
  background: var(--color-primary-light);
}

.countdown-pill--orange {
  background: #FFF4EB;
}

.countdown-pill--purple {
  background: #F4EEFF;
}

.countdown-pill--green {
  background: #EBFFF3;
}

.countdown-pill--red {
  background: #FFEBEE;
}

.countdown-pill__num {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  line-height: 1;
}

.countdown-pill__unit {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.exam-row__arrow {
  font-size: 36rpx;
  color: #ddd;
}

/* =====================================================
   底部免责
   ===================================================== */
.list-footer {
  padding: 40rpx 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.footer-line {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}