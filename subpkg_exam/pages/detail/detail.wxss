/* subpkg_exam/pages/detail/index.wxss */
@import "../../../styles/skeleton.wxss";

page {
  background: var(--color-bg-page);
}

.detail-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 160rpx;
}

.exam-detail-skeleton__hero {
  min-height: 400rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(160deg, #e5f1ff 0%, #d9f4ff 100%);
}

.exam-detail-skeleton__back,
.exam-detail-error__back {
  align-self: flex-start;
  width: 64rpx;
  height: 64rpx;
  margin: 14rpx 0 24rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: var(--shadow-sm);
  color: var(--color-text-primary);
  font-size: 44rpx;
}

.exam-detail-skeleton__hero-icon {
  width: 116rpx;
  height: 116rpx;
}

.exam-detail-skeleton__hero-title {
  width: 40%;
  height: 44rpx;
  margin-top: 26rpx;
}

.exam-detail-skeleton__hero-line {
  width: 56%;
  height: 22rpx;
  margin-top: 18rpx;
}

.exam-detail-skeleton__card {
  margin: 24rpx 20rpx 0;
  padding: 30rpx 28rpx;
  border-radius: var(--radius-md);
}

.exam-detail-skeleton__card-title {
  width: 34%;
  height: 30rpx;
  margin-bottom: 30rpx;
}

.exam-detail-skeleton__line {
  width: 100%;
  height: 24rpx;
  margin-bottom: 18rpx;
}

.exam-detail-skeleton__line--short {
  width: 68%;
}

.exam-detail-error {
  min-height: calc(100vh - 160rpx);
  padding-left: 28rpx;
  padding-right: 28rpx;
}

/* =====================================================
   Hero
   ===================================================== */
.hero {
  padding: 0 28rpx 36rpx;
}

.hero--blue {
  background: linear-gradient(160deg, #4facfe 0%, #00f2fe 100%);
}

.hero--orange {
  background: linear-gradient(160deg, #f6d365 0%, #fda085 100%);
}

.hero--purple {
  background: linear-gradient(160deg, #a18cd1 0%, #fbc2eb 100%);
}

.hero--green {
  background: linear-gradient(160deg, #43e97b 0%, #38f9d7 100%);
}

.hero--red {
  background: linear-gradient(160deg, #f093fb 0%, #f5576c 100%);
}

.hero--indigo {
  background: linear-gradient(135deg, #5b86e5 0%, #36d1dc 100%);
}

.hero--gold {
  background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%);
}

.hero--yellow {
  background: linear-gradient(135deg, #fce38a 0%, #f38181 100%);
}

.hero--amber {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
}

.hero--slate {
  background: linear-gradient(135deg, #bdc3c7 0%, #2c3e50 100%);
}

.hero--cyan {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.hero-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  margin-bottom: 24rpx;
}

.hero-back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-back__icon {
  font-size: 48rpx;
  color: var(--color-text-inverse);
  font-weight: 300;
  line-height: 1;
  margin-top: -12rpx;
}

.hero-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 28rpx;
}

.hero-icon {
  width: 140rpx;
  height: 140rpx;
  font-size: 60rpx;
}

.hero-name {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--color-text-inverse);
  line-height: 1.2;
}

.hero-tagline {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.5;
}

.hero-organizer {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 状态行 */
.hero-status {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-md);
}

.status-pill--open {
  background: rgba(255, 255, 255, 0.28);
}

.status-pill--upcoming {
  background: rgba(0, 0, 0, 0.15);
}

.status-pill--closed {
  background: rgba(0, 0, 0, 0.18);
}

.status-pill__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  display: block;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.3;
  }
}

.status-pill__text {
  font-size: 24rpx;
  color: var(--color-text-inverse);
  font-weight: 600;
}

.hero-countdown {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.hero-countdown__num {
  font-size: 56rpx;
  font-weight: 900;
  color: var(--color-text-inverse);
  line-height: 1;
}

.hero-countdown__label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* =====================================================
   通用卡片
   ===================================================== */
.section-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin: 20rpx 20rpx 0;
  padding: 32rpx 28rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.section-title-icon {
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
}

.section-disclaimer {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* =====================================================
   时间线
   ===================================================== */
.freq-tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #f8f9fa;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 28rpx;
}

.freq-tip__icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.freq-tip__text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.timeline {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.tl-item {
  display: flex;
  gap: 20rpx;
  position: relative;
  padding-bottom: 32rpx;
}

.tl-item--last {
  padding-bottom: 0;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 8rpx;
  z-index: 1;
}

.tl-dot--done {
  background: #34c759;
}

.tl-dot--active {
  background: var(--color-primary);
  box-shadow: 0 0 0 6rpx rgba(0, 122, 255, 0.18);
}

.tl-dot--future {
  background: #d0d0d0;
}

.tl-dot--unknown {
  background: #e8e8e8;
  border: 2rpx dashed #bbb;
}

.tl-line {
  position: absolute;
  left: 9rpx;
  top: 28rpx;
  bottom: 0;
  width: 2rpx;
  background: #f0f0f0;
}

.tl-content {
  flex: 1;
  min-width: 0;
}

/* 标签行：名称 + 来源角标 */
.tl-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
  flex-wrap: wrap;
}

.tl-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 来源角标：官方公告 / 教务处通知 / 各校自定 */
.tl-source {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg-page);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

/* 日期 + 时分 */
.tl-datetime {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tl-date {
  font-size: 27rpx;
  color: #444;
}

.tl-time {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  background: var(--color-bg-page);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

/* 无日期：待通知 */
.tl-pending {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  font-style: italic;
}

/* 备注：往年规律 / 补充说明 */
.tl-note {
  display: block;
  font-size: 23rpx;
  color: #ff9500;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* 时间来源总说明 */
.source-tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #fffbf0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #ffe58f;
  margin-top: 4rpx;
}

.source-tip__icon {
  font-size: 26rpx;
  flex-shrink: 0;
}

.source-tip__text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* =====================================================
   基本信息
   ===================================================== */
.info-list {
  display: flex;
  flex-direction: column;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
  gap: 20rpx;
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
  width: 160rpx;
}

.info-value-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.info-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  text-align: right;
  line-height: 1.5;
}

.info-note {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg-page);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* =====================================================
   考试内容
   ===================================================== */
.subject-list {
  display: flex;
  flex-direction: column;
}

.subject-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
  gap: 16rpx;
}

.subject-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.subject-left {
  flex: 1;
}

.subject-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
}

.subject-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin-top: 4rpx;
}

.subject-score {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

/* =====================================================
   须知
   ===================================================== */
.mustknow-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mustknow-item {
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
}

.mustknow-dot {
  font-size: 32rpx;
  color: #ff9500;
  line-height: 1.4;
  flex-shrink: 0;
}

.mustknow-text {
  font-size: 27rpx;
  color: #444;
  line-height: 1.7;
}

/* =====================================================
   链接
   ===================================================== */
.link-list {
  display: flex;
  flex-direction: column;
}

.link-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.link-item:last-child {
  border-bottom: none;
}

/* 主要链接（报名入口）加底色突出 */
.link-item--primary {
  background: #f8f9fa;
  margin: 0 -28rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  border-bottom: none;
  margin-bottom: 4rpx;
}

.link-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.link-icon {
  font-size: 40rpx;
}

.link-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.link-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.link-desc {
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

.link-arrow {
  font-size: 36rpx;
  color: #ddd;
}

/* =====================================================
   底部报名栏
   ===================================================== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 30rpx;
  padding-bottom: calc(20rpx + 16px);
  padding-bottom: calc(constant(safe-area-inset-bottom) + 16px);
  padding-bottom: calc(env(safe-area-inset-bottom) + 16px);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 分享按钮 */
.share-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #f0f0f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0;
  margin: 0;
  border: none;
  line-height: 1;
  gap: 4rpx;
}

.share-btn::after {
  border: none;
}

.share-btn__icon {
  font-size: 30rpx;
  color: var(--color-text-primary);
  line-height: 1;
}

.share-btn__text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

.enroll-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: gray;
}

/* 报名中：用考试主题色 */
.enroll-btn--open.enroll-btn--blue {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
}

.enroll-btn--open.enroll-btn--orange {
  background: linear-gradient(135deg, #f6d365, #fda085);
}

.enroll-btn--open.enroll-btn--purple {
  background: linear-gradient(135deg, #a18cd1, #fbc2eb);
}

.enroll-btn--open.enroll-btn--green {
  background: linear-gradient(135deg, #43e97b, #38f9d7);
}

.enroll-btn--open.enroll-btn--red {
  background: linear-gradient(135deg, #f093fb, #f5576c);
}

/* 非报名期：统一灰色 */
.enroll-btn--upcoming,
.enroll-btn--closed,
.enroll-btn--unknown {
  background: #ebebeb;
}

.enroll-btn__text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-inverse);
  letter-spacing: 4rpx;
}

.enroll-btn--upcoming .enroll-btn__text,
.enroll-btn--closed .enroll-btn__text,
.enroll-btn--unknown .enroll-btn__text {
  color: #aaa;
}

.bottom-safe {
  height: 180rpx;
}

/* 普通行内小图标 */
.inline-icon {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
}

/* 链接 / 附件列表统一图标 */
.link-icon-img,
.attachment-icon-img {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

/* 分享按钮图标 */
.share-btn__icon-img {
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
}
