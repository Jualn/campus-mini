/* subpkg_exam/pages/detail/index.wxss */

page {
  background: #F4F5F7;
}

.detail-page {
  min-height: 100vh;
  background: #F4F5F7;
  padding-bottom: 160rpx;
}

/* =====================================================
   Hero
   ===================================================== */
.hero {
  padding: 0 28rpx 36rpx;
}

.hero--blue {
  background: linear-gradient(160deg, #4facfe 0%, #00f2fe 100%);
}

.hero--orange {
  background: linear-gradient(160deg, #f6d365 0%, #fda085 100%);
}

.hero--purple {
  background: linear-gradient(160deg, #a18cd1 0%, #fbc2eb 100%);
}

.hero--green {
  background: linear-gradient(160deg, #43e97b 0%, #38f9d7 100%);
}

.hero--red {
  background: linear-gradient(160deg, #f093fb 0%, #f5576c 100%);
}

.hero-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  margin-bottom: 24rpx;
}

.hero-back,
.hero-collect {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-collect--on {
  background: rgba(255, 255, 255, 0.45);
}

.hero-back__icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.hero-collect__icon {
  font-size: 34rpx;
}

.hero-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 28rpx;
}

.hero-icon {
  font-size: 60rpx;
}

.hero-name {
  font-size: 48rpx;
  font-weight: 900;
  color: #fff;
  line-height: 1.2;
}

.hero-tagline {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.5;
}

.hero-organizer {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 状态行 */
.hero-status {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.status-pill--open {
  background: rgba(255, 255, 255, 0.28);
}

.status-pill--upcoming {
  background: rgba(0, 0, 0, 0.15);
}

.status-pill--closed {
  background: rgba(0, 0, 0, 0.18);
}

.status-pill__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
  display: block;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {

  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.3;
  }
}

.status-pill__text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.hero-countdown {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.hero-countdown__num {
  font-size: 56rpx;
  font-weight: 900;
  color: #fff;
  line-height: 1;
}

.hero-countdown__label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* =====================================================
   通用卡片
   ===================================================== */
.section-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 20rpx 20rpx 0;
  padding: 32rpx 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
}

.section-disclaimer {
  font-size: 22rpx;
  color: #bbb;
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* =====================================================
   时间线
   ===================================================== */
.freq-tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #F8F9FA;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 28rpx;
}

.freq-tip__icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.freq-tip__text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.timeline {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.tl-item {
  display: flex;
  gap: 20rpx;
  position: relative;
  padding-bottom: 32rpx;
}

.tl-item--last {
  padding-bottom: 0;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 8rpx;
  z-index: 1;
}

.tl-dot--done {
  background: #34C759;
}

.tl-dot--active {
  background: #007AFF;
  box-shadow: 0 0 0 6rpx rgba(0, 122, 255, 0.18);
}

.tl-dot--future {
  background: #D0D0D0;
}

.tl-dot--unknown {
  background: #E8E8E8;
  border: 2rpx dashed #bbb;
}

.tl-line {
  position: absolute;
  left: 9rpx;
  top: 28rpx;
  bottom: 0;
  width: 2rpx;
  background: #F0F0F0;
}

.tl-content {
  flex: 1;
  min-width: 0;
}

/* 标签行：名称 + 来源角标 */
.tl-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
  flex-wrap: wrap;
}

.tl-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 来源角标：官方公告 / 教务处通知 / 各校自定 */
.tl-source {
  font-size: 20rpx;
  color: #999;
  background: #F4F5F7;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

/* 日期 + 时分 */
.tl-datetime {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tl-date {
  font-size: 27rpx;
  color: #444;
}

.tl-time {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a1a1a;
  background: #F4F5F7;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

/* 无日期：待通知 */
.tl-pending {
  font-size: 26rpx;
  color: #bbb;
  font-style: italic;
}

/* 备注：往年规律 / 补充说明 */
.tl-note {
  display: block;
  font-size: 23rpx;
  color: #FF9500;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* 时间来源总说明 */
.source-tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #FFFBF0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #FFE58F;
  margin-top: 4rpx;
}

.source-tip__icon {
  font-size: 26rpx;
  flex-shrink: 0;
}

.source-tip__text {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
}

/* =====================================================
   基本信息
   ===================================================== */
.info-list {
  display: flex;
  flex-direction: column;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  gap: 20rpx;
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
  width: 160rpx;
}

.info-value-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.info-value {
  font-size: 28rpx;
  color: #1a1a1a;
  text-align: right;
  line-height: 1.5;
}

.info-note {
  font-size: 20rpx;
  color: #bbb;
  background: #F5F5F5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* =====================================================
   考试内容
   ===================================================== */
.subject-list {
  display: flex;
  flex-direction: column;
}

.subject-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  gap: 16rpx;
}

.subject-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.subject-left {
  flex: 1;
}

.subject-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
}

.subject-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.subject-score {
  font-size: 26rpx;
  font-weight: 700;
  color: #555;
  flex-shrink: 0;
}

/* =====================================================
   须知
   ===================================================== */
.mustknow-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mustknow-item {
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
}

.mustknow-dot {
  font-size: 32rpx;
  color: #FF9500;
  line-height: 1.4;
  flex-shrink: 0;
}

.mustknow-text {
  font-size: 27rpx;
  color: #444;
  line-height: 1.7;
}

/* =====================================================
   链接
   ===================================================== */
.link-list {
  display: flex;
  flex-direction: column;
}

.link-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.link-item:last-child {
  border-bottom: none;
}

/* 主要链接（报名入口）加底色突出 */
.link-item--primary {
  background: #F8F9FA;
  margin: 0 -28rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  border-bottom: none;
  margin-bottom: 4rpx;
}

.link-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.link-icon {
  font-size: 40rpx;
}

.link-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.link-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.link-desc {
  font-size: 23rpx;
  color: #999;
}

.link-arrow {
  font-size: 36rpx;
  color: #ddd;
}

/* =====================================================
   底部报名栏
   ===================================================== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -1rpx 0 #F1F2F6;
}

.enroll-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 报名中：用考试主题色 */
.enroll-btn--open.enroll-btn--blue {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
}

.enroll-btn--open.enroll-btn--orange {
  background: linear-gradient(135deg, #f6d365, #fda085);
}

.enroll-btn--open.enroll-btn--purple {
  background: linear-gradient(135deg, #a18cd1, #fbc2eb);
}

.enroll-btn--open.enroll-btn--green {
  background: linear-gradient(135deg, #43e97b, #38f9d7);
}

.enroll-btn--open.enroll-btn--red {
  background: linear-gradient(135deg, #f093fb, #f5576c);
}

/* 非报名期：统一灰色 */
.enroll-btn--upcoming,
.enroll-btn--closed,
.enroll-btn--unknown {
  background: #EBEBEB;
}

.enroll-btn__text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.enroll-btn--upcoming .enroll-btn__text,
.enroll-btn--closed .enroll-btn__text,
.enroll-btn--unknown .enroll-btn__text {
  color: #aaa;
}

.bottom-safe {
  height: 180rpx;
}