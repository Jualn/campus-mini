@import "../../../styles/detail-interactions.wxss";
@import "../../../styles/skeleton.wxss";

page {
  background: var(--color-bg-card);
}

.page {
  box-sizing: border-box;
  min-height: 75vh;
  padding: 0 var(--page-padding);
  padding-bottom: calc(var(--space-xl) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
  color: var(--color-text-primary);
}

button::after {
  border: 0;
}

.article-header {
  padding: 40rpx 0 12rpx;
}

.category {
  margin-bottom: 14rpx;
  color: var(--article-accent, var(--color-primary));
  font-size: var(--font-sm);
  font-weight: var(--weight-semibold);
  overflow-wrap: anywhere;
}

.title {
  margin-bottom: 16rpx;
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 16rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-base);
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.publisher {
  color: var(--color-text-secondary);
  font-weight: var(--weight-medium);
}

.summary {
  margin-top: 26rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-md);
  line-height: 1.75;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.reader--news .article-header {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.reader--feature .article-header {
  margin: 22rpx calc(0px - var(--page-padding)) 0;
  padding: 32rpx var(--page-padding);
  background: var(--article-tint);
}

.reader--feature .summary {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.reader--resource {
  padding-top: var(--space-md);
  background: var(--color-bg-page);
}

.reader--resource .article-header {
  padding: 26rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  background: var(--article-tint);
}

.reader--resource .article-content {
  padding: 1rpx 26rpx;
  margin-top: var(--space-md);
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
}

.continue-button {
  width: 100%;
  margin: var(--space-sm) 0 var(--space-md);
  box-shadow: none;
}

.section-card {
  margin-top: var(--space-md);
  padding: var(--space-sm) 0;
  border-top: 1rpx solid var(--color-border);
}

.reader--resource .section-card {
  padding-left: var(--space-md);
  padding-right: var(--space-md);
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
}

.source-card,
.action-error,
.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.source-name {
  min-width: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-base);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.action-error,
.inline-error {
  flex-wrap: wrap;
  color: var(--color-danger);
  font-size: var(--font-base);
  line-height: 1.6;
}

.action-error {
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--color-border-light);
}

.inline-error {
  padding-top: var(--space-md);
}

.text-button {
  flex: none;
  min-height: 80rpx;
  margin: 0;
  padding: 0 8rpx;
  background: transparent;
  color: var(--article-accent, var(--color-primary));
  font-size: var(--font-sm);
  line-height: 80rpx;
}

.comments-card {
  padding-bottom: var(--space-md);
}

.article-skeleton {
  padding: var(--space-lg) 0;
}

.skeleton-category {
  width: 120rpx;
  height: 30rpx;
}

.skeleton-title {
  width: 96%;
  height: 48rpx;
  margin-top: var(--space-md);
}

.skeleton-title--short {
  width: 68%;
  margin-top: 14rpx;
}

.skeleton-meta {
  width: 42%;
  height: 26rpx;
  margin-top: var(--space-md);
}

.skeleton-summary {
  width: 100%;
  height: 100rpx;
  margin: var(--space-md) 0;
  border-radius: var(--radius-sm);
}

.skeleton-line {
  width: 100%;
  height: 28rpx;
  margin-top: var(--space-md);
}

.skeleton-line:nth-last-child(2) {
  width: 86%;
}

.skeleton-line:last-child {
  width: 56%;
}

@media (max-width: 340px) {
  .title {
    font-size: var(--font-xl);
  }

  .source-card {
    flex-wrap: wrap;
  }
}
