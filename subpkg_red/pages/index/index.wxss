.red-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.red-top {
  background: var(--color-bg-card);
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 16rpx;
}
.red-nav {
  position: relative;
  display: flex;
  align-items: center;
}
.red-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.red-nav__title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
}
.red-intro,
.red-directory-header {
  padding: 32rpx 30rpx 24rpx;
}
.red-eyebrow {
  font-size: 22rpx;
  color: var(--color-primary);
}
.red-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  line-height: 1.4;
  font-weight: 700;
}
.red-subtitle {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
}
.red-section-heading {
  padding: 24rpx 30rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 29rpx;
  font-weight: 600;
}
.red-meta {
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 400;
  flex-shrink: 0;
}
.red-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin: 0 30rpx;
}
.red-category {
  padding: 24rpx 14rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
}
.red-category__number {
  font-size: 23rpx;
  color: var(--color-primary);
}
.red-category__title {
  font-size: 28rpx;
  font-weight: 600;
  margin: 16rpx 0 10rpx;
  line-height: 1.4;
  overflow-wrap: break-word;
}
.red-links,
.red-about,
.red-directory {
  margin: 0 30rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.red-link {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 24rpx;
  font-size: 27rpx;
}
.red-link text {
  flex: 1;
}
.red-link + .red-link,
.red-topic + .red-topic {
  border-top: 1rpx solid var(--color-bg-page);
}
.red-about {
  margin-top: 28rpx;
}
.red-about__toggle {
  display: flex;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  font-size: 27rpx;
}
.red-structure {
  padding: 0 24rpx 24rpx;
}
.red-structure__title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.red-description {
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.7;
}
.red-switcher {
  margin: 0 30rpx 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}
.red-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 16rpx 8rpx;
  font-size: 23rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
}
.red-switch--active {
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: inset 0 0 0 2rpx var(--color-primary);
}
.red-topic__heading {
  padding: 28rpx 24rpx;
  display: flex;
  gap: 18rpx;
  align-items: center;
  justify-content: space-between;
}
.red-topic__title {
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.5;
}
.red-topic__detail {
  padding: 0 24rpx 26rpx;
}
.red-children {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}
.red-child {
  padding: 8rpx 16rpx;
  font-size: 23rpx;
  background: var(--color-bg-page);
  border-radius: var(--radius-md);
}
.red-pressed {
  opacity: 0.7;
}
.red-footnote {
  margin: 32rpx 30rpx 0;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
  text-align: center;
}
