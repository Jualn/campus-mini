.red-page {
  min-height: 100vh;
  background: #f8fafc;
  color: #1f2937;
}

.hero {
  padding: 92rpx 36rpx 42rpx;
  background: linear-gradient(135deg, #b91c1c 0%, #dc2626 58%, #f59e0b 100%);
  color: #ffffff;
}

.hero__eyebrow {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
}

.hero__title {
  margin-top: 24rpx;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.hero__subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.86);
}

.structure {
  padding: 24rpx 28rpx 4rpx;
}

.structure__item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #fee2e2;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.structure__index {
  width: 58rpx;
  height: 58rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #991b1b;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-align: center;
  flex-shrink: 0;
}

.structure__body {
  flex: 1;
  min-width: 0;
}

.structure__title {
  font-size: 29rpx;
  font-weight: 700;
  color: #7f1d1d;
}

.structure__summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #64748b;
}

.category-scroll {
  margin-top: 8rpx;
  background: #ffffff;
  border-top: 1rpx solid #f1f5f9;
  border-bottom: 1rpx solid #f1f5f9;
  white-space: nowrap;
}

.category-tabs {
  display: inline-flex;
  padding: 16rpx 22rpx;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 122rpx;
  height: 64rpx;
  margin-right: 14rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
}

.category-tab--active {
  background: #7f1d1d;
  border-color: #7f1d1d;
}

.category-tab__title {
  font-size: 26rpx;
  color: #475569;
}

.category-tab--active .category-tab__title {
  color: #ffffff;
  font-weight: 700;
}

.content {
  padding: 30rpx 28rpx 56rpx;
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.section-heading__title {
  font-size: 38rpx;
  font-weight: 700;
  color: #111827;
}

.section-heading__subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9f1239;
}

.section-heading__count {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #92400e;
  font-size: 22rpx;
  flex-shrink: 0;
}

.category-summary {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid #dc2626;
  background: #ffffff;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #475569;
}

.topic-list {
  margin-top: 24rpx;
}

.topic-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.05);
}

.topic-card:active {
  transform: scale(0.99);
}

.topic-card__main {
  display: flex;
  align-items: flex-start;
}

.topic-card__dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 15rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #dc2626;
  box-shadow: 0 0 0 8rpx #fee2e2;
  flex-shrink: 0;
}

.topic-card__body {
  flex: 1;
  min-width: 0;
}

.topic-card__title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.topic-card__title {
  font-size: 31rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.35;
}

.topic-card__tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  max-width: 210rpx;
}

.topic-card__tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fee2e2;
  color: #b91c1c;
  font-size: 20rpx;
}

.topic-card__summary {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #64748b;
}

.child-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-left: 36rpx;
}

.child-chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  color: #9a3412;
  font-size: 22rpx;
}

.selection {
  margin-top: 30rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: #111827;
  color: #ffffff;
}

.selection__label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.62);
}

.selection__title {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.selection__summary {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.78);
}
