/* subpkg_red/pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff1f2 0%, #fee2e2 45%, #fecaca 100%);
}

/* 头部 */
.header {
  padding: 88rpx 32rpx 38rpx;
  background: linear-gradient(135deg, #dc2626 0%, #b91c1c 55%, #991b1b 100%);
  box-shadow: 0 8rpx 24rpx rgba(185, 28, 28, 0.28);
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.header-subtitle {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

/* 横向分类 */
.menu-scroll {
  background: #ffffff;
  border-bottom: 1rpx solid #f1f5f9;
  white-space: nowrap;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
}

.menu-tabs {
  display: inline-flex;
  padding: 0 20rpx;
}

.menu-tab {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  padding: 24rpx 24rpx 22rpx;
}

.tab-title {
  font-size: 27rpx;
  color: #64748b;
  transition: all 0.2s ease;
}

.menu-tab.active .tab-title {
  color: #dc2626;
  font-size: 29rpx;
  font-weight: 700;
}

.tab-indicator {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 56rpx;
  height: 6rpx;
  background: #dc2626;
  border-radius: 999rpx;
  transform: translateX(-50%);
  animation: slideIn 0.22s ease;
}

@keyframes slideIn {
  from {
    width: 0;
    opacity: 0;
  }

  to {
    width: 56rpx;
    opacity: 1;
  }
}

/* 内容区域 */
.content-area {
  padding: 28rpx 28rpx 10rpx;
}

.section-title-wrap {
  margin-bottom: 24rpx;
  padding: 4rpx 4rpx 0;
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #7f1d1d;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9f1239;
}

.content-list {
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.content-item {
  margin-bottom: 22rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(254, 202, 202, 0.75);
  border-radius: 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(127, 29, 29, 0.08);
}

.content-item:active {
  transform: scale(0.985);
  box-shadow: 0 6rpx 16rpx rgba(127, 29, 29, 0.1);
}

.item-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-left {
  display: flex;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.item-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 14rpx;
  margin-right: 20rpx;
  background: #dc2626;
  border-radius: 50%;
  box-shadow: 0 0 0 8rpx rgba(220, 38, 38, 0.1);
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.item-name {
  font-size: 31rpx;
  font-weight: 650;
  color: #1f2937;
}

.item-tag {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #dc2626;
  background: #fee2e2;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.item-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #64748b;
}

.item-arrow {
  margin-left: 20rpx;
  font-size: 42rpx;
  line-height: 1;
  color: #cbd5e1;
}

/* 小类 */
.child-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
  padding-left: 34rpx;
}

.child-chip {
  padding: 10rpx 18rpx;
  background: #fff1f2;
  border: 1rpx solid #fecdd3;
  border-radius: 999rpx;
}

.child-chip:active {
  background: #ffe4e6;
}

.child-name {
  font-size: 23rpx;
  color: #9f1239;
}

/* 空状态 */
.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 320rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 底部 */
.footer {
  padding: 36rpx 40rpx 48rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #9ca3af;
}