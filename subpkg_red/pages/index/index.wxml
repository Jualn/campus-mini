<view class="red-page">
  <view class="hero">
    <view class="hero__eyebrow">红色阵地</view>
    <view class="hero__title">E 网同心</view>
    <view class="hero__subtitle">学习、服务、活动、实践一体化入口</view>
  </view>

  <view class="structure">
    <view
      class="structure__item"
      wx:for="{{structureItems}}"
      wx:key="id"
    >
      <view class="structure__index">0{{index + 1}}</view>
      <view class="structure__body">
        <view class="structure__title">{{item.title}}</view>
        <view class="structure__summary">{{item.summary}}</view>
      </view>
    </view>
  </view>

  <scroll-view class="category-scroll" scroll-x="true" show-scrollbar="false" enable-flex>
    <view class="category-tabs">
      <view
        class="category-tab {{activeCategoryKey === item.key ? 'category-tab--active' : ''}}"
        wx:for="{{categories}}"
        wx:key="key"
        bindtap="switchCategory"
        data-key="{{item.key}}"
      >
        <text class="category-tab__title">{{item.title}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="content">
    <view class="section-heading">
      <view>
        <view class="section-heading__title">{{currentCategory.title}}</view>
        <view class="section-heading__subtitle">{{currentCategory.subtitle}}</view>
      </view>
      <view class="section-heading__count">{{currentCategory.items.length}} 项</view>
    </view>

    <view class="category-summary">{{currentCategory.summary}}</view>

    <view class="topic-list">
      <view
        class="topic-card"
        wx:for="{{currentCategory.items}}"
        wx:key="id"
        bindtap="onTopicTap"
        data-id="{{item.id}}"
      >
        <view class="topic-card__main">
          <view class="topic-card__dot"></view>
          <view class="topic-card__body">
            <view class="topic-card__title-row">
              <text class="topic-card__title">{{item.title}}</text>
              <view class="topic-card__tags" wx:if="{{item.tags && item.tags.length}}">
                <text
                  class="topic-card__tag"
                  wx:for="{{item.tags}}"
                  wx:for-item="tag"
                  wx:key="*this"
                >{{tag}}</text>
              </view>
            </view>
            <view class="topic-card__summary">{{item.summary}}</view>
          </view>
        </view>

        <view class="child-list" wx:if="{{item.children && item.children.length}}">
          <view
            class="child-chip"
            wx:for="{{item.children}}"
            wx:for-item="child"
            wx:key="id"
          >{{child.title}}</view>
        </view>
      </view>
    </view>

    <view class="selection" wx:if="{{selectedItem}}">
      <view class="selection__label">当前选中</view>
      <view class="selection__title">{{selectedItem.title}}</view>
      <view class="selection__summary">{{selectedItem.summary}}</view>
    </view>
  </view>
</view>
