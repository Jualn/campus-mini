@import "../../../styles/skeleton.wxss";

.content-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--page-padding);
  padding-bottom: calc(var(--space-xl) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
  background: var(--color-bg-page);
  color: var(--color-text-primary);
}

button::after {
  border: 0;
}

.page-hero {
  padding: var(--space-lg);
  border: 1rpx solid var(--color-brand-red-light);
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--color-brand-red-tint), var(--color-bg-card) 72%);
}

.hero-kicker {
  color: var(--color-brand-red);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: var(--space-xs);
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  line-height: 1.4;
}

.hero-description {
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
  font-size: var(--font-md);
  line-height: 1.6;
}

.filter-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  margin-top: var(--space-md);
  padding: 20rpx var(--space-md);
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
}

.filter-label {
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-md);
}

.filter-control {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-xs);
  min-height: 64rpx;
  color: var(--color-primary);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
}

.list-heading {
  display: flex;
  align-items: center;
  margin: var(--space-lg) 0 var(--space-sm);
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
}

.list-heading::before {
  width: 6rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border-radius: var(--radius-full);
  background: var(--color-brand-red);
  content: "";
}

.card {
  display: block;
  margin-bottom: var(--space-sm);
  padding: 28rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-xs);
  transition:
    transform var(--transition-fast),
    background-color var(--transition-fast);
}

.card--pressed {
  background: var(--color-primary-tint);
  transform: scale(0.99);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--color-text-tertiary);
}

.category {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-xs);
  background: var(--color-brand-red-light);
  color: var(--color-brand-red-deep);
  font-size: var(--font-xs);
}

.title {
  margin-top: 16rpx;
  color: var(--color-text-primary);
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.summary {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: var(--font-md);
  line-height: 1.65;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.meta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border-light);
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
}

.publisher {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date {
  flex-shrink: 0;
  margin-left: var(--space-sm);
}

.inline-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin: var(--space-sm) 0;
  padding: 20rpx var(--space-md);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
  color: var(--color-danger);
  font-size: var(--font-base);
  line-height: 1.6;
}

.text-button {
  flex-shrink: 0;
  margin: 0;
  padding: 10rpx 0 10rpx 16rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: var(--font-base);
  line-height: 1.4;
}

.list-status {
  padding: var(--space-md);
  color: var(--color-text-tertiary);
  font-size: var(--font-base);
  text-align: center;
}

.more-button {
  width: 100%;
  margin: var(--space-sm) 0 0;
  box-shadow: none;
}

.list-end {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-lg) 0 var(--space-sm);
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
}

.list-end::before,
.list-end::after {
  flex: 1;
  height: 1rpx;
  background: var(--color-border);
  content: "";
}

.content-skeleton {
  margin-bottom: var(--space-sm);
  padding: 28rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
}

.skeleton-category {
  width: 112rpx;
  height: 32rpx;
}

.skeleton-title {
  width: 88%;
  height: 36rpx;
  margin-top: 20rpx;
}

.skeleton-line {
  width: 100%;
  height: 26rpx;
  margin-top: 18rpx;
}

.skeleton-line--short {
  width: 72%;
  margin-top: 12rpx;
}

.skeleton-meta {
  width: 44%;
  height: 24rpx;
  margin-top: var(--space-md);
}
