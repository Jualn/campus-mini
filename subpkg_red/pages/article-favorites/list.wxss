@import "../../../styles/skeleton.wxss";

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--page-padding);
  padding-bottom: calc(var(--space-xl) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
  background: var(--color-bg-page);
  color: var(--color-text-primary);
}

button::after {
  border: 0;
}

.page-hero {
  margin-bottom: var(--space-md);
  padding: var(--space-lg);
  border: 1rpx solid var(--color-brand-red-light);
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--color-brand-red-tint), var(--color-bg-card) 72%);
}

.hero-kicker {
  color: var(--color-brand-red);
  font-size: var(--font-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: var(--space-xs);
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  line-height: 1.4;
}

.hero-description {
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
  font-size: var(--font-md);
  line-height: 1.6;
}

.favorite-item {
  position: relative;
}

.favorite-footer,
.unavailable-card,
.article-skeleton {
  border: 1rpx solid var(--color-border-light);
  background: var(--color-bg-card);
}

.favorite-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin: 0 0 var(--space-md);
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
}

.favorite-date {
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
}

.remove-button {
  flex-shrink: 0;
  min-width: 144rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
  font-size: var(--font-base);
  line-height: 64rpx;
}

.remove-button[disabled] {
  background: var(--color-bg-page);
  color: var(--color-text-tertiary);
  opacity: 0.55;
}

.unavailable-card {
  margin-bottom: var(--space-sm);
  padding: var(--space-lg);
  border-radius: var(--radius-md);
}

.unavailable-badge {
  display: inline-flex;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-xs);
  background: var(--color-bg-page-deep);
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
}

.unavailable-title {
  margin-top: var(--space-sm);
  color: var(--color-text-primary);
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  line-height: 1.5;
}

.unavailable-description {
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
  font-size: var(--font-md);
  line-height: 1.65;
}

.inline-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin: var(--space-sm) 0;
  padding: 20rpx var(--space-md);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
  color: var(--color-danger);
  font-size: var(--font-base);
  line-height: 1.6;
}

.text-button {
  flex-shrink: 0;
  margin: 0;
  padding: 10rpx 0 10rpx 16rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: var(--font-base);
  line-height: 1.4;
}

.list-status {
  padding: var(--space-md);
  color: var(--color-text-tertiary);
  font-size: var(--font-base);
  text-align: center;
}

.more-button {
  width: 100%;
  margin: var(--space-sm) 0 0;
  box-shadow: none;
}

.list-end {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-lg) 0 var(--space-sm);
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
}

.list-end::before,
.list-end::after {
  flex: 1;
  height: 1rpx;
  background: var(--color-border);
  content: "";
}

.article-skeleton {
  display: flex;
  gap: var(--space-md);
  margin-bottom: var(--space-sm);
  padding: 28rpx;
  border-radius: var(--radius-md);
}

.skeleton-copy {
  flex: 1;
  min-width: 0;
}

.skeleton-category {
  width: 112rpx;
  height: 28rpx;
}

.skeleton-title {
  width: 92%;
  height: 36rpx;
  margin-top: 20rpx;
}

.skeleton-line {
  width: 100%;
  height: 26rpx;
  margin-top: 18rpx;
}

.skeleton-line--short {
  width: 68%;
  margin-top: 12rpx;
}

.skeleton-cover {
  flex-shrink: 0;
  width: 176rpx;
  height: 140rpx;
}

@media (max-width: 340px) {
  .skeleton-cover {
    display: none;
  }

  .favorite-footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .remove-button {
    width: 100%;
  }
}
