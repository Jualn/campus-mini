@import "../../styles/skeleton.wxss";

.home-page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  /* One continuous page-level color field. Its stops are positioned in rpx,
     so the red header fades into the neutral reading surface without a seam. */
  background: linear-gradient(
    180deg,
    #b72d42 0rpx,
    #c13a4d 260rpx,
    #ca4054 500rpx,
    #d75f70 630rpx,
    #e6a0ad 765rpx,
    #f0dae2 900rpx,
    #f6f8fc 1080rpx,
    #f6f8fc 100%
  );
  color: var(--color-text-primary);
}

.home-masthead {
  position: relative;
  padding-right: 24rpx;
  padding-bottom: 28rpx;
  padding-left: 24rpx;
  /* Keep only a slight upper glow; the page owns the red-to-white fade. */
  background: radial-gradient(
    circle at 94% 0%,
    rgba(255, 218, 224, 0.12) 0%,
    rgba(255, 218, 224, 0) 48%
  );
}

.home-nav {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.home-brand {
  display: flex;
  align-items: center;
  min-width: 0;
  color: var(--color-text-inverse);
}

.home-brand__mark {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-right: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 17rpx;
  background: linear-gradient(155deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.1));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
  font-size: 30rpx;
  font-weight: var(--weight-bold);
  line-height: 1;
}

.home-brand__name,
.home-brand__tagline {
  display: block;
}

.home-brand__name {
  font-size: 30rpx;
  font-weight: var(--weight-semibold);
  line-height: 1.25;
  letter-spacing: 1rpx;
}

.home-brand__tagline {
  margin-top: 3rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 19rpx;
  line-height: 1.2;
}

.home-masthead__caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 4rpx 16rpx;
  color: var(--color-text-inverse);
}

.home-masthead__caption text {
  font-size: 28rpx;
  font-weight: var(--weight-semibold);
}

.home-hero__position {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.home-hero__dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.48);
}

.home-hero__dot--active {
  width: 24rpx;
  background: var(--color-text-inverse);
}

.home-hero {
  width: 100%;
  overflow: hidden;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(91, 28, 48, 0.12);
}

.home-hero--featured,
.home-hero--skeleton {
  display: block;
  height: 360rpx;
  background: var(--color-bg-card);
}

.home-feature {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  background: var(--color-bg-card);
}

.home-feature--pressed {
  opacity: 0.95;
}

.home-feature__visual {
  position: relative;
  flex: none;
  width: 100%;
  height: 238rpx;
  overflow: hidden;
}

.home-feature__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background:
    radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.72) 0 48rpx, transparent 50rpx),
    linear-gradient(120deg, var(--color-brand-red-light), var(--color-primary-tint));
}

.home-feature__media {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.home-feature__label {
  position: absolute;
  top: 18rpx;
  left: 20rpx;
  padding: 5rpx 14rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  color: var(--color-brand-red-deep);
  font-size: 20rpx;
  font-weight: var(--weight-semibold);
  line-height: 1.4;
}

.home-feature__copy {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
}

.home-feature__title {
  flex: 1;
  min-width: 0;
  color: var(--color-text-primary);
  font-size: 30rpx;
  font-weight: var(--weight-bold);
  line-height: 1.4;
  overflow-wrap: break-word;
}

.home-feature__arrow {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary-tint);
}

.home-hero__skeleton-copy {
  padding: 32rpx 24rpx;
}

.home-hero__skeleton-title {
  width: 80%;
  height: 24rpx;
}

.home-hero__skeleton-title--short {
  width: 54%;
  margin-top: 12rpx;
}

.home-hero--error,
.home-hero--empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  /* Error/empty copy is white; keep sufficient contrast against a dark surface. */
  background: linear-gradient(135deg, #a92a3a, #c74858);
  text-align: center;
}

.home-hero--empty {
  background: rgba(255, 255, 255, 0.94);
}

.home-hero--empty .home-hero__state-title {
  color: var(--color-text-secondary);
  font-size: 25rpx;
}

.home-hero__state-title {
  color: var(--color-text-inverse);
  font-size: 30rpx;
  font-weight: var(--weight-semibold);
  line-height: 1.5;
}

.home-hero__state-copy {
  max-width: 520rpx;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  line-height: 1.65;
}

.home-hero__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 176rpx;
  min-height: 68rpx;
  margin-top: 26rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  color: var(--color-brand-red-deep);
  font-size: 24rpx;
  font-weight: var(--weight-semibold);
}

.home-body {
  position: relative;
  z-index: 1;
  padding: 0 24rpx;
}

.home-quick-nav {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 24rpx;
  padding: 18rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow:
    0 12rpx 32rpx rgba(91, 73, 104, 0.065),
    0 4rpx 16rpx rgba(142, 75, 99, 0.035),
    inset 0 1rpx 0 rgba(255, 255, 255, 1);
}

.home-quick-nav__item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-width: 0;
  min-height: 134rpx;
  padding: 10rpx 4rpx;
  border-radius: 20rpx;
}

.home-quick-nav__item--pressed {
  background: var(--color-primary-soft);
  opacity: 0.78;
}

.home-quick-nav__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid var(--color-border-light);
  border-radius: 22rpx;
  background: var(--color-primary-tint);
  color: var(--color-primary-deep);
  font-size: 27rpx;
  font-weight: var(--weight-bold);
  line-height: 1;
}

.home-quick-nav__icon--red {
  border-color: rgba(196, 59, 74, 0.1);
  background: var(--color-brand-red-light);
  color: var(--color-brand-red);
}

.home-quick-nav__icon--blue {
  border-color: rgba(36, 105, 189, 0.1);
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.home-quick-nav__label {
  max-width: 100%;
  color: var(--color-text-primary);
  font-size: 23rpx;
  line-height: 1.35;
  text-align: center;
  white-space: nowrap;
}

.home-refreshing {
  padding: 20rpx 0 0;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  text-align: center;
}

.home-section {
  margin-top: 34rpx;
}

.home-section__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.home-section__title,
.home-section__subtitle {
  display: block;
}

.home-section__title {
  display: flex;
  align-items: center;
  color: var(--color-text-primary);
  font-size: 31rpx;
  font-weight: var(--weight-bold);
  line-height: 1.4;
}

.home-section__title::before {
  flex-shrink: 0;
  width: 6rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border-radius: 6rpx;
  background: var(--color-brand-red);
  content: "";
}

.home-section__subtitle {
  margin-top: 4rpx;
  color: var(--color-text-tertiary);
  font-size: 21rpx;
  font-weight: var(--weight-regular);
  line-height: 1.4;
}

.home-section__more {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  align-self: stretch;
  margin-left: 16rpx;
  color: var(--color-primary-deep);
  font-size: 23rpx;
}

.home-news-list,
.home-activity-list {
  overflow: hidden;
  border: 1rpx solid var(--color-border-light);
  border-radius: 26rpx;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-xs);
}

.home-news-card {
  position: relative;
  display: flex;
  gap: 20rpx;
  min-height: 196rpx;
  padding: 24rpx;
  background: var(--color-bg-card);
}

.home-news-card::before {
  position: absolute;
  top: 28rpx;
  left: 0;
  width: 4rpx;
  height: 42rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: var(--color-brand-red);
  content: "";
}

.home-news-card + .home-news-card,
.home-news-skeleton + .home-news-skeleton {
  border-top: 1rpx solid var(--color-hairline);
}

.home-news-card__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.home-news-card__title {
  font-size: 28rpx;
  font-weight: var(--weight-semibold);
  line-height: 1.48;
  overflow-wrap: break-word;
}

.home-news-card__summary {
  margin-top: 7rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
  overflow-wrap: break-word;
}

.home-news-card__meta {
  margin-top: auto;
  padding-top: 12rpx;
  overflow: hidden;
  color: var(--color-text-tertiary);
  font-size: 20rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-news-card__media {
  flex-shrink: 0;
  align-self: center;
  width: 196rpx;
  height: 158rpx;
  border-radius: 18rpx;
  background: var(--color-bg-page-deep);
}

.home-media-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  color: var(--color-text-tertiary);
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.home-news-skeleton {
  display: flex;
  gap: 20rpx;
  padding: 26rpx 24rpx;
}

.home-news-skeleton__copy {
  flex: 1;
  min-width: 0;
  padding-top: 6rpx;
}

.home-news-skeleton__media {
  flex-shrink: 0;
  width: 196rpx;
  height: 148rpx;
  border-radius: 18rpx;
}

.home-skeleton-line {
  width: 94%;
  height: 26rpx;
  margin-bottom: 16rpx;
}

.home-skeleton-line--medium {
  width: 72%;
}

.home-skeleton-line--meta {
  width: 42%;
  height: 20rpx;
  margin-top: 10rpx;
}

.home-activity-card {
  display: flex;
  gap: 22rpx;
  padding: 22rpx;
  background: var(--color-bg-card);
}

.home-activity-card + .home-activity-card,
.home-activity-skeleton + .home-activity-skeleton {
  border-top: 1rpx solid var(--color-hairline);
}

.home-activity-card__media {
  flex-shrink: 0;
  width: 210rpx;
  height: 204rpx;
  border-radius: 20rpx;
  background: var(--color-bg-page-deep);
}

.home-activity-card__media--fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx;
  color: var(--color-primary);
  font-size: 20rpx;
  text-align: center;
}

.home-activity-card__copy {
  flex: 1;
  min-width: 0;
  padding: 3rpx 0;
}

.home-activity-card__labels {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.home-activity-card__stage {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 19rpx;
  line-height: 1.4;
}

.home-activity-card__stage--ongoing {
  background: rgba(32, 183, 107, 0.11);
  color: #138353;
}

.home-activity-card__stage--not_started {
  background: var(--color-primary-tint);
  color: var(--color-primary-deep);
}

.home-activity-card__title {
  font-size: 28rpx;
  font-weight: var(--weight-semibold);
  line-height: 1.45;
  overflow-wrap: break-word;
}

.home-activity-card__detail {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 11rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
  line-height: 1.5;
}

.home-activity-card__detail ui-icon {
  flex-shrink: 0;
  margin-top: 3rpx;
}

.home-activity-card__detail text {
  min-width: 0;
  overflow-wrap: break-word;
}

.home-activity-skeleton {
  display: flex;
  gap: 22rpx;
  padding: 24rpx;
}

.home-activity-skeleton__media {
  flex-shrink: 0;
  width: 210rpx;
  height: 180rpx;
  border-radius: 20rpx;
}

.home-activity-skeleton__copy {
  flex: 1;
  min-width: 0;
  padding-top: 10rpx;
}

.home-footnote {
  margin: 34rpx 20rpx 0;
  color: var(--color-text-tertiary);
  font-size: 20rpx;
  line-height: 1.65;
  text-align: center;
}

.home-card--pressed,
.home-pressed {
  opacity: 0.68;
}

@media (max-width: 340px) {
  .home-news-card__media,
  .home-news-skeleton__media {
    width: 174rpx;
  }

  .home-activity-card__media,
  .home-activity-skeleton__media {
    width: 184rpx;
  }

  .home-quick-nav__label {
    font-size: 21rpx;
  }

  .home-feature__copy {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }
}
