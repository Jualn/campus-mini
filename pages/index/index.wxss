@import "../../styles/skeleton.wxss";

/* ========== 基础 ========== */
.index-page {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ========== 新增：顶部保护层 ========== */
.nav-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 99;
  /* 层级要高，盖住下面滚上来的 Feed，但要在弹窗之下 */
  background: transparent;
  transition: background-color 0.3s ease;
}

/* 滚动后显示纯白背景（可选：你也可以加一点毛玻璃 backdrop-filter） */
.nav-mask--show {
  background: rgba(255, 255, 255, 0.98);
}

/* ========== Header 区 ========== */
.home-header {
  background: var(--color-bg-card);
  padding-bottom: 30rpx;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: var(--shadow-md);
}

/* 搜索区域 */
.search-section {
  padding: 20rpx 30rpx;
}

.user-greet {
  margin-bottom: 20rpx;
}

.greet-text {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--color-text-primary);
  display: block;
}

.sub-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.search-box {
  height: 80rpx;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.search-box--hover {
  transform: scale(0.995);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.search-box__icon-wrap {
  position: relative;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  background: rgba(47, 124, 246, 0.09);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-box__icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
  opacity: 0.86;
  flex-shrink: 0;
}

.search-box__placeholder {
  flex: 1;
}

/* 考试卡片流 */
.exam-section {
  margin-top: 10rpx;
}

.section-title {
  padding: 0 30rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-text-primary);
}

.more-link {
  font-size: 24rpx;
  color: var(--color-primary);
}

.exam-scroll {
  white-space: nowrap;
  padding-left: 30rpx;
  display: flex;
  height: 200rpx;
  width: 96%;
}

.exam-card {
  flex-shrink: 0;
  width: 280rpx;
  height: 180rpx;
  margin-right: 20rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.exam-name {
  font-size: 30rpx;
  font-weight: bold;
  z-index: 2;
}

.exam-date {
  font-size: 20rpx;
  opacity: 0.8;
  z-index: 2;
}

.exam-countdown {
  font-size: 24rpx;
  z-index: 2;
}

.exam-countdown .days {
  font-size: 40rpx;
  font-weight: 800;
}

/* 卡片装饰图标 */
.card-bg-icon {
  position: absolute;
  right: -10rpx;
  bottom: -10rpx;
  width: 178rpx;
  height: 178rpx;
  opacity: 0.2;
  transform: rotate(-15deg);
}

/* 卡片颜色
 * 原 red/green 使用非标准色值（red 起始偏橙，green 起始近白），
 * 此处统一与 subpkg_exam 页面使用相同渐变，保持全局一致。
 * 如需恢复原值：red 改为 #fda085→rgb(255,80,80)，green 改为 #F5F5F5→rgb(80,255,80)。
 */
.blue {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.red {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.orange {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
}

.purple {
  background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%);
}

.green {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.indigo {
  background: linear-gradient(135deg, #5b86e5 0%, #36d1dc 100%);
}

.gold {
  background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%);
}

.yellow {
  background: linear-gradient(135deg, #fce38a 0%, #f38181 100%);
}

.amber {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
}

.slate {
  background: linear-gradient(135deg, #bdc3c7 0%, #2c3e50 100%);
}

.cyan {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

/* 快捷入口 */
.quick-nav {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.nav-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.act {
  background: var(--color-primary-light);
}

.exam {
  background: var(--color-primary-light);
}

.nav-item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ========== Feed Tab ========== */
/*
 * feed-header 设为 sticky，z-index 低于 home-header（50）。
 * 当 home-header 滑出（--hidden）后，feed-header 会在顶部"接力"，
 * 让用户在 feed 模式下始终能看到 tab 切换栏。
 *
 * 如需取消此行为，移除 position/top/z-index/box-shadow 四行即可。
 */
.feed-header {
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  padding: 0 30rpx;
  margin-top: 16rpx;
  border-radius: 24rpx 24rpx 0 0;
  position: sticky;
  z-index: 49;
  /* 层级低于 nav-mask */
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  /* 稍微调整阴影，让吸顶更柔和 */
  transform: translateY(0);
  transition: transform 0.35s cubic-bezier(0.23, 1, 0.32, 1);
}

.home-header--hidden {
  transform: translateY(calc(-100% - 40rpx));
}

.feed-tab {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  padding: 28rpx 24rpx;
  position: relative;
}

.feed-tab.active {
  font-size: 30rpx;
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.feed-tab.active::after {
  content: "";
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

/* ========== 帖子卡片 ========== */
.post-card {
  display: flex;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
}

.post-left {
  width: 80rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eee;
}

.post-right {
  flex: 1;
  min-width: 0;
}

/* 顶部一行：昵称 · handle · 时间 */
.post-top-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.post-user {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}

.post-nickname {
  max-width: 320rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-time {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.post-more {
  /* flex 布局中固定右侧元素的标准做法 */
  margin-left: auto;
}

.more-dot {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}

.post-body {
  margin: 10rpx 0;
}

.post-text {
  font-size: 30rpx;
  color: var(--color-text-primary);
  line-height: 1.7;
  /* 超过5行折叠，配合 JS 展开 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 交互按钮 */
.post-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 20rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-right: 56rpx;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  position: relative;
}

.action-count {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  min-width: 32rpx;
}

.icon {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  transition: all 0.25s ease;
}

/* 默认状态 */
.like {
  opacity: 1;
}

.liked-icon {
  opacity: 0;
  transform: scale(0.7);
}

/* 点赞后 */
.liked .like {
  opacity: 0;
  transform: scale(0.7);
}

.liked .liked-icon {
  opacity: 1;
  transform: scale(1.1);
  animation: likePop 0.3s;
}

@keyframes likePop {
  0% {
    transform: scale(0.6);
  }

  60% {
    transform: scale(1.2);
  }

  100% {
    transform: scale(1);
  }
}

/* 全屏透明拦截层，只拦截触摸，不影响视觉 */
.popup-touch-blocker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  /* 只覆盖遮罩区域（上方 30vh），面板区域由组件自己处理 */
  height: 20vh;
  z-index: 800;
  /* 在 page-container（900）下   一层，但在页面内容上面 */
  background: transparent;
}

/* ========== 活动插片 ========== */
.activity-section {
  background: var(--color-bg-card);
  margin-bottom: 16rpx;
  padding: 28rpx 0 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 20rpx;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-text-primary);
}

.section-more {
  font-size: 24rpx;
  color: var(--color-primary);
}

.activity-scroll {
  display: flex;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.activity-card {
  display: inline-flex;
  flex-direction: column;
  width: 360rpx;
  margin-right: 20rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-md);
  flex-shrink: 0;
}

.act-poster {
  width: 100%;
  height: 200rpx;
}

.act-info {
  padding: 16rpx 20rpx;
}

.act-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: normal;
  line-height: 1.4;
}

/* =====================================================
   FAB 发布按钮
   ===================================================== */

/* 遮罩 */
.fab-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 899;
  pointer-events: none;
  transition: background 0.25s;
}

.fab-mask--show {
  background: rgba(0, 0, 0, 0.35);
  pointer-events: auto;
}

/* 展开菜单 */
.fab-menu {
  position: fixed;
  right: 40rpx;
  z-index: 900;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 20rpx;
  pointer-events: none;
  opacity: 0;
  transform: translateY(20rpx);
  transition:
    opacity 0.2s,
    transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.fab-menu--show {
  pointer-events: auto;
  opacity: 1;
  transform: translateY(0);
}

.fab-menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 48rpx;
  padding: 14rpx 28rpx 14rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.2s;
}

.fab-menu-item__icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-menu-item__icon-wrap--blue {
  background: var(--color-primary-light);
}

.fab-menu-item__icon-wrap--orange {
  background: #fff4eb;
}

.fab-menu-item__icon {
  font-size: 32rpx;
}

.fab-menu-item__label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: nowrap;
}

/* FAB 主按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 901;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.4);
  transition:
    transform 0.35s cubic-bezier(0.23, 1, 0.32, 1),
    opacity 0.35s cubic-bezier(0.23, 1, 0.32, 1);
  transform: translateY(0);
  opacity: 1;
}

.fab--hidden {
  transform: translateY(200rpx);
  opacity: 0;
  pointer-events: none;
}

/* 展开状态：旋转变 ✕，颜色加深 */
.fab--open {
  background: var(--color-primary);
  transform: rotate(45deg);
}

.fab__icon {
  font-size: 50rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}
/* =====================================================
   页面加载与数据状态
   - 首屏：使用与真实布局接近的骨架，减少内容出现时的位移
   - 刷新：保留现有内容，仅展示轻量进度
   - 分页：在列表底部原位反馈，失败后由用户主动重试
   ===================================================== */

/* 内容完成加载后做一次很轻的淡入，避免骨架与真内容生硬切换 */
.content-ready {
  animation: contentFadeIn 0.22s ease-out both;
}

@keyframes contentFadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

.initial-load-placeholder {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ---------- 首屏骨架 ---------- */
.skeleton-page {
  min-height: 100vh;
  overflow: hidden;
  background: var(--color-bg-page);
}

.skeleton-header {
  padding-bottom: 30rpx;
  overflow: hidden;
  background: var(--color-bg-card);
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: var(--shadow-md);
}

.skeleton-search-section {
  padding-right: 30rpx;
  padding-bottom: 20rpx;
  padding-left: 30rpx;
}

/* 骨架颜色、动画、圆角来自 styles/skeleton.wxss；这里仅保留首页专属布局尺寸。 */
.skeleton-exam-card,
.skeleton-search-box {
  background: var(--skeleton-container);
}

.skeleton-greet {
  width: 190rpx;
  height: 42rpx;
  border-radius: 12rpx;
}

.skeleton-subtitle {
  width: 250rpx;
  height: 24rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
}

.skeleton-search-box {
  display: flex;
  align-items: center;
  height: 80rpx;
  margin-top: 26rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
}

.skeleton-search-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 50%;
}

.skeleton-search-text {
  width: 280rpx;
  height: 24rpx;
  margin-left: 16rpx;
  border-radius: 8rpx;
}

.skeleton-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 30rpx 20rpx;
}

.skeleton-title-main {
  width: 132rpx;
  height: 30rpx;
  border-radius: 9rpx;
}

.skeleton-title-more {
  width: 112rpx;
  height: 22rpx;
  border-radius: 8rpx;
}

.skeleton-exam-list {
  display: flex;
  width: 100%;
  padding-left: 30rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.skeleton-exam-card {
  width: 280rpx;
  height: 180rpx;
  margin-right: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
}

.skeleton-exam-name {
  width: 132rpx;
  height: 30rpx;
  border-radius: 9rpx;
}

.skeleton-exam-date {
  width: 170rpx;
  height: 20rpx;
  margin-top: 28rpx;
  border-radius: 7rpx;
}

.skeleton-exam-countdown {
  width: 118rpx;
  height: 34rpx;
  margin-top: 26rpx;
  border-radius: 9rpx;
}

.skeleton-quick-nav {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.skeleton-quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.skeleton-quick-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 30rpx;
}

.skeleton-quick-label {
  width: 96rpx;
  height: 22rpx;
  margin-top: 14rpx;
  border-radius: 7rpx;
}

.skeleton-feed-header {
  display: flex;
  align-items: center;
  height: 86rpx;
  margin-top: 16rpx;
  padding: 0 54rpx;
  background: var(--color-bg-card);
  border-radius: 24rpx 24rpx 0 0;
}

.skeleton-feed-title {
  width: 122rpx;
  height: 30rpx;
  border-radius: 9rpx;
}

/* ---------- 刷新态 ---------- */
.refresh-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 64rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border-light);
}

/* ---------- 分页与底部状态 ---------- */
.list-footer {
  min-height: 150rpx;
  padding: 34rpx 30rpx 120rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.footer-status,
.footer-end {
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-status {
  gap: 14rpx;
}

.state-spinner {
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border: 3rpx solid rgba(47, 124, 246, 0.18);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: stateSpin 0.75s linear infinite;
}

.state-spinner--small {
  width: 24rpx;
  height: 24rpx;
  border-width: 3rpx;
}

@keyframes stateSpin {
  to {
    transform: rotate(360deg);
  }
}

.footer-end {
  width: 100%;
  gap: 18rpx;
}

.footer-end__line {
  width: 72rpx;
  height: 1rpx;
  background: var(--color-border);
}
