/* ========== 基础 ========== */
.index-page {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ========== Header 区 ========== */
.home-header {
  background: var(--color-bg-card);
  padding-bottom: 30rpx;
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  box-shadow: var(--shadow-md);
}

/* 搜索区域 */
.search-section {
  padding: 20rpx var(--page-padding);
}

.user-greet {
  margin-bottom: 20rpx;
}

.greet-text {
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  display: block;
}

.sub-text {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.search-box {
  height: 80rpx;
  background: var(--color-bg-input);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  padding: 0 var(--page-padding);
  color: var(--color-text-tertiary);
  font-size: var(--font-md);
}

/* 考试卡片流 */
.exam-section {
  margin-top: 10rpx;
}

.section-title {
  padding: 0 var(--page-padding) 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.more-link {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

.exam-scroll {
  white-space: nowrap;
  padding-left: var(--page-padding);
  display: flex;
  height: 200rpx;
  width: 96%;
}

.exam-card {
  flex-shrink: 0;
  width: 280rpx;
  height: 180rpx;
  margin-right: 20rpx;
  border-radius: var(--radius-md);
  padding: var(--space-md);
  position: relative;
  overflow: hidden;
  color: var(--color-text-inverse);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.exam-name {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  z-index: 2;
}

.exam-date {
  font-size: 20rpx;
  opacity: 0.8;
  z-index: 2;
}

.exam-countdown {
  font-size: var(--font-sm);
  z-index: 2;
}

.exam-countdown .days {
  font-size: var(--font-xl);
  font-weight: 800;
}

/* 卡片装饰图标 */
.card-bg-icon {
  position: absolute;
  right: -10rpx;
  bottom: -10rpx;
  font-size: 80rpx;
  opacity: 0.2;
  transform: rotate(-15deg);
}

/* 卡片颜色 */
.blue {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.red {
  background: linear-gradient(135deg, #fda085 0%, rgb(255, 80, 80) 100%);
}

.orange {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
}

.purple {
  background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%);
}

.green {
  background: linear-gradient(135deg, #F5F5F5 0%, rgb(80, 255, 80) 100%);
}

/* 快捷入口 */
.quick-nav {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.nav-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.act {
  background: var(--color-primary-light);
}

.exam {
  background: #FFF2E8;
}


/* ========== Feed Tab ========== */
.feed-header {
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  padding: 0 var(--page-padding);
  margin-top: var(--space-sm);
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  position: relative;
}

.feed-tab {
  font-size: var(--font-md);
  color: var(--color-text-tertiary);
  padding: 28rpx var(--space-md);
  position: relative;
}

.feed-tab.active {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.feed-tab.active::after {
  content: '';
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}


/* ========== 帖子卡片 ========== */
.post-card {
  display: flex;
  padding: var(--space-md) var(--page-padding);
  border-bottom: 1rpx solid var(--color-border-light);
  background: var(--color-bg-card);
}

.post-left {
  width: 80rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-bg-input);
}

.post-right {
  flex: 1;
  min-width: 0;
}

/* 顶部一行：昵称 · handle · 时间 */
.post-top-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.post-user {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}

.post-nickname {
  max-width: 320rpx;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-time {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.post-more {
  margin-left: auto;
}

.more-dot {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}

.post-body {
  margin: 10rpx 0;
}

.post-text {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 交互按钮 */
.post-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-sm) 0 20rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-right: 56rpx;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  position: relative;
}

.action-count {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  min-width: 32rpx;
}

.icon {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  transition: all 0.25s ease;
}

/* 默认状态 */
.like {
  opacity: 1;
}

.liked-icon {
  opacity: 0;
  transform: scale(0.7);
}

/* 点赞后 */
.liked .like {
  opacity: 0;
  transform: scale(0.7);
}

.liked .liked-icon {
  opacity: 1;
  transform: scale(1.1);
}

.liked .liked-icon {
  opacity: 1;
  animation: likePop 0.3s;
}

@keyframes likePop {
  0% {
    transform: scale(0.6);
  }

  60% {
    transform: scale(1.2);
  }

  100% {
    transform: scale(1);
  }
}

/* ========== 列表底部 ========== */
.list-footer {
  padding: 50rpx 0 120rpx;
  display: flex;
  justify-content: center;
}

.footer-text {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}


/* 全屏透明拦截层，只拦截触摸，不影响视觉 */
.popup-touch-blocker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 20vh;
  z-index: 800;
  background: transparent;
}

/* 头像下方串联线 */
.thread-line {
  flex: 1;
  width: 4rpx;
  background: var(--color-border);
  margin: 10rpx 0;
}

/* ========== 活动插片 ========== */
.activity-section {
  background: var(--color-bg-card);
  margin-bottom: var(--space-sm);
  padding: 28rpx 0 var(--space-md);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 var(--page-padding) 20rpx;
}

.section-title-text {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
}

.section-more {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

.activity-scroll {
  display: flex;
  padding: 0 var(--page-padding);
  box-sizing: border-box;
}

.activity-card {
  display: inline-flex;
  flex-direction: column;
  width: 360rpx;
  margin-right: 20rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-md);
  flex-shrink: 0;
}

.act-poster {
  width: 100%;
  height: 200rpx;
}

.act-info {
  padding: var(--space-sm) 20rpx;
}

.act-name {
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  white-space: normal;
  line-height: 1.4;
}

/* =====================================================
   FAB 发布按钮
   ===================================================== */

/* 遮罩 */
.fab-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 899;
  pointer-events: none;
  transition: background 0.25s;
}

.fab-mask--show {
  background: rgba(0, 0, 0, 0.35);
  pointer-events: auto;
}

/* 展开菜单 */
.fab-menu {
  position: fixed;
  right: 40rpx;
  z-index: 900;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 20rpx;
  pointer-events: none;
  opacity: 0;
  transform: translateY(20rpx);
  transition: opacity 0.2s, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.fab-menu--show {
  pointer-events: auto;
  opacity: 1;
  transform: translateY(0);
}

.fab-menu-item {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 14rpx 28rpx 14rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: transform var(--transition-fast);
}

.fab-menu-item__icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-menu-item__icon-wrap--blue {
  background: var(--color-primary-light);
}

.fab-menu-item__icon-wrap--orange {
  background: #FFF4EB;
}

.fab-menu-item__icon {
  font-size: var(--font-lg);
}

.fab-menu-item__label {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  white-space: nowrap;
}

/* FAB 主按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 901;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.4);
  transition:
    transform 0.35s cubic-bezier(0.23, 1, 0.32, 1),
    opacity 0.35s cubic-bezier(0.23, 1, 0.32, 1);
  transform: translateY(0);
  opacity: 1;
}

.fab--hidden {
  transform: translateY(200rpx);
  opacity: 0;
  pointer-events: none;
}

/* 展开状态：旋转变 ✕，颜色加深 */
.fab--open {
  background: var(--color-primary-dark);
  transform: rotate(45deg);
}

.fab__icon {
  font-size: 52rpx;
  color: var(--color-text-inverse);
  font-weight: 300;
  line-height: 1;
}
