/* pages/me/me.wxss */
page {
  background: var(--color-bg-page);
}

.page {
  min-height: 100vh;
  background: var(--color-bg-page);
}

.list-footer {
  padding: 50rpx 0 120rpx;
  display: flex;
  justify-content: center;
}

.footer-text {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.popup-touch-blocker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  /* 只覆盖遮罩区域（上方 20vh），面板区域由组件自己处理 */
  height: 20vh;
  z-index: 800;
  background: transparent;
}
