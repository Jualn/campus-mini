<!-- pages/me/index.wxml -->
<view class="page">

  <!-- 首屏加载：phase 阻断真实内容，skeletonVisible 只控制是否显示骨架，避免快速接口闪屏 -->
  <block wx:if="{{listLoad.phase === 'initial'}}">
    <profile-feed-skeleton
      wx:if="{{listLoad.skeletonVisible}}"
      type="me"
      status-bar-height="{{statusBarHeight}}"
      post-count="{{3}}"
      media-mode="auto"
    />
  </block>

  <!-- 首屏失败 -->
  <view wx:elif="{{listLoad.initialError}}" class="state-wrap">
    <text class="state-title">加载失败</text>
    <text class="state-desc">个人主页加载失败，请稍后重试</text>
    <view class="state-btn" bindtap="retryInitial">重新加载</view>
  </view>

  <block wx:else>
    <user-profile
      is-self="{{true}}"
      user-info="{{userInfo}}"
      active-tab="{{activeTab}}"
      status-bar-height="{{statusBarHeight}}"
      bind:switchtab="onSwitchTab"
    />

    <!-- likes tab 首次加载：只加载列表区域，不重置 user-profile -->
    <post-card-skeleton
      wx:if="{{activeTab === 'likes' && likesLoading}}"
      count="{{2}}"
      media-mode="auto"
      show-third-line="{{true}}"
    />

    <!-- likes tab 加载失败 -->
    <view
      wx:elif="{{activeTab === 'likes' && likesError}}"
      class="state-wrap state-wrap--list"
    >
      <text class="state-title">加载失败</text>
      <text class="state-desc">点赞列表加载失败</text>
      <view class="state-btn" bindtap="retryLikes">重试</view>
    </view>

    <!-- 列表内容 -->
    <block wx:elif="{{posts.length > 0}}">
      <block wx:for="{{posts}}" wx:key="id" wx:for-item="post">
        <post-card
          post="{{post}}"
          bind:comment="onOpenComment"
          bind:view="onPostView"
          bind:share="onOpenShare"
          bind:shareImageReady="onShareImageReady"
          bind:more="onPostCardMore"
        />
      </block>
    </block>

    <!-- 空态 -->
    <view wx:else class="empty-wrap">
      <text class="empty-title">
        {{activeTab === 'posts' ? '还没有发布动态' : '还没有点赞内容'}}
      </text>
    </view>

    <!-- 分页加载 -->
    <post-card-skeleton
      wx:if="{{listLoad.loadingMore}}"
      count="{{2}}"
      media-mode="auto"
    />

    <!-- 分页失败 -->
    <view
      wx:if="{{listLoad.loadMoreError}}"
      class="list-footer list-footer--retry"
      bindtap="retryLoadMore"
    >
      <text class="footer-text">加载失败，点击重试</text>
    </view>

    <!-- 没有更多 -->
    <view
      wx:if="{{!listLoad.loadingMore && !listLoad.loadMoreError && !listLoad.hasMore && posts.length > 0}}"
      class="list-footer"
    >
      <text class="footer-text">— 已经到底啦 —</text>
    </view>
  </block>

</view>

<page-container
  show="{{showPopup}}"
  position="bottom"
  round
  overlay="{{false}}"
  close-on-slide-down="{{false}}"
  z-index="999"
  bind:leave="onPopupLeave"
>
  <comment-panel
    wx:if="{{popupType==='comment'}}"
    mode="sheet"
    target-id="{{commentTargetId}}"
    target-type="{{commentTargetType}}"
    total-count="{{commentTotalCount}}"
    visible="{{showPopup && popupType === 'comment'}}"
    bind:close="onCommentClose"
    bind:countchange="onCommentCountChange"
    bind:report="onCommentReport"
  />

  <share-panel
    wx:elif="{{popupType==='share'}}"
    share-path="{{currentSharePath}}"
    share-image-path="{{currentShareImage}}"
    bind:close="onShareClose"
  />

  <report-panel
    wx:elif="{{popupType === 'report'}}"
    target-type="{{reportTargetType}}"
    target-id="{{reportTargetId}}"
    bind:close="onCloseReport"
  />
</page-container>

<in-app-banner />