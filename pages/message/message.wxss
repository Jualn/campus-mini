/* pages/message/index.wxss */

page {
  background: var(--color-bg-page);
}

.message-page {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* =====================================================
   顶部导航
   ===================================================== */
.top-bar {
  background: var(--color-bg-card);
  padding: 0 28rpx 0;
  box-shadow: var(--shadow-sm);
}

.top-bar__nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.top-bar__title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text-primary);
}

.top-bar__read-all {
  padding: 8rpx 20rpx;
  background: var(--color-primary-light);
  border-radius: 20rpx;
}

.top-bar__read-all-text {
  font-size: 24rpx;
  color: var(--color-primary-dark);
}

/* =====================================================
   Tab
   ===================================================== */
.msg-tabs {
  display: flex;
  border-bottom: 1rpx solid var(--color-border-light);
  margin: 0 -28rpx;
  padding: 0 28rpx;
}

.msg-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 28rpx 16rpx;
  position: relative;
}

.msg-tab--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 28rpx;
  right: 28rpx;
  height: 4rpx;
  background: var(--color-text-primary);
  border-radius: 2rpx;
}

.msg-tab__text {
  font-size: 30rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.msg-tab--active .msg-tab__text {
  color: var(--color-text-primary);
  font-weight: 700;
}

.msg-tab__badge {
  background: #E24B4A;
  border-radius: 20rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-tab__badge-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 700;
}

/* =====================================================
   通知分类筛选
   ===================================================== */
.filter-scroll {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 28rpx 12rpx;
  gap: 12rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
}

.filter-tab {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: var(--color-bg-page);
  white-space: nowrap;
  flex-shrink: 0;
}

.filter-tab--active {
  background: var(--color-text-primary);
}

.filter-tab__icon {
  font-size: 24rpx;
}

.filter-tab__label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.filter-tab--active .filter-tab__label {
  color: #fff;
  font-weight: 600;
}

/* =====================================================
   消息列表容器
   ===================================================== */
.msg-list {
  padding: 16rpx 20rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* =====================================================
   分区标签
   ===================================================== */
.section-label {
  padding: 16rpx 4rpx 10rpx;
}

.section-label__text {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
  letter-spacing: 0.05em;
}

/* =====================================================
   消息卡片 — 通用
   ===================================================== */
.msg-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  overflow: hidden;
  position: relative;
}

.msg-card--unread {
  background: #FAFCFF;
}

/* 紧急卡片：顶部红色细线 */
.msg-card__urgency-bar {
  height: 6rpx;
  background: #E24B4A;
}

.msg-card__inner {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  position: relative;
}

/* 未读红点 */
.msg-card__dot {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E24B4A;
}

/* =====================================================
   图标
   ===================================================== */
.msg-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.msg-icon-wrap--system {
  background: var(--color-primary-light);
}

.msg-icon-wrap--activity {
  background: #FFF4EB;
}

.msg-icon-wrap--exam {
  background: #F0EEFF;
}

.msg-icon-wrap--interaction {
  background: #FFEBEE;
}

.msg-icon {
  font-size: 38rpx;
}

/* =====================================================
   卡片内容区
   ===================================================== */
.msg-card__body {
  flex: 1;
  min-width: 0;
  padding-right: 28rpx;
}

/* 类型小标签 */
.msg-type-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
}

.msg-type-tag--system {
  background: var(--color-primary-light);
}

.msg-type-tag--activity {
  background: #FFF4EB;
}

.msg-type-tag--exam {
  background: #F0EEFF;
}

.msg-type-tag--interaction {
  background: #FFEBEE;
}

.msg-type-tag__text {
  font-size: 20rpx;
  font-weight: 600;
}

.msg-type-tag--system .msg-type-tag__text {
  color: #1B68C0;
}

.msg-type-tag--activity .msg-type-tag__text {
  color: #C26B1A;
}

.msg-type-tag--exam .msg-type-tag__text {
  color: #6040C0;
}

.msg-type-tag--interaction .msg-type-tag__text {
  color: #B03040;
}

.msg-card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.4;
  display: block;
  margin-bottom: 6rpx;
}

.msg-card__desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 底部：行动按钮 + 时间 */
.msg-card__footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.msg-card__action {
  background: var(--color-primary-light);
  border-radius: 12rpx;
  padding: 6rpx 18rpx;
}

.msg-card__action-text {
  font-size: 22rpx;
  color: var(--color-primary-dark);
  font-weight: 600;
}

.msg-card__time {
  font-size: 22rpx;
  color: #bbb;
}

/* =====================================================
   分组互动卡片
   ===================================================== */
.msg-card--grouped {
  overflow: hidden;
}

.grouped-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 16rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.grouped-header__left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 分组卡头部的图标稍小 */
.grouped-header .msg-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
}

.grouped-header .msg-icon {
  font-size: 28rpx;
}

.grouped-header__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.grouped-count {
  background: var(--color-bg-page);
  border-radius: 12rpx;
  padding: 4rpx 14rpx;
}

.grouped-count__text {
  font-size: 20rpx;
  color: #888;
}

.grouped-header__time {
  font-size: 22rpx;
  color: #bbb;
}

/* 每条互动行 */
.interact-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid var(--color-border-light);
}

/* 头像圆 */
.avatar-sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #E8E8E8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-sm__text {
  font-size: 22rpx;
  color: #666;
  font-weight: 600;
}

.interact-row__text {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.interact-row__time {
  font-size: 20rpx;
  color: #bbb;
  flex-shrink: 0;
}

/* =====================================================
   私信 - 搜索
   ===================================================== */
.dm-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--color-bg-page);
  border-radius: 40rpx;
  padding: 0 28rpx;
  height: 72rpx;
  margin: 20rpx 20rpx 0;
}

.dm-search__icon {
  font-size: 28rpx;
}

.dm-search__placeholder {
  font-size: 28rpx;
  color: #bbb;
}

/* =====================================================
   私信列表
   ===================================================== */
.dm-list {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin: 16rpx 20rpx 0;
  overflow: hidden;
}

.dm-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.dm-item:last-child {
  border-bottom: none;
}

.dm-item--unread {
  background: #FAFCFF;
}

.dm-item__avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.dm-item__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eee;
}

.dm-item__badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  background: #E24B4A;
  border-radius: 20rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
}

.dm-item__badge-text {
  font-size: 18rpx;
  color: #fff;
  font-weight: 700;
}

.dm-item__body {
  flex: 1;
  min-width: 0;
}

.dm-item__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.dm-item__name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.dm-item__time {
  font-size: 22rpx;
  color: #bbb;
}

.dm-item__preview {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

/* =====================================================
   私信空态
   ===================================================== */
.dm-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
  gap: 20rpx;
}

.dm-empty__icon {
  font-size: 100rpx;
}

.dm-empty__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.dm-empty__desc {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  text-align: center;
  line-height: 1.6;
}

/* =====================================================
   通用空态
   ===================================================== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}