<view class="message-page">
  <view class="top-bar" style="padding-top:{{statusBarHeight}}px;">
    <view class="top-bar__nav" style="margin-top:{{navTopGap}}px;min-height:{{navHeight}}px;">
      <view class="top-bar__tools" wx:if="{{unreadCount > 0}}">
        <view class="top-bar__read-all" hover-class="top-bar__read-all--hover" bindtap="onMarkAllRead" aria-role="button" aria-label="将当前范围内全部分类标为已读">
          <text class="top-bar__read-all-text">{{markingAll ? '同步中…' : '全部已读'}}</text>
        </view>
      </view>
      <view class="top-bar__title-group">
        <text class="top-bar__title">消息中心</text>
        <view class="top-bar__count" wx:if="{{unreadCount > 0}}"><text class="top-bar__count-text">{{unreadCount > 99 ? '99+' : unreadCount}}</text></view>
      </view>
    </view>
    <text wx:if="{{listLoad.refreshing}}" class="message-sync-status" aria-role="status">正在同步最新消息…</text>
    <scroll-view class="filter-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="filter-tabs">
        <view wx:for="{{filterTabs}}" wx:key="id" class="filter-tab {{activeFilter === item.id ? 'filter-tab--active' : ''}}" bindtap="onSwitchFilter" data-id="{{item.id}}" aria-role="button" aria-label="{{item.label}}">
          <image class="filter-tab__icon" src="{{activeFilter === item.id ? item.activeIcon : item.filterIcon}}" mode="aspectFit" />
          <text class="filter-tab__label">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{readError}}" class="message-read-error" bindtap="onRetryRead" aria-role="button">部分已读尚未同步，点击重试</view>
  <block wx:if="{{listLoad.phase === 'initial'}}">
    <view wx:if="{{listLoad.skeletonVisible}}" class="message-skeleton" aria-role="status" aria-label="消息加载中">
      <view wx:for="{{skeletonRows}}" wx:key="*this" class="message-skeleton__card skeleton-card">
        <view class="message-skeleton__icon skeleton-block skeleton-radius-lg"></view>
        <view class="message-skeleton__body">
          <view class="message-skeleton__line message-skeleton__line--sm skeleton-block skeleton-pill"></view>
          <view class="message-skeleton__line message-skeleton__line--lg skeleton-block skeleton-pill"></view>
          <view class="message-skeleton__line message-skeleton__line--md skeleton-block skeleton-pill"></view>
        </view>
      </view>
    </view>
  </block>
  <load-state wx:elif="{{listLoad.initialError}}" mode="error" title="暂时无法加载消息" description="消息服务暂不可用，请稍后重试" action-text="重新加载" fill-viewport viewport-offset="380" bind:action="onRetryInitialLoad" />
  <view class="msg-list" wx:elif="{{messages.length}}">
    <view wx:for="{{messages}}" wx:key="id" class="msg-list__item">
      <view class="msg-card notification-card msg-card--{{item.layout}} {{item.canExpand ? 'msg-card--preview' : ''}} {{item.expanded ? 'msg-card--expanded' : ''}} {{item.isRead ? '' : 'msg-card--unread'}}" bindtap="onTapMessage" data-id="{{item.id}}" hover-class="msg-card--hover">
        <view class="msg-card__inner">
          <view class="msg-icon-wrap msg-icon-wrap--{{item.tone}}">
            <image wx:if="{{item.actor.avatarUrl}}" class="notification-avatar" src="{{item.actor.avatarUrl}}" mode="aspectFill" />
            <image wx:else class="msg-icon" src="{{item.icon}}" mode="aspectFit" />
          </view>
          <view class="msg-card__body">
            <view class="msg-card__meta">
              <view class="msg-type-tag msg-type-tag--{{item.tone}}"><text class="msg-type-tag__text">{{item.label}}</text></view>
              <view class="msg-card__status">
                <view class="msg-card__dot" wx:if="{{!item.isRead}}" aria-label="未读"></view>
                <text class="msg-card__time">{{item.timeAgo}}</text>
              </view>
            </view>
            <text class="msg-card__title">{{item.presentation.title}}</text>
            <text wx:if="{{item.showActorName}}" class="notification-actor">{{item.actor.nickname}}</text>
            <text wx:if="{{item.presentation.subjectTitle}}" class="notification-subject">{{item.presentation.subjectTitle}}</text>
            <text wx:elif="{{item.layout === 'change' && item.legacyContext}}" class="notification-subject">{{item.legacyContext}}</text>
            <view wx:if="{{item.presentation.changes.length}}" class="notification-changes">
              <view wx:for="{{item.presentation.changes}}" wx:for-item="change" wx:key="key" class="notification-change">
                <text class="notification-change__label">{{change.label}}</text>
                <view class="notification-change__row"><text class="notification-change__prefix">原</text><text class="notification-change__before">{{change.before}}</text></view>
                <view class="notification-change__row"><text class="notification-change__prefix">现</text><text class="notification-change__after">{{change.after}}</text></view>
              </view>
            </view>
            <text wx:if="{{item.presentation.body}}" class="msg-card__desc">{{item.presentation.body}}</text>
            <text wx:if="{{item.presentation.quote}}" class="notification-context">{{item.presentation.quote}}</text>
            <text wx:elif="{{item.layout !== 'change' && item.legacyContext}}" class="notification-context">{{item.legacyContext}}</text>
            <image wx:if="{{item.presentation.thumbnailUrl}}" class="notification-thumbnail" src="{{item.presentation.thumbnailUrl}}" mode="aspectFill" />
            <view wx:if="{{item.canNavigate || item.canExpand}}" class="msg-card__footer">
              <text wx:if="{{item.canExpand}}" class="msg-card__expand" catchtap="onToggleMessage" data-id="{{item.id}}" aria-role="button" aria-label="{{item.expanded ? '收起消息内容' : '展开消息内容'}}">{{item.expanded ? '收起' : '展开内容'}}</text>
              <text wx:if="{{item.canNavigate}}" class="msg-card__action-text">查看详情 →</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="message-list-footer" wx:if="{{listLoad.loadingMore}}">正在加载…</view>
    <view class="message-list-footer message-list-footer--retry" wx:elif="{{listLoad.loadMoreError}}" bindtap="onRetryLoadMore">加载失败，点击重试</view>
    <view class="message-list-footer" wx:elif="{{!listLoad.hasMore}}">已经看到全部消息</view>
  </view>
  <view wx:else class="empty-wrap">
    <view class="empty-icon-wrap"><image class="empty-icon" src="/assets/icons/common/notification_empty.svg" mode="aspectFit" /></view>
    <text class="empty-title">{{activeFilter ? '当前分类暂无消息' : '暂无通知'}}</text>
    <text class="empty-desc">新消息将在这里显示</text>
  </view>
  <in-app-banner />
</view>
