@import "../../../styles/skeleton.wxss";

.page {
  min-height: 100vh;
  padding: var(--page-padding);
  padding-bottom: calc(var(--space-xl) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
}

.page--MENTOR_QA {
  background: var(--color-bg-page);
}

.hero {
  padding: var(--space-md) var(--space-xs) var(--space-lg);
}

.hero__title {
  font-size: 40rpx;
  font-weight: var(--weight-semibold);
  line-height: 1.4;
}

.hero__description {
  max-width: 580rpx;
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
  font-size: var(--font-base);
  line-height: 1.7;
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-sm) var(--space-md);
  margin-top: var(--space-md);
}

.publish-button {
  display: inline-flex;
  min-height: 80rpx;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-sm);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: var(--font-base);
  font-weight: var(--weight-semibold);
  line-height: 1.3;
}

.publish-button--hover {
  transform: scale(0.99);
  opacity: 0.9;
}

.publish-button__plus {
  font-size: 38rpx;
  font-weight: var(--weight-regular);
  line-height: 1;
}

.record-entry {
  display: flex;
  min-height: 80rpx;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  color: var(--color-primary);
}

.record-entry--hover {
  background: var(--color-bg-card);
}

.record-entry__copy {
  flex: 1;
  min-width: 0;
}

.record-entry__title {
  color: var(--color-text-primary);
  font-size: var(--font-base);
  font-weight: var(--weight-semibold);
  line-height: 1.45;
}

.record-entry__description {
  margin-top: var(--space-2xs);
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
  line-height: 1.45;
}

.list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin: var(--space-lg) 0 var(--space-sm);
}

.list-heading__copy {
  min-width: 0;
}

.list-heading__title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  line-height: 1.4;
}

.list-heading__count {
  margin-top: var(--space-2xs);
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
}

.heading-action {
  flex-shrink: 0;
  min-width: 104rpx;
  min-height: 60rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  color: var(--color-primary);
  font-size: var(--font-sm);
  line-height: 58rpx;
  text-align: center;
}

.heading-action[disabled] {
  opacity: 0.5;
}

.skeleton-card,
.post-list__item {
  display: block;
  overflow: hidden;
  margin-bottom: var(--space-sm);
  border-radius: var(--radius-md);
}

.post-list__item:last-child {
  margin-bottom: 0;
}

.list-status {
  padding: var(--space-md);
  color: var(--color-text-tertiary);
  font-size: var(--font-base);
  text-align: center;
}

.more-button {
  width: 100%;
  min-height: 80rpx;
  margin-top: var(--space-xs);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  color: var(--color-primary);
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  line-height: 78rpx;
  box-shadow: none;
}

.list-end {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-lg) 0 var(--space-sm);
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
}

.list-end::before,
.list-end::after {
  flex: 1;
  height: 1rpx;
  background: var(--color-border);
  content: "";
}

.publish-button::after,
.heading-action::after,
.more-button::after {
  border: 0;
}

@media (max-width: 340px) {
  .hero {
    padding: 26rpx;
  }

  .hero__title {
    font-size: 38rpx;
  }
}

.qa-actions,
.qa-records,
.question-row__context,
.question-meta {
  display: flex;
  align-items: center;
}

.qa-actions {
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: var(--space-md);
}

.qa-ask {
  flex: none;
  min-height: 82rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: var(--font-base);
  font-weight: var(--weight-semibold);
  line-height: 82rpx;
}

.qa-records {
  justify-content: flex-end;
  gap: 6rpx;
  min-height: 82rpx;
  color: var(--color-primary);
  font-size: var(--font-base);
}

.qa-browse {
  margin-bottom: var(--space-md);
}

.qa-ask::after {
  border: 0;
}

.question-list {
  overflow: hidden;
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
}

.question-row {
  padding: 24rpx var(--space-md);
}

.question-row + .question-row {
  border-top: 1rpx solid var(--color-border-light);
}

.question-skeleton-state {
  width: 132rpx;
  height: 34rpx;
}

.question-skeleton-title {
  width: 84%;
  height: 40rpx;
  margin-top: 16rpx;
}

.question-skeleton-meta {
  width: 42%;
  height: 24rpx;
  margin-top: 18rpx;
}

.question-row__context,
.question-meta {
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  font-size: var(--font-sm);
  line-height: 1.5;
}

.question-state {
  padding: 3rpx 12rpx;
  border-radius: var(--radius-xs);
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.question-state--ANSWERED {
  background: var(--color-primary-tint);
  color: var(--color-primary);
  font-weight: var(--weight-medium);
}

.question-category,
.question-meta {
  color: var(--color-text-tertiary);
  overflow-wrap: anywhere;
}

.question-title,
.question-preview {
  display: -webkit-box;
  overflow: hidden;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.question-title {
  margin-top: 12rpx;
  color: var(--color-text-primary);
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  line-height: 1.45;
}

.question-preview {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-base);
  line-height: 1.55;
}

.question-meta {
  margin-top: 14rpx;
}

.question-author {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qa-pressed {
  opacity: 0.74;
}

