.page {
  min-height: 100vh;
  padding: 0 var(--page-padding);
  padding-bottom: calc(var(--space-xl) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
}

.record-tabs {
  width: auto;
  margin: 0 -24rpx;
  background: var(--color-bg-card);
  box-shadow: inset 0 -1rpx 0 var(--color-border-light);
  white-space: nowrap;
}

.record-tabs__track {
  display: flex;
  width: 100%;
  min-width: 600rpx;
  padding: 0 var(--page-padding);
}

.record-tab {
  position: relative;
  display: inline-flex;
  flex: 1 0 112rpx;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-md);
  line-height: 1.3;
  text-align: center;
}

.record-tab--active {
  color: var(--color-text-primary);
  font-weight: var(--weight-semibold);
}

.record-tab__indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 32rpx;
  height: 6rpx;
  border-radius: var(--radius-full);
  background: transparent;
  transform: translateX(-50%);
}

.record-tab--active .record-tab__indicator {
  background: var(--color-primary);
}

.page--MENTOR_QA .record-tab--active .record-tab__indicator {
  background: var(--color-purple);
}

.type-filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.type-filter__label {
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.type-filter__options {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-xs);
  min-width: 0;
}

.type-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  line-height: 1.25;
  text-align: center;
}

.type-chip--active {
  background: var(--color-primary-light);
  color: var(--color-primary-deep);
  font-weight: var(--weight-medium);
}

.page--MENTOR_QA .type-chip--active {
  background: rgba(107, 124, 255, 0.1);
  color: #5664d9;
}

.recovery-card {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-md);
  padding: 22rpx var(--space-md);
  border-left: 6rpx solid var(--color-warning);
  border-radius: var(--radius-sm);
  background: #fffaf2;
}

.recovery-card__copy {
  flex: 1;
  min-width: 0;
}

.recovery-card__title {
  color: var(--color-text-primary);
  font-size: var(--font-base);
  font-weight: var(--weight-semibold);
  line-height: 1.5;
}

.recovery-card__description {
  margin-top: var(--space-2xs);
  color: var(--color-text-secondary);
  font-size: var(--font-xs);
  line-height: 1.55;
}

.recovery-card__action {
  flex-shrink: 0;
  min-width: 112rpx;
  min-height: 64rpx;
  padding: 0 8rpx;
  color: #8b560f;
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  line-height: 64rpx;
  text-align: right;
}

.list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  min-height: 64rpx;
  margin: var(--space-md) 4rpx var(--space-sm);
}

.list-heading__privacy {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
}

.privacy-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-success);
}

.list-heading__actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: var(--space-md);
}

.heading-action {
  min-width: 56rpx;
  min-height: 64rpx;
  padding: 0 4rpx;
  color: var(--color-primary);
  font-size: var(--font-sm);
  line-height: 64rpx;
  text-align: center;
}

.heading-action--danger {
  color: var(--color-danger);
}

.heading-action[disabled],
.recovery-card__action[disabled],
.remove-action[disabled] {
  opacity: 0.45;
}

.record-card {
  margin-bottom: var(--space-sm);
  padding: 26rpx 28rpx 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-bg-card);
}

.record-card--hover {
  background: #f9fbfd;
}

.record-card--unavailable {
  background: rgba(255, 255, 255, 0.62);
}

.record-card__header {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx var(--space-sm);
}

.record-card__badges {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  min-width: 180rpx;
}

.type-badge {
  padding: 5rpx 12rpx;
  border-radius: var(--radius-xs);
  background: var(--color-bg-page-deep);
  color: var(--color-text-secondary);
  font-size: var(--font-xs);
  line-height: 1.45;
}

.page--MENTOR_QA .type-badge {
  background: rgba(107, 124, 255, 0.09);
  color: #5664d9;
}

.page--reports .type-badge {
  background: var(--color-brand-red-light);
  color: var(--color-brand-red-deep);
}

.category-label {
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
  line-height: 1.5;
}

.record-status {
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  gap: 8rpx;
  max-width: 58%;
  font-size: var(--font-xs);
  font-weight: var(--weight-medium);
  line-height: 1.65;
  text-align: right;
}

.record-status__dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin-top: 9rpx;
  border-radius: 50%;
  background: currentColor;
}

.record-status--success {
  color: #138452;
}

.record-status--warning {
  color: #9a5b0b;
}

.record-status--danger {
  color: #c4383c;
}

.record-status--neutral {
  color: var(--color-text-secondary);
}

.record-card__body {
  display: flex;
  gap: var(--space-md);
  margin-top: 18rpx;
}

.record-card__copy {
  flex: 1;
  min-width: 0;
}

.record-card__title {
  color: var(--color-text-primary);
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.record-card__text {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: var(--font-md);
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.record-card--unavailable .record-card__title,
.record-card--unavailable .record-card__text {
  color: var(--color-text-tertiary);
}

.record-card__image {
  flex-shrink: 0;
  width: 152rpx;
  height: 152rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-page-deep);
}

.record-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  min-height: 56rpx;
  margin-top: 14rpx;
}

.record-card__time {
  flex: 1;
  min-width: 0;
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
  line-height: 1.5;
}

.record-card__actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-sm);
}

.open-label {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 40rpx;
  min-height: 56rpx;
  color: var(--color-text-tertiary);
}

.remove-action {
  min-height: 56rpx;
  padding: 0 4rpx;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  line-height: 56rpx;
}

.list-status {
  padding: var(--space-md);
  color: var(--color-text-tertiary);
  font-size: var(--font-base);
  text-align: center;
}

.more-button {
  width: 100%;
  min-height: 80rpx;
  margin-top: var(--space-xs);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
  color: var(--color-primary);
  font-size: var(--font-base);
  font-weight: var(--weight-medium);
  line-height: 78rpx;
}

.list-end {
  padding: var(--space-lg) 0 var(--space-sm);
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
  text-align: center;
}

@media (max-width: 340px) {
  .type-filter {
    align-items: flex-start;
    flex-direction: column;
    gap: 10rpx;
  }

  .type-filter__options {
    justify-content: flex-start;
  }

  .type-chip {
    padding: 0 16rpx;
  }

  .record-card {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .record-card__image {
    width: 136rpx;
    height: 136rpx;
  }

  .record-status {
    max-width: 52%;
  }
}
