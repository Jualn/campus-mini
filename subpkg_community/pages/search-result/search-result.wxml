<!--subpkg_community/pages/search-result/search-result.wxml-->
<view class="search-result-page">
  <view class="search-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="search-nav" style="margin-top: {{navTopGap}}px; height: {{navHeight}}px;">
      <view class="search-nav__back" bindtap="onBack" aria-role="button" aria-label="返回">
        <ui-icon name="chevron-left" size="lg" />
      </view>

      <text class="search-nav__title">搜索结果</text>
    </view>

    <view class="search-bar-wrap">
      <view class="search-bar">
        <view class="search-bar__icon-wrap">
          <ui-icon name="search" size="sm" />
        </view>
        <input
          class="search-bar__input"
          placeholder="搜索动态、活动"
          placeholder-class="search-bar__placeholder"
          value="{{keyword}}"
          focus="{{inputFocus}}"
          confirm-type="search"
          bindinput="onInput"
          bindconfirm="onConfirm"
        />
        <view wx:if="{{keyword}}" class="search-bar__clear" catchtap="onClear" aria-role="button" aria-label="清除搜索内容">
          <ui-icon name="clear" size="sm" />
        </view>
      </view>
    </view>

    <view class="result-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="id"
        class="tab-item {{activeTab === item.id ? 'tab-item--active' : ''}}"
        bindtap="onSwitchTab"
        data-id="{{item.id}}"
      >
        <text class="tab-item__label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 无结果时占据顶部以外的剩余空间，不再套一层白色卡片。 -->
  <view
    class="result-content {{(activeTab === 'all' ? postList.length : activityList.length) ? '' : 'result-content--state'}}"
  >
    <view wx:if="{{!searchKeyword}}" class="result-empty" aria-role="status">
      <image class="result-empty__svg" src="/images/icons/search.svg" mode="aspectFit" />
      <text class="result-empty__title">输入关键词开始搜索</text>
      <text class="result-empty__desc">查找感兴趣的动态和校园活动</text>
    </view>

    <!-- 首次请求和重试均原位反馈，顶部搜索框和分类保持可用。 -->
    <load-state wx:elif="{{loading && !loaded}}" mode="loading" title="正在搜索" description="正在查找相关内容" />

    <load-state
      wx:elif="{{error && !loaded}}"
      mode="error"
      title="搜索暂时不可用"
      description="请检查网络后重试"
      action-text="重新搜索"
      bind:action="onRetry"
    />

    <block wx:elif="{{loaded}}">
      <block wx:if="{{activeTab === 'all' ? postList.length : activityList.length}}">
        <view wx:if="{{activeTab === 'all'}}" class="post-result-list">
          <block wx:for="{{postList}}" wx:key="id" wx:for-item="post">
            <post-card post="{{post}}" />
          </block>
        </view>
        <view wx:else class="activity-result-list">
          <block wx:for="{{activityList}}" wx:key="id" wx:for-item="activity">
            <activity-card activity="{{activity}}" />
          </block>
        </view>

        <load-state wx:if="{{loading}}" mode="loading" variant="inline" title="正在加载更多" />
        <load-state
          wx:elif="{{error}}"
          mode="error"
          variant="inline"
          title="加载失败"
          action-text="点击重试"
          bind:action="onRetry"
        />
        <view wx:elif="{{activeTab === 'all' ? !postHasMore : !activityHasMore}}" class="list-state">
          <text class="list-state__text">已显示全部结果</text>
        </view>
      </block>

      <view wx:else class="result-empty" aria-role="status">
        <image class="result-empty__svg" src="/images/icons/search.svg" mode="aspectFit" />
        <text class="result-empty__title">没有找到相关{{activeTab === 'all' ? '动态' : '活动'}}</text>
        <text class="result-empty__desc">试试更简短的关键词，或切换分类查找</text>
      </view>
    </block>
  </view>
</view>

<in-app-banner />
