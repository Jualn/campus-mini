/* subpkg_community/pages/search-result/search-result.wxss */

page {
  background: var(--color-bg-page);
}

.search-result-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

/* 顶部区域 */
.search-top {
  position: sticky;
  top: 0;
  z-index: 20;
  flex-shrink: 0;
  padding: 14rpx 24rpx 0;
  background: var(--color-bg-page);
  border-bottom: 1rpx solid var(--color-border-light);
}

.search-nav {
  position: relative;
  display: flex;
  align-items: center;
}

.search-nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3f6fa;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  flex-shrink: 0;
}

.search-nav__back:active {
  opacity: 0.86;
  transform: scale(0.98);
}


.search-nav__title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  max-width: 420rpx;
  font-size: 32rpx;
  color: var(--color-text-primary);
  font-weight: var(--weight-heavy);
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 搜索框 */
.search-bar-wrap {
  margin-top: 18rpx;
}

.search-bar {
  position: relative;
  width: 100%;
  height: 78rpx;
  border-radius: var(--radius-full);
  background: #ffffff;
  border: 1rpx solid rgba(47, 124, 246, 0.12);
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(47, 124, 246, 0.06);
  overflow: hidden;
}

.search-bar__icon-wrap {
  position: relative;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  background: rgba(47, 124, 246, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-bar__input {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  height: 78rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.search-bar__placeholder {
  color: var(--color-text-placeholder);
  font-size: 28rpx;
}

.search-bar__clear {
  position: relative;
  z-index: 1;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}


/* 分类 tab */
.result-tabs {
  display: flex;
  gap: 40rpx;
  margin-top: 16rpx;
  padding: 0 12rpx;
}

.tab-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  min-width: 96rpx;
  padding: 0 12rpx;
}

.tab-item:active {
  opacity: 0.86;
  transform: scale(0.98);
}

.tab-item--active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 32rpx;
  height: 5rpx;
  transform: translateX(-50%);
  border-radius: var(--radius-full);
  background: var(--color-primary);
}

.tab-item__label {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}

.tab-item--active .tab-item__label {
  color: var(--color-primary);
  font-weight: var(--weight-bold);
}

/* 结果内容 */
.result-content {
  flex: 1;
  padding: 1rpx 0 var(--space-xl);
}

.result-content--state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 0 env(safe-area-inset-bottom);
}

.post-result-list {
  background: transparent;
  display: flex;
  flex-direction: column;
}

.activity-result-list {
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

/* 空状态 */
.result-empty {
  min-height: 440rpx;
  padding: 96rpx 40rpx 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.result-empty__svg {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 28rpx;
  opacity: 0.48;
}

.result-empty__title {
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: var(--weight-semibold);
  color: var(--color-text-secondary);
}

.result-empty__desc {
  max-width: 520rpx;
  margin-top: 12rpx;
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  text-align: center;
  line-height: 1.65;
}

.list-state {
  padding: 32rpx 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.list-state__text {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}
