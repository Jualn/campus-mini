page {
  background: transparent;
}

.backdrop {
  position: fixed;
  inset: 0;
  z-index: 10;
  background: rgba(20, 30, 46, 0);
  transition: background 0.25s ease;
}

.backdrop--show {
  background: rgba(20, 30, 46, 0.48);
}

.panel {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 11;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--color-bg-card);
  box-shadow: 0 -12rpx 40rpx rgba(31, 45, 69, 0.12);
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
}

.panel--show {
  transform: translateY(0);
}

.panel--hide {
  transform: translateY(100%);
  transition: transform 0.24s ease-in;
}

.panel__handle {
  width: 64rpx;
  height: 8rpx;
  flex-shrink: 0;
  margin: 16rpx auto 0;
  border-radius: var(--radius-full);
  background: #d9dfe8;
}

.panel__nav {
  position: relative;
  display: flex;
  min-height: 104rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx var(--space-md);
  border-bottom: 1rpx solid var(--color-border-light);
}

.panel__cancel {
  display: flex;
  min-width: 104rpx;
  min-height: 72rpx;
  align-items: center;
  justify-content: flex-start;
  color: var(--color-text-secondary);
  font-size: var(--font-md);
}

.panel__title {
  position: absolute;
  right: 176rpx;
  left: 176rpx;
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel__submit {
  display: flex;
  min-width: 120rpx;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  background: #e2e7ee;
  color: var(--color-text-tertiary);
  transition:
    background var(--transition-fast),
    opacity var(--transition-fast);
}

.panel__submit--on {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.panel__submit-text {
  font-size: var(--font-base);
  font-weight: var(--weight-semibold);
}

.panel__submit[disabled] {
  opacity: 1;
}

.panel__body {
  flex: 1;
  background: var(--color-bg-card);
}

.composer-notice {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin: var(--space-md) 32rpx 0;
  padding: 20rpx var(--space-md);
  border-left: 4rpx solid var(--color-primary);
  border-radius: var(--radius-xs);
  background: var(--color-primary-tint);
  color: var(--color-primary-deep);
  font-size: var(--font-base);
  line-height: 1.65;
}

.composer-notice--warning {
  border-left-color: var(--color-warning);
  background: rgba(255, 159, 47, 0.1);
  color: #925609;
}

.composer-notice--error {
  border-left-color: var(--color-danger);
  background: rgba(255, 77, 79, 0.07);
  color: #b43134;
}

.composer-notice__title {
  font-weight: var(--weight-semibold);
}

.composer-notice__description {
  overflow-wrap: break-word;
}

.composer-notice__link {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  gap: var(--space-2xs);
  color: var(--color-primary);
  font-weight: var(--weight-medium);
}

.conflict-content {
  display: block;
  max-width: 100%;
  padding: var(--space-sm);
  border-radius: var(--radius-xs);
  background: rgba(255, 255, 255, 0.72);
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  overflow-wrap: break-word;
  white-space: pre-wrap;
}

.notice-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-xs);
}

.notice-action {
  display: inline-flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-md);
  border: 1rpx solid currentColor;
  border-radius: var(--radius-full);
  color: inherit;
  font-size: var(--font-sm);
}

.notice-action--primary {
  background: rgba(255, 255, 255, 0.72);
  font-weight: var(--weight-medium);
}

.field-error {
  display: block;
}

.title-area {
  position: relative;
  margin: 0 32rpx;
  padding-top: var(--space-md);
  border-bottom: 1rpx solid var(--color-border-light);
}

.title-area__label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
}

.title-input {
  width: 100%;
  min-height: 96rpx;
  padding: var(--space-xs) 0;
  font-size: 36rpx;
  font-weight: var(--weight-medium);
  line-height: 1.5;
}

.field-placeholder,
.content-placeholder {
  color: var(--color-text-placeholder);
  font-weight: var(--weight-regular);
}

.field-count,
.content-count {
  display: block;
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
  text-align: right;
}

.field-count {
  padding-bottom: var(--space-xs);
}

.content-area {
  position: relative;
  padding: 28rpx 32rpx var(--space-sm);
}

.content-input {
  width: 100%;
  min-height: 264rpx;
  color: var(--color-text-primary);
  font-size: 32rpx;
  line-height: 1.8;
}

.content-count {
  margin-top: var(--space-xs);
}

.context-area {
  margin: 0 32rpx;
  padding: var(--space-sm) 0;
  border-top: 1rpx solid var(--color-border-light);
}

.category-picker {
  display: inline-flex;
  max-width: 100%;
  min-height: 72rpx;
  align-items: center;
  gap: var(--space-xs);
  padding: 0 var(--space-sm);
  border-radius: var(--radius-xs);
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.category-picker--selected {
  background: var(--color-primary-tint);
  color: var(--color-primary-deep);
}

.category-picker--required {
  color: var(--color-primary-deep);
}

.category-picker ui-icon {
  flex-shrink: 0;
  transform: rotate(90deg);
}

.category-picker__value {
  overflow: hidden;
  font-size: var(--font-base);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-picker__value--placeholder {
  color: inherit;
}

.category-support {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-xs) var(--space-md);
  margin-top: var(--space-xs);
}

.category-support__text {
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
}

.category-support__action {
  display: inline-flex;
  min-height: 64rpx;
  align-items: center;
  color: var(--color-primary);
  font-size: var(--font-xs);
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-top: var(--space-sm);
}

.topic-chip {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  padding-left: var(--space-sm);
  border-radius: var(--radius-full);
  background: var(--color-primary-light);
}

.topic-chip__text {
  max-width: 440rpx;
  overflow: hidden;
  color: var(--color-primary-deep);
  font-size: var(--font-base);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topic-chip__del {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.image-area {
  padding: var(--space-sm) 32rpx 0;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.image-item {
  position: relative;
  aspect-ratio: 1;
}

.image-item__preview,
.image-item__img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-sm);
}

.image-item__preview {
  overflow: hidden;
  background: var(--color-bg-page-deep);
}

.image-item__del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  z-index: 2;
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--color-bg-card);
  border-radius: 50%;
  background: rgba(31, 45, 69, 0.76);
}

.bottom-pad {
  height: var(--space-lg);
}

.panel__toolbar {
  display: flex;
  min-height: 104rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  padding: 12rpx 20rpx;
  border-top: 1rpx solid var(--color-border-light);
  background: var(--color-bg-card);
}

.toolbar-left {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}

.toolbar-btn {
  display: flex;
  min-width: 112rpx;
  min-height: 80rpx;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  padding: 0 var(--space-sm);
  border-radius: var(--radius-sm);
  color: var(--color-text-secondary);
}

.toolbar-btn__hash {
  color: var(--color-primary);
  font-size: 38rpx;
  font-weight: var(--weight-medium);
  line-height: 1;
}

.toolbar-btn__label {
  font-size: var(--font-base);
}

.toolbar-keyboard {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  padding: 0 var(--space-md);
  border-radius: var(--radius-full);
  background: var(--color-bg-page-deep);
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.toolbar-caption {
  flex: 1;
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
  line-height: 1.5;
  text-align: right;
}

.topic-modal {
  position: fixed;
  inset: 0;
  z-index: 100;
}

.topic-modal__mask {
  position: absolute;
  inset: 0;
  background: rgba(20, 30, 46, 0.42);
}

.topic-modal__box {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 76vh;
  overflow-y: auto;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--color-bg-card);
}

.topic-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  padding: 28rpx 32rpx var(--space-sm);
  border-bottom: 1rpx solid var(--color-border-light);
}

.topic-modal__header > view {
  display: flex;
  flex-direction: column;
  gap: var(--space-2xs);
}

.topic-modal__title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
}

.topic-modal__description {
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.topic-modal__done {
  display: flex;
  min-width: 96rpx;
  min-height: 72rpx;
  align-items: center;
  justify-content: flex-end;
  color: var(--color-primary);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
}

button[disabled] {
  opacity: 0.45;
}

.panel__submit[disabled] {
  opacity: 1;
}

@media (max-width: 340px) {
  .panel__title {
    right: 152rpx;
    left: 152rpx;
  }

  .panel__submit {
    min-width: 104rpx;
    padding: 0 20rpx;
  }

  .toolbar-btn {
    min-width: 96rpx;
    padding: 0 var(--space-xs);
  }
}
