/* subpkg_community/pages/detail/detail.wxss */
@import "../../../styles/skeleton.wxss";

.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  /* 底部输入栏占位也延续评论区白底，短内容时不露出页面蓝底。 */
  background: var(--color-bg-card);
}

/* 复用正文的通栏、作者行、统计与操作栏，避免加载完成时外框跳变。 */
.post-detail-skeleton {
  flex: 1;
  display: flex;
  flex-direction: column;
  pointer-events: none;
}

.post-detail-skeleton__avatar {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.post-detail-skeleton__author-copy {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 8rpx;
}

.post-detail-skeleton__name {
  width: 160rpx;
  max-width: 70%;
  height: 28rpx;
}

.post-detail-skeleton__time {
  width: 104rpx;
  max-width: 50%;
  height: 18rpx;
}

.post-text.post-detail-skeleton__text {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 16rpx 0;
}

.post-detail-skeleton__line {
  width: 100%;
  height: 26rpx;
}

.post-detail-skeleton__line--short {
  width: 58%;
}

.post-detail-skeleton__stat {
  width: 80rpx;
  height: 20rpx;
}

.post-detail-skeleton__muted {
  opacity: 0.3;
}

/* 与 comment-panel 的 inline 头部和首条评论对齐；只占位，不提前发评论请求。 */
.post-detail-skeleton__comment-header {
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #e4e6eb;
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1e21;
}

.post-detail-skeleton__comment {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.post-detail-skeleton__comment-avatar {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.post-detail-skeleton__comment-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 6rpx;
}

.post-detail-skeleton__comment-line {
  height: 20rpx;
}

/* =====================================================
   顶部导航
   ===================================================== */
.top-bar {
  flex-shrink: 0;
  background: var(--color-bg-card);
  padding: 0 16rpx 0;
  box-shadow: 0 1rpx 0 var(--color-border-light);
  position: sticky;
  top: 0;
  z-index: 10;
}

.top-bar__nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.top-bar__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3f6fa;
  border: none;
  box-shadow: none;
}


.top-bar__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.top-bar__placeholder {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

/* =====================================================
   帖子主体
   ===================================================== */
.post-wrap {
  flex-shrink: 0;
  background: var(--color-bg-card);
  padding: 24rpx 28rpx 0;
  border-bottom: 16rpx solid var(--color-bg-page);
}

/* 作者行 */
.author-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.author-avatar_img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.author-avatar__char {
  color: #fff;
  font-weight: 700;
  font-size: 36rpx;
}

.author-info {
  flex: 1;
  min-width: 0;
}

/* 帖子更多操作：放在作者行，避开右上角系统胶囊 */
.post-more {
  width: 64rpx;
  height: 64rpx;
  margin-top: -4rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
}

.post-more:active {
  background: var(--color-bg-page);
}

.post-more__icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.author-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.author-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.author-badge {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.author-badge__text {
  font-size: 16rpx;
  color: var(--color-text-inverse);
  font-weight: 700;
}

.author-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
}

.author-handle {
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

.author-sep {
  font-size: 23rpx;
  color: #ddd;
}

.author-time {
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

.author-ip {
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

/* 关注按钮 */
.follow-btn {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  border: 1.5rpx solid var(--color-primary);
  flex-shrink: 0;
}

.follow-btn--on {
  border-color: #ddd;
  background: var(--color-bg-page);
}

.follow-btn__text {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.follow-btn--on .follow-btn__text {
  color: var(--color-text-tertiary);
}

/* 正文 */
.post-text {
  font-size: 32rpx;
  color: var(--color-text-primary);
  line-height: 1.8;
  display: block;
  margin-bottom: 20rpx;
}

/* 话题 */
.post-topics {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 16rpx 0;
}

.topic-tag {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* 数据统计 */
.post-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--color-border-light);
}

.post-stats__item {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.post-stats__sep {
  font-size: 24rpx;
  color: #ddd;
}

/* 操作栏 */
.post-actions {
  display: flex;
  align-items: center;
  padding: 16rpx 0 20rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.action-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  position: relative;
}

.action-count {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  min-width: 32rpx;
}

.action-label--liked {
  color: #ff3b30;
}

.action-label--collected {
  color: #ff9500;
}

/* 点赞图标动画 */
.action-icon.liked { animation: likePop 0.3s ease; }

@keyframes likePop {
  0% {
    transform: scale(0.6);
  }

  60% {
    transform: scale(1.2);
  }

  100% {
    transform: scale(1);
  }
}

/* =====================================================
   评论区
   ===================================================== */
.comment-wrap {
  /* 短内容补满剩余空间，长评论仍由页面自然滚动。 */
  flex: 1;
  background: var(--color-bg-card);
  /* comment-panel inline 模式自带样式，这里只做容器 */
}

/* Layout stays with the caller; UiIcon owns the glyph. */
.icon-slot {
  display: flex;
  align-items: center;
  justify-content: center;
}
